function H.numericRow(label, key, minimum, maximum, onChange)
    local row = H.row(label)
    local input = H.make("TextBox", {Name = key .. "Input", Size = UDim2.fromOffset(68, 44),
        Position = UDim2.new(1, -81, 0.5, -22), Text = tostring(S[key]), ClearTextOnFocus = false,
        TextColor3 = UI.text, BackgroundColor3 = Color3.fromRGB(17, 25, 36),
        TextSize = 14, Font = Enum.Font.GothamBold}, row)
    H.corner(input, 6)
    H.make("UIStroke", {Color = UI.border, Thickness = 1}, input)
    H.connect(input.FocusLost, function()
        local number = tonumber(input.Text)
        if H.finite(number) then
            S[key] = math.clamp(number, minimum, maximum)
            if onChange then onChange() end
        else H.notice("Enter a finite number for " .. label, 3) end
        input.Text = tostring(S[key])
    end)
    return input
end

