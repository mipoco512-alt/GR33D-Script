H.connect(RunService.Heartbeat, function(deltaTime)
    if not S.alive then return end
    local combatOK, combatError = pcall(H.updateCombatWork)
    if not combatOK then
        H.clearAimSelection()
        if S.flags.aim then S.flags.aim = false; H.stopAim(); H.updateSwitches() end
        H.report("Combat background worker", combatError)
    end
    H.updateDefenseState()
    if S.flags.watch then
        local watchOK, watchMessage = pcall(H.samplePlayers, deltaTime)
        if not watchOK then H.report("Movement watch", watchMessage); S.flags.watch = false; H.updateSwitches() end
        if S.observingPlayer then H.maintainObserverCamera() end
    end
    local healthOK, healthMessage = pcall(H.updateHealthRecovery, deltaTime)
    if not healthOK then
        S.flags.health = false
        H.updateSwitches()
        H.report("Health regeneration", healthMessage)
    end
    -- Initial indexing is spread across frames instead of blocking on a large map.
    S.pending, S.pendingIndex = {}, 1
    S.scanClock = S.scanClock + deltaTime
    if S.scanClock < Config.ScanInterval then return end
    S.scanClock = 0
    if S.flags.lock and (not S.lastFingerprintCleanup or os.clock() - S.lastFingerprintCleanup >= 3) then
        S.lastFingerprintCleanup = os.clock()
        H.cleanFingerprints()
    end
    if H.ready() then
        local ok, message = pcall(function()
            H.updateEscape()
            -- Anti-Monster is checked in PreSimulation instead of this slower loop.
            local ctx = S.context
            local velocity = ctx.root.AssemblyLinearVelocity
            if not S.flags.lock and not S.mover and not ctx.root.Anchored
                and ctx.humanoid.FloorMaterial ~= Enum.Material.Air and not ctx.humanoid.Sit
                and H.finiteVector(velocity) and velocity.Magnitude < Config.FlingLinearThreshold * 0.5
                and ctx.root.Position.Y > Workspace.FallenPartsDestroyHeight + 10 then
                S.safeRoot, S.safeTime = ctx.root.CFrame, os.clock()
            end
        end)
        if not ok then H.report("Protection scan", message) end
    end
    H.refreshStatus()
end)

