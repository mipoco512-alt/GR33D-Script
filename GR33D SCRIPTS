function H.optionalFeature(flag,callback,cleanup,...)
    S.optionalFailures=S.optionalFailures or {}
    if S.optionalFailures[flag] and not S.flags[flag] then return false end
    if S.flags[flag] then S.optionalFailures[flag]=nil end
    local success,failure=pcall(callback,...)
    if success then return true end
    S.optionalFailures[flag]=true
    S.flags[flag]=false
    pcall(cleanup)
    pcall(H.updateSwitches)
    pcall(H.report,"Optional "..flag,failure)
    return false
end

function H.stopOptionalAFK()
    pcall(H.afkStopPulse)
    pcall(H.releaseIdle,false)
    pcall(H.release,"idle")
end

function H.physicsTick(deltaTime)
    if not H.ready() then return end
    local ctx = S.context
    H.optionalFeature("bullet",H.updateGuidedBullets,H.stopBulletAim,deltaTime)
    if S.manualMove then
        local ok,active = pcall(H.updateManualMovement,deltaTime)
        if not ok then H.cancelManualMovement(nil);H.report("Manual movement",active)
        elseif active then return end
    end
    H.observeRunCorrection(deltaTime)
    H.applyCustomJump()
    H.applyCollision()
    H.updateFling("pre")
    H.optionalFeature("afk",H.updateAFK,H.stopOptionalAFK)
    if S.flags.lock then
        H.updateLockWalking(deltaTime)
        -- Check extreme, incoming hazards between regular position-lock scans.
        -- A successful urgent dodge is already in S.escape; keep its hold.
        H.urgentImpactProbe()
        H.smartShieldScan()
        H.updateEscape()
        if S.escape then H.updateEscapeHold() else H.applyLock() end
        if not S.escape then H.updateRun(deltaTime) end
        return
    end
    if S.mover then H.updateMover(); return end
    if ctx.root.Anchored then return end
    H.updateRun(deltaTime)
    if S.flags.fall and ctx.humanoid.FloorMaterial == Enum.Material.Air then
        local velocity = ctx.root.AssemblyLinearVelocity
        if velocity.Y < -Config.FallSpeedLimit then
            ctx.root.AssemblyLinearVelocity = Vector3.new(velocity.X, -Config.FallSpeedLimit, velocity.Z)
        end
    end
    H.authorizePhysicsVelocity()
end

H.connect(RunService.PreSimulation, function(dt)
    -- Anti-Monster gets an independent, fast physics-frame check; the rest of
    -- the panel keeps its existing scan cadence. Zero work when the toggle is off.
    if S.flags.monster and not S.flags.lock and not S.flying and H.ready() then
        local npcOK, npcMessage = pcall(H.updateNPCs)
        if not npcOK then H.report("Fast anti-monster check", npcMessage) end
    end
    local ok, message = pcall(H.physicsTick, dt)
    if not ok then
        -- A broken physics callback must not repeatedly leave the rig anchored.
        for key in pairs(S.flags) do S.flags[key] = false end
        for _, cleanup in ipairs({function() H.stopLock(false) end, H.stopMover,
            H.stopAim, H.stopBulletAim, H.releaseAll, H.updateSwitches}) do
            pcall(cleanup)
        end
        H.report("Physics update; features disabled", message)
    end
end)

H.connect(RunService.PostSimulation, function(dt)
    if S.flags.fling and H.ready() then
        local ok, message = pcall(H.updateFling, "post", dt)
        if not ok then H.report("Post-physics anti-fling", message) end
