function H.finite(number)
    return type(number) == "number" and number == number and math.abs(number) < math.huge
end

function H.finiteVector(vector)
    return typeof(vector) == "Vector3" and H.finite(vector.X) and H.finite(vector.Y) and H.finite(vector.Z)
end

function H.connect(signal, callback, bucket)
    local connection = signal:Connect(callback)
    table.insert(bucket or S.connections, connection)
    return connection
end

function H.disconnectAll(bucket)
    for _, connection in ipairs(bucket) do
        local ok, message = pcall(function() connection:Disconnect() end)
        if not ok then H.report("Disconnect callback", message) end
    end
    for i = #bucket, 1, -1 do bucket[i] = nil end
end

S.feedback={notice=nil,lastKey=nil,lastAt=-math.huge,reports={},now=os.clock}

function H.noticePriority(message)
    local text=tostring(message):lower()
    if text:find("failed",1,true) or text:find("unavailable",1,true)
        or text:find("error",1,true) then return 100 end
    if text:find("emergency",1,true) or text:find("danger",1,true)
        or text:find("damage",1,true) or text:find("anti-fling:",1,true) then return 85 end
    if text:find("respawn",1,true) or text:find("living character",1,true)
        or text:find("blocked",1,true) or text:find("paused",1,true) then return 70 end
    return 45
end

function H.notice(message,duration,priority,detail)
    if not S.alive then return false end
    local now=S.feedback.now()
    message=tostring(message or "")
    detail=tostring(detail or "")
    local key=message.."|"..detail
    if key==S.feedback.lastKey and now-S.feedback.lastAt<0.75 then return false end
    duration=tonumber(duration) or 4
    if not H.finite(duration) then duration=4 end
    duration=math.clamp(duration,0,12)
    priority=tonumber(priority) or H.noticePriority(message)
    if not H.finite(priority) then priority=45 end
    local previous=S.feedback.notice
    if previous and now<previous.expiresAt and priority<previous.priority then return false end
    S.feedback.lastKey=key
    S.feedback.lastAt=now
    S.notice=message
    S.noticeUntil=now+duration
    S.feedback.notice={title=message,detail=detail,priority=priority,expiresAt=S.noticeUntil}
    if H.refreshStatus then H.refreshStatus() end
    return true
end

function H.statusBackground()
    local now=S.feedback.now()
    local active=0
    for _,enabled in pairs(S.flags) do if enabled then active+=1 end end
    local queued=math.max(0,#S.pending-(S.pendingIndex or 1)+1)
    local combat=S.combatIndex
    if combat then
        queued+=math.max(0,#combat.jobs-(combat.jobIndex or 1)+1)
            +math.max(0,#combat.eventQueue-(combat.eventIndex or 1)+1)
    end
    local summary=tostring(active).." enabled · "..tostring(queued).." indexing"
    if not H.ready() then
        return "WAITING FOR CHARACTER","Controls resume after a living character is ready.",80
    end
    if S.escape and S.escape.mode=="emergency" then
        return "EMERGENCY EVASION",tostring(S.escape.reason or "Incoming physical threat")
            .." · Chase "..tostring(S.escape.chaseCount or 0).." · Waiting for safe return",110
    end
    if S.manualMove then
        if S.manualMove.phase=="travel" then
            return "MOVING TO "..tostring(S.manualMove.label or "DESTINATION"),
                "Requested teleport in progress · "..summary,90
        end
        return "CHECKING REQUESTED TELEPORT","Observing the destination before resuming controls.",85
    end
    if S.escape and S.escape.mode=="manual" then
        return "TELEPORT IN PROGRESS","Protection yields movement to your requested destination.",90
    end
    if S.escape then
        return "EVADING A THREAT",tostring(S.escape.reason or "Incoming physical threat")
            .." · Chase "..tostring(S.escape.chaseCount or 0).." · Waiting for safe return",105
    end
    if S.flags.lock then
        local detection=S.defenseDetection
        local sensing=detection and string.format("Scan %d studs · %d recent samples",
            detection.range or 0,detection.sampled or 0) or "Threat sensors warming up"
        if S.flags.afk and S.idleTarget and type(H.afkSummary)=="function" then
            local ok,afk=pcall(H.afkSummary)
            if ok then return "ANTI EXPLOITER · AFK",tostring(afk).." · "..sensing,20 end
        end
        return S.lockWalking and "ANTI EXPLOITER · MOVING" or "ANTI EXPLOITER · ACTIVE",
            sensing.." · "..tostring(S.hazardCache and #S.hazardCache or 0).." assessed threats",20
    end
    if S.flying then return "FLIGHT ACTIVE","Double-tap jump to stop · "..summary,20 end
    if S.hovering then return "ANTI-MONSTER SKYWALK","Movement controls remain available · "..summary,30 end
    if S.observingPlayer then
        return "OBSERVING "..tostring(S.observingPlayer.Name),S.observerSummary or summary,20
    end
    if S.flags.afk and type(H.afkSummary)=="function" then
        local ok,detail=pcall(H.afkSummary)
        if ok and detail then return "AFK STREAK",tostring(detail),15 end
    end
    if S.flags.afk and S.afkPulseUntil then return "AFK STREAK · ACTIVITY PULSE",summary,15 end
    if S.flags.afk and S.idleTarget then return "AFK STREAK · HOLDING",summary,15 end
    if S.flags.afk then return "AFK STREAK · WAITING","Waiting for stable ground · "..summary,15 end
    if H.worldIndexNeeded() and queued>0 then return "INDEXING PROTECTION",summary,10 end
    if S.flags.aim then
        return S.aimTarget and ("AUTO AIM · "..tostring(S.aimTarget.Name)) or "AUTO AIM · SEARCHING",
            S.flags.bullet and (S.bulletGuidanceStatus or "Waiting for compatible projectiles")
                or "Visible, living hostile targets only · "..summary,15
    end
    if S.flags.bullet then
        local count=0
        for _ in pairs(S.guidedBullets) do count+=1 end
        return "BULLET AIM",S.bulletGuidanceStatus
            or (count>0 and tostring(count).." registered projectiles" or "Waiting for compatible projectiles"),15
    end
    if S.runBackoffUntil and now<S.runBackoffUntil then
        return "RUN OVERRIDE PAUSED",S.runStatus or "Repeated position corrections observed.",65
    end
    if S.flags.health then return "HEALTH RECOVERY",S.healthStatus or summary,15 end
    if S.flags.watch then return "MOVEMENT WATCH",S.observerSummary or summary,10 end
    if S.flags.monster then return "ANTI-MONSTER ARMED","Scanning nearby hostile AI · "..summary,10 end
    return "CONTROL CENTER READY",summary,10
end

function H.refreshStatus()
    if not S.alive or not S.ui.status or not S.ui.status.Parent then return end
    local title,detail,priority=H.statusBackground()
    local now=S.feedback.now()
    local notice=S.feedback.notice
    if notice and now>=notice.expiresAt then S.feedback.notice=nil;notice=nil end
    if notice and notice.priority>=priority then
        title=notice.title
        detail=notice.detail~="" and notice.detail or detail
        priority=notice.priority
    end
    local color=priority>=100 and Color3.fromRGB(245,137,144)
        or (priority>=65 and Color3.fromRGB(238,193,109) or Color3.fromRGB(80,216,172))
    if S.ui.status.Text~=title then S.ui.status.Text=title end
    if S.ui.status.TextColor3~=color then S.ui.status.TextColor3=color end
    if S.ui.statusDetail and S.ui.statusDetail.Text~=detail then S.ui.statusDetail.Text=detail end
    if S.ui.statusDot then S.ui.statusDot.BackgroundColor3=color end
end

-- In-memory recorder; no uploads, no automated player reports or punitive actions.
function H.logEvent(kind, detail)
    if not S.alive then return end
    local entry = {at = os.clock(), kind = tostring(kind), detail = tostring(detail or "")}
    local events = S.defenseLog
    events[#events + 1] = entry
    if #events > Config.DefenseLogLimit then table.remove(events, 1) end
end

function H.defenseState()
    -- Priority order prevents simultaneous controllers from claiming the same rig.
    if S.escape then return S.escape.mode == "emergency" and "emergency-escape" or "escape" end
    if S.flags.lock then return "mobile-protection" end
    if S.hovering then return "skywalk" end
    if S.flying then return "flight" end
    if S.flags.afk and S.idleTarget then return "afk-hold" end
    return "normal"
end

function H.updateDefenseState()
    local mode = H.defenseState()
    if mode ~= S.defenseMode then
        S.defenseMode = mode
        H.logEvent("Controller", "Active mode: " .. mode)
    end
end

function H.report(label,message)
    local now=S.feedback.now()
    label=tostring(label)
    message=tostring(message)
    local key=label.."|"..message
    local previous=S.feedback.reports[key]
    if not previous or now-previous>=5 then
        S.feedback.reports[key]=now
        warn("[GR33D] "..label..": "..message)
        if H.logEvent then H.logEvent("Error",label..": "..message) end
    end
    if not S.feedback.lastReportCleanup or now-S.feedback.lastReportCleanup>=15 then
        S.feedback.lastReportCleanup=now
        for reportKey,reportedAt in pairs(S.feedback.reports) do
            if now-reportedAt>30 then S.feedback.reports[reportKey]=nil end
        end
    end
    H.notice(label.." failed",6,100,message:sub(1,220))
end

function H.ready()
    local ctx = S.context
    return S.alive and ctx ~= nil and player.Character == ctx.character
        and ctx.character:IsDescendantOf(Workspace) and ctx.root:IsDescendantOf(ctx.character)
        and ctx.humanoid:IsDescendantOf(ctx.character) and ctx.humanoid.Health > 0
end

-- Property leases allow noclip + hover to share CanCollide without bad restores.
function H.claim(instance, property, value, owner)
    local fields = S.properties[instance]
    if not fields then fields = {}; S.properties[instance] = fields end
    local entry = fields[property]
    if not entry then
        entry = {original = instance[property], owners = {}}
        fields[property] = entry
    end
    entry.owners[owner] = true
    if instance[property] ~= value then instance[property] = value end
end

function H.claimState(humanoid, state, enabled, owner)
    local fields = S.states[humanoid]
    if not fields then fields = {}; S.states[humanoid] = fields end
    local entry = fields[state]
    if not entry then
        entry = {original = humanoid:GetStateEnabled(state), owners = {}}
        fields[state] = entry
    end
    entry.owners[owner] = true
    if humanoid:GetStateEnabled(state) ~= enabled then humanoid:SetStateEnabled(state, enabled) end
end

function H.release(owner)
    for instance, fields in pairs(S.properties) do
        for property, entry in pairs(fields) do
            if entry.owners[owner] then
                entry.owners[owner] = nil
                if next(entry.owners) == nil then
                    local ok, message = pcall(function() instance[property] = entry.original end)
                    if not ok and instance.Parent then H.report("Restore " .. property, message) end
                    fields[property] = nil
                end
            end
        end
        if next(fields) == nil then S.properties[instance] = nil end
    end
    for humanoid, fields in pairs(S.states) do
        for state, entry in pairs(fields) do
            if entry.owners[owner] then
                entry.owners[owner] = nil
                if next(entry.owners) == nil then
                    local ok, message = pcall(function() humanoid:SetStateEnabled(state, entry.original) end)
                    if not ok and humanoid.Parent then H.report("Restore humanoid state", message) end
                    fields[state] = nil
                end
            end
        end
        if next(fields) == nil then S.states[humanoid] = nil end
    end
end

function H.releaseAll()
    local owners = {}
    for _, fields in pairs(S.properties) do
        for _, entry in pairs(fields) do
            for owner in pairs(entry.owners) do owners[owner] = true end
        end
    end
    for _, fields in pairs(S.states) do
        for _, entry in pairs(fields) do
            for owner in pairs(entry.owners) do owners[owner] = true end
        end
    end
    for owner in pairs(owners) do H.release(owner) end
end

-- Standalone LocalScript. This cannot override authoritative server collision/damage.

function H.zeroVelocity()
    if S.context then
        S.context.root.AssemblyLinearVelocity = Vector3.zero
        S.context.root.AssemblyAngularVelocity = Vector3.zero
    end
end

function H.moveRoot(target)
    if not H.ready() or not H.finiteVector(target.Position) then return false end
    local ctx = S.context
    -- PivotTo takes a MODEL pivot, not necessarily the HumanoidRootPart CFrame.
    local rootToPivot = ctx.root.CFrame:ToObjectSpace(ctx.character:GetPivot())
    ctx.character:PivotTo(target * rootToPivot)
    H.zeroVelocity()
    H.resetRunObservation()
    return true
end

function H.tokens(name)
    local tokens = {}
    local splitName = name:gsub("(%l)(%u)", "%1 %2"):lower()
    for word in splitName:gmatch("%w+") do tokens[word] = true end
    tokens[name:lower():gsub("[^%w]", "")] = true
    return tokens
end

function H.projectileNameHint(name)
    if not Config.UseHazardNameHints then return false end
    local tokens = H.tokens(name)
    for _, word in ipairs(Config.ProjectileHints) do
        if tokens[word] then return true end
    end
    return false
end

function H.hasTag(instance, tags)
    for _, tag in ipairs(tags) do
        if CollectionService:HasTag(instance, tag) then return true end
    end
    return false
end

-- Ignore ordinary avatar limbs and accessories, but not genuinely hazardous
-- objects temporarily held by another player (e.g. an equipped nuclear tool).
function H.ignored(instance)
    if player.Character and instance:IsDescendantOf(player.Character) then return true end
    local nominated = H.projectileNameHint(instance.Name)
        or H.hasTag(instance, Config.ConfirmedHazardTags)
        or instance:GetAttribute("Lethal") == true
        or instance:GetAttribute("KillZone") == true
        or (H.finite(instance:GetAttribute("Damage")) and instance:GetAttribute("Damage") > 0)
        or (H.finite(instance:GetAttribute("DamageAmount")) and instance:GetAttribute("DamageAmount") > 0)
    local current = instance
    while current and current ~= Workspace do
        if current:GetAttribute("ProtectionIgnore") == true
            or CollectionService:HasTag(current, "ProtectionIgnore") then return true end
        if current:IsA("Accessory") then return true end
        if H.projectileNameHint(current.Name)
            or H.hasTag(current, Config.ConfirmedHazardTags)
            or current:GetAttribute("Lethal") == true
            or current:GetAttribute("KillZone") == true
            or (H.finite(current:GetAttribute("Damage")) and current:GetAttribute("Damage") > 0)
            or (H.finite(current:GetAttribute("DamageAmount")) and current:GetAttribute("DamageAmount") > 0) then
            nominated = true
        end
        if current:IsA("Tool") or (current:IsA("Model") and Players:GetPlayerFromCharacter(current)) then
            if not nominated then return true end
        end
        current = current.Parent
    end
    return false
end

function H.projectileHintInTree(instance)
    local current = instance
    while current and current ~= Workspace do
        if H.projectileNameHint(current.Name) then return true end
        current = current.Parent
    end
    return false
end

-- Recognize named wavefronts (including a Water part inside a Tsunami model).
-- Generic water/sea/terrain is NOT a wave trigger. Movement or Active evidence
-- is required before a wave can cause a special high-altitude dodge.
function H.waveNameInTree(instance)
    local node = instance
    while node and node ~= Workspace do
        local key = node.Name:lower():gsub("[^%w]", "")
        if key:find("tsunami", 1, true) or key:find("tidalwave", 1, true)
            or key:find("flashflood", 1, true) or key:find("floodwave", 1, true)
            or key:find("risingwater", 1, true) or key == "flood"
            or key == "wave" or key == "surge" then return true end
        node = node.Parent
    end
    return false
end

function H.grabEvidence(instance)
    if H.defenseControllerEvidence(instance) then return true end
    local current = instance
    while current and current ~= Workspace do
        for _, attribute in ipairs({"IsGrabbed", "Grabbed", "IsHeld", "Held", "BeingCarried"}) do
            if current:GetAttribute(attribute) == true then return true end
        end
        for _, attribute in ipairs({"GrabbedBy", "HeldBy", "CarriedBy"}) do
            local value = current:GetAttribute(attribute)
            if value ~= nil and value ~= false and value ~= "" and value ~= 0 then return true end
        end
        if current:IsA("Tool") and current.Parent
            and current.Parent:IsA("Model")
            and Players:GetPlayerFromCharacter(current.Parent) then return true end
        current = current.Parent
    end
    return false
end

-- A danger label is only a *candidate*. Dodge requires a real contact / predicted impact.
function H.hazardInfo(instance)
    if not instance.Parent or not instance:IsDescendantOf(Workspace) or H.ignored(instance) then return nil end
    if not (instance:IsA("BasePart") or instance:IsA("Model") or instance:IsA("Explosion")) then return nil end

    local confirmed, explicitlyActive, inactive = instance:IsA("Explosion"), false, false
    local radius = 0
    local activeRadius
    local cur = instance
    while cur and cur ~= Workspace do
        for _, attr in ipairs({"Active", "IsActive", "Armed"}) do
            local value = cur:GetAttribute(attr)
            if value == false then inactive = true end
            if value == true then explicitlyActive = true end
        end
        for _, attr in ipairs({"Damage", "DamageAmount"}) do
            local value = cur:GetAttribute(attr)
            if H.finite(value) and value > 0 then confirmed = true end
        end
        for _, attr in ipairs({"Lethal", "KillZone", "Kill", "Deadly"}) do
            if cur:GetAttribute(attr) == true then confirmed = true end
        end
        if H.hasTag(cur, Config.ConfirmedHazardTags) then confirmed = true end
        if activeRadius == nil then
            for _, attr in ipairs({"HazardRadius", "DangerRadius", "BlastRadius", "ExplosionRadius", "DamageRadius"}) do
                local requested = cur:GetAttribute(attr)
                if H.finite(requested) and requested >= 0 then
                    activeRadius = math.clamp(requested, 0, 500)
                    break
                end
            end
        end
        cur = cur.Parent
    end
    if inactive then return nil end

    local bounds, size, part
    if instance:IsA("BasePart") then
        bounds, size, part = instance.CFrame, instance.Size, instance
    elseif instance:IsA("Model") then
        part = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
        if not part then return nil end
        bounds, size = instance:GetBoundingBox()
    else
        bounds, size = CFrame.new(instance.Position), Vector3.zero
        radius = math.max(0, instance.BlastRadius)
    end
    if not H.finiteVector(bounds.Position) or not H.finiteVector(size)
        or not H.finite(radius) then return nil end

    -- Tweened projectiles may report zero physics velocity, so sample their motion too.
    local velocity = part and part.AssemblyLinearVelocity or Vector3.zero
    if not H.finiteVector(velocity) then velocity = Vector3.zero end
    local now = os.clock()
    local previous = S.motion[instance]
    local sampledVelocity, acceleration = Vector3.zero, Vector3.zero
    local sampledAngularSpeed = 0
    local abruptReversal, teleported = false, false
    local sweptFrom, sweptAt
    if previous and now - previous.time >= Config.HazardScanInterval * 0.7 then
        local elapsed = now - previous.time
        if elapsed <= Config.HazardMotionMaxAge then
            local displacement = bounds.Position - previous.position
            sampledVelocity = displacement / elapsed
            if previous.bounds then
                local trace = previous.bounds.RightVector:Dot(bounds.RightVector)
                    + previous.bounds.UpVector:Dot(bounds.UpVector)
                    + previous.bounds.LookVector:Dot(bounds.LookVector)
                sampledAngularSpeed = math.acos(math.clamp((trace - 1) * 0.5, -1, 1)) / elapsed
                if not H.finite(sampledAngularSpeed) then sampledAngularSpeed = 0 end
            end
            if H.finiteVector(sampledVelocity) then
                teleported = displacement.Magnitude > math.max(12, velocity.Magnitude * elapsed * 2 + 6)
                if sampledVelocity.Magnitude > Config.HazardMaxSampleSpeed then
                    sampledVelocity = sampledVelocity.Unit * Config.HazardMaxSampleSpeed
                end
                if displacement.Magnitude > 0.05 then sweptFrom, sweptAt = previous.position, now end
                local before = previous.velocity
                if before.Magnitude >= Config.EmergencyDirectionChangeSpeed
                    and sampledVelocity.Magnitude >= Config.EmergencyDirectionChangeSpeed then
                    abruptReversal = before.Unit:Dot(sampledVelocity.Unit) < -0.2
                end
                -- Use acceleration only after two consistent moving samples.
                -- A teleport/reversal is evidence to evade, not a ballistic orbit.
                if previous.sampled and not teleported and not abruptReversal
                    and before.Magnitude >= Config.ProjectileSpeedThreshold
                    and sampledVelocity.Magnitude >= Config.ProjectileSpeedThreshold then
                    acceleration = (sampledVelocity - before) / elapsed
                    if not H.finiteVector(acceleration) then acceleration = Vector3.zero end
                    if acceleration.Magnitude > Config.HazardMaxAcceleration then
                        acceleration = acceleration.Unit * Config.HazardMaxAcceleration
                    end
                end
            else sampledVelocity = Vector3.zero end
        end
        S.motion[instance] = {position = bounds.Position, bounds = bounds, time = now,
            velocity = sampledVelocity, acceleration = acceleration, sampled = true,
            angularSpeed = sampledAngularSpeed,
            reversedAt = abruptReversal and now or previous.reversedAt,
            teleportedAt = teleported and now or previous.teleportedAt,
            sweptFrom = sweptFrom, sweptAt = sweptAt, lastMovingAt = previous.lastMovingAt}
    elseif not previous then
        S.motion[instance] = {position = bounds.Position, bounds = bounds, time = now,
            velocity = Vector3.zero, acceleration = Vector3.zero, reversedAt = -math.huge,
            angularSpeed = 0, teleportedAt = -math.huge}
    else
        sampledVelocity = previous.velocity
        acceleration = previous.acceleration or Vector3.zero
        sampledAngularSpeed = previous.angularSpeed or 0
        sweptFrom, sweptAt = previous.sweptFrom, previous.sweptAt
    end
    local motion = S.motion[instance]
    abruptReversal = abruptReversal or (motion and motion.reversedAt
        and now - motion.reversedAt < 0.18) or false
    teleported = teleported or (motion and motion.teleportedAt
        and now - motion.teleportedAt < Config.HazardSweepMemory) or false
    -- Prefer measured CFrame motion when physics velocity is missing or points
    -- the other way. A faster stale physics vector must not mask a reversal.
    if part and part.Anchored then
        -- Anchored parts can only move through CFrame/tweens. Their retained
        -- AssemblyLinearVelocity is not evidence that they are still moving.
        velocity = sampledVelocity
    elseif H.finiteVector(sampledVelocity) and (sampledVelocity.Magnitude > velocity.Magnitude
        or (sampledVelocity.Magnitude >= Config.ProjectileSpeedThreshold
            and sampledVelocity:Dot(velocity) < 0)) then
        velocity = sampledVelocity
    end

    local angular = part and part.AssemblyAngularVelocity or Vector3.zero
    if not H.finiteVector(angular) then angular = Vector3.zero end
    local angularSpeed = part and part.Anchored and sampledAngularSpeed
        or math.max(angular.Magnitude, sampledAngularSpeed)
    local spinning = angularSpeed >= Config.EmergencySpinThreshold
    local moving = velocity.Magnitude >= Config.ProjectileSpeedThreshold
    if moving or spinning then motion.lastMovingAt = now end
    local recentlyMoved = now - (motion.lastMovingAt or -math.huge) < 0.75
    local waveNamed = H.waveNameInTree(instance)
    local hinted = instance:IsA("BasePart") and H.projectileHintInTree(instance)
    -- An ordinary named / static decoration should NEVER trigger the escape system.
    local physical = part and H.defensePhysicalCourse(part, velocity)
    if not confirmed and not physical and not (hinted and (moving or spinning or recentlyMoved
        or explicitlyActive or H.grabEvidence(instance))) then return nil end
    -- Tags on large *container models* are often scenery: only explicitly marked
    -- regions/models qualify, and movement is evaluated using their own bounding box.
    if instance:IsA("Model") and not (waveNamed or instance:GetAttribute("Lethal") == true
        or instance:GetAttribute("KillZone") == true
        or instance:GetAttribute("HazardRadius") ~= nil
        or H.hasTag(instance, Config.ConfirmedHazardTags)) then return nil end

    if activeRadius ~= nil then
        radius = instance:IsA("Explosion") and math.max(radius, activeRadius) or activeRadius
    end
    local waveActive = waveNamed and (moving or recentlyMoved or explicitlyActive
        or (part and not part.Anchored and (confirmed or activeRadius ~= nil)))
    return {instance = instance, name = instance.Name, bounds = bounds, size = size,
        velocity = velocity, angularSpeed = angularSpeed,
        acceleration = acceleration, sweptFrom = sweptFrom, sweptAt = sweptAt,
        moving = moving, spinning = spinning, recentlyMoved = recentlyMoved,
        wave = waveActive,
        active = explicitlyActive, radius = radius, grabbed = H.grabEvidence(instance),
        erratic = abruptReversal, teleported = teleported,
        explosion = instance:IsA("Explosion"), explicit = confirmed}
end

function H.boxDistance(position, bounds, size)
    local offset = bounds:PointToObjectSpace(position)
    local half = size * 0.5
    return Vector3.new(math.max(0, math.abs(offset.X) - half.X),
        math.max(0, math.abs(offset.Y) - half.Y), math.max(0, math.abs(offset.Z) - half.Z)).Magnitude
end

-- Intersect a relative-motion segment with an expanded oriented box. Checking
-- only closest approach to the CENTER misses elongated projectiles.
function H.sweptBoxTime(bounds, size, startPoint, displacement, padding)
    local start = bounds:PointToObjectSpace(startPoint)
    local finish = bounds:PointToObjectSpace(startPoint + displacement)
    local change = finish - start
    local half = size * 0.5 + Vector3.new(padding, padding, padding)
    local first, last = 0, 1
    for _, axis in ipairs({"X", "Y", "Z"}) do
        local value, delta, extent = start[axis], change[axis], half[axis]
        if math.abs(delta) < 1e-8 then
            if math.abs(value) > extent then return nil end
        else
            local a, b = (-extent - value) / delta, (extent - value) / delta
            if a > b then a, b = b, a end
            first, last = math.max(first, a), math.min(last, b)
            if first > last then return nil end
        end
    end
    return first
end

-- Exact segment-to-box distance for destination ranking. Uniform time samples
-- can look safe on both sides of a very fast projectile passing between them.
function H.segmentBoxDistance(bounds, size, startPoint, displacement)
    local start = bounds:PointToObjectSpace(startPoint)
    local delta = bounds:PointToObjectSpace(startPoint + displacement) - start
    local half = size * 0.5
    local cuts = {0, 1}
    for _, axis in ipairs({"X", "Y", "Z"}) do
        if math.abs(delta[axis]) > 1e-8 then
            for _, extent in ipairs({-half[axis], half[axis]}) do
                local time = (extent - start[axis]) / delta[axis]
                if time > 0 and time < 1 then table.insert(cuts, time) end
            end
        end
    end
    table.sort(cuts)
    local best = math.huge
    for index = 1, #cuts - 1 do
        local first, last = cuts[index], cuts[index + 1]
        local midpoint = (first + last) * 0.5
        local ab, bb = 0, 0
        for _, axis in ipairs({"X", "Y", "Z"}) do
            local value = start[axis] + delta[axis] * midpoint
            if math.abs(value) > half[axis] then
                local offset = start[axis] - (value > 0 and half[axis] or -half[axis])
                ab += offset * delta[axis]
                bb += delta[axis] * delta[axis]
            end
        end
        local time = bb > 1e-8 and math.clamp(-ab / bb, first, last) or midpoint
        local point = start + delta * time
        local squared = 0
        for _, axis in ipairs({"X", "Y", "Z"}) do
            local outside = math.max(0, math.abs(point[axis]) - half[axis])
            squared += outside * outside
        end
        best = math.min(best, squared)
    end
    return math.sqrt(best)
end

function H.hazardAccelerationOffset(info, time)
    local duration = math.min(time, Config.HazardAccelerationHorizon)
    -- Continue the acquired velocity after a short acceleration horizon.
    return (info.acceleration or Vector3.zero) * (duration * (time - duration * 0.5))
end

function H.threatAt(info, position, observerVelocity, includeSweep)
    observerVelocity = observerVelocity or Vector3.zero
    local distance = H.boxDistance(position, info.bounds, info.size)
    local required = info.radius + Config.HazardMargin
    if info.explosion then
        return distance <= required, distance, 0
    end
    -- Recent CFrame jumps can cross the player between physics samples. Do not
    -- reject future destinations because a hazard USED to cross that point.
    if includeSweep ~= false and info.sweptFrom and info.sweptAt
        and os.clock() - info.sweptAt <= Config.HazardSweepMemory then
        local priorBounds = info.bounds + (info.sweptFrom - info.bounds.Position)
        if H.sweptBoxTime(priorBounds, info.size, position,
            info.sweptFrom - info.bounds.Position, required) then
            return true, 0, 0
        end
    end
    if not (info.moving or info.explicit or info.grabbed or info.spinning
        or info.active or info.recentlyMoved) then return false, distance, 0 end
    if distance <= required then return true, distance, 0 end
    local spinPadding = math.min(8, (info.angularSpeed or 0) * info.size.Magnitude * 0.025)
    local velocity = info.moving and info.velocity or Vector3.zero
    local miss = distance
    local steps = (info.acceleration or Vector3.zero).Magnitude > 1 and Config.HazardPredictionSteps or 1
    local from, fromTime = position, 0
    for step = 1, steps do
        local time = Config.PredictionSeconds * step / steps
        local relative = position + (observerVelocity - velocity) * time
            - H.hazardAccelerationOffset(info, time)
        local entry = H.sweptBoxTime(info.bounds, info.size, from, relative - from, required + spinPadding)
        miss = math.min(miss, H.boxDistance(relative, info.bounds, info.size))
        if entry then
            local contact = from + (relative - from) * entry
            return true, H.boxDistance(contact, info.bounds, info.size), fromTime + (time - fromTime) * entry
        end
        from, fromTime = relative, time
    end
    return false, miss, Config.PredictionSeconds
end

function H.hazardCandidate(instance)
    if H.ignored(instance) then return false end
    if instance:IsA("BasePart") and H.defensePhysicalCourse(instance, H.defensePartVelocity(instance)) then return true end
    if instance:IsA("Explosion") then return true end
    if instance:IsA("BasePart") and H.projectileHintInTree(instance) then return true end
    if instance:IsA("Model") and H.waveNameInTree(instance) then return true end
    if not (instance:IsA("BasePart") or instance:IsA("Model")) then return false end
    local cur = instance
    while cur and cur ~= Workspace do
        if H.hasTag(cur, Config.ConfirmedHazardTags) then return true end
        for _, attr in ipairs({"Damage", "DamageAmount", "Lethal", "KillZone", "Kill", "Deadly"}) do
            local value = cur:GetAttribute(attr)
            if value == true or (H.finite(value) and value > 0) then return true end
        end
        cur = cur.Parent
    end
    return false
end

function H.hazardSnapshot()
    local now = os.clock()
    if S.defenseSnapshotAt and now - S.defenseSnapshotAt < Config.DefenseSnapshotInterval then
        return S.defenseSnapshotCache or {}
    end
    S.defenseSnapshotAt = now
    S.defenseHazardRecords = S.defenseHazardRecords or {}
    local records, stored = {}, S.defenseHazardRecords
    local cursor = S.defenseHazardCursor
    local deadline, sampled = now + Config.DefenseWorkSeconds, 0
    while sampled < Config.DefenseHazardSampleBudget and os.clock() < deadline do
        if S.defenseBudgetUntil and now < S.defenseBudgetUntil
            and ((S.defenseBudgetCount or 0) >= Config.DefensePartBudget
                or os.clock() >= S.defenseBudgetDeadline) then break end
        local valid, instance = pcall(next, S.hazards, cursor)
        if not valid then instance = next(S.hazards) end
        if not instance then cursor = nil; break end
        cursor = instance
        sampled += 1
        local distant = false
        if instance:IsA("BasePart") and H.ready() then
            local range = Config.LockLocalScanRadius + 100
            distant = (instance.Position - S.context.root.Position).Magnitude > range
                and (not S.escape or not S.escape.home or (instance.Position - S.escape.home.Position).Magnitude > range)
        end
        if not instance.Parent or not instance:IsDescendantOf(Workspace) or distant then
            S.hazards[instance], S.motion[instance], stored[instance] = nil, nil, nil
        else
            local info = H.defenseCandidateInfo(instance)
            if info then
                stored[instance] = {info = info, at = now}
                H.fingerprintThreat(info)
                S.hazardErrors[instance] = nil
            else
                stored[instance] = nil
            end
        end
    end
    S.defenseHazardCursor = cursor
    local position = H.ready() and S.context.root.Position or Vector3.zero
    local observer = H.protectionObserverVelocity(position)
    for instance, record in pairs(stored) do
        if not instance.Parent or not S.hazards[instance] or now - record.at > Config.HazardMotionMaxAge then
            stored[instance] = nil
        else
            local info = record.info
            local gap = H.boxDistance(position, info.bounds, info.size) - info.radius
            local delta = position - info.bounds.Position
            local relative = info.velocity - observer
            local approach = relative:Dot(relative) > 1 and delta:Dot(relative) / relative:Dot(relative) or -1
            local miss = approach >= 0 and (delta - relative * approach).Magnitude or math.huge
            local onCourse = approach >= 0 and approach <= Config.PredictionSeconds
                and miss <= info.size.Magnitude * 0.5 + info.radius + Config.HazardMargin
            records[#records + 1] = {info = info, priority = gap <= Config.HazardMargin and 0
                or onCourse and approach or Config.PredictionSeconds + math.max(0,gap) / 100}
        end
    end
    table.sort(records, function(first, second) return first.priority < second.priority end)
    local result = {}
    for index, entry in ipairs(records) do
        if index <= Config.DefenseSnapshotLimit then result[#result + 1] = entry.info
        else stored[entry.info.instance] = nil end
    end
    S.hazardCache, S.hazardCacheAt, S.defenseSnapshotCache = result, now, result
    return result
end

-- Evaluate a wavefront in the X/Z plane so a wave passing *below* a
-- successfully lifted character remains a threat to the saved ground spot.
function H.tsunamiFootprint(info, position)
    if not info or not info.wave then return false, math.huge end
    local relative = info.bounds:PointToObjectSpace(position)
    local half = info.size * 0.5
    local dx = math.max(0, math.abs(relative.X) - half.X)
    local dz = math.max(0, math.abs(relative.Z) - half.Z)
    local planar = math.sqrt(dx * dx + dz * dz)
    local towards = info.velocity.X * (position.X - info.bounds.Position.X)
        + info.velocity.Z * (position.Z - info.bounds.Position.Z)
    local reach = Config.TsunamiHorizontalWarning
        + math.min(60, Vector3.new(info.velocity.X, 0, info.velocity.Z).Magnitude * 0.55)
    local nearby = planar <= reach
    return nearby and (towards > 0 or planar <= 18), planar
end

function H.tsunamiDanger(info, position)
    local approaching, planar = H.tsunamiFootprint(info, position)
    if not approaching then return false, planar end
    local crest = info.bounds.Position.Y + info.size.Y * 0.5
    return position.Y <= crest + 9, planar
end

-- A bounded local probe catches broad moving waves even if the regular hazard
-- list was limited by other nearby parts. Dormant scenery is not an escape cue.
function H.findTsunamiThreat(position)
    if not S.flags.lock or not H.ready() then return nil end
    local best, bestDistance, seen = nil, math.huge, {}
    local function inspect(info)
        if info.wave and not seen[info.instance] then
            seen[info.instance] = true
            local danger, distance = H.tsunamiDanger(info, position)
            if danger and distance < bestDistance then best, bestDistance = info, distance end
        end
    end
    for _, info in ipairs(H.defenseProbeRecords()) do inspect(info) end
    for _, info in ipairs(H.hazardSnapshot()) do inspect(info) end
    return best
end

-- High-above-wave emergency escape: relative to the actual wave crest, with
-- a minimum rise. Avoid side-only dodges that leave the player inside water.
function H.escapeAboveTsunami(info)
    if not info or not info.wave or not S.flags.lock or not H.ready() then return false end
    local now = os.clock()
    local current = S.context.root.CFrame
    local home = S.escape and S.escape.home or S.lockTarget or current
    local crest = info.bounds.Position.Y + info.size.Y * 0.5
    local requiredY = math.max(current.Position.Y + Config.TsunamiMinRise,
        crest + Config.TsunamiCrestClearance, home.Position.Y + Config.TsunamiMinRise)
    local ceiling = home.Position.Y + Config.ChaseMaxHeight
    if requiredY > ceiling then
        H.notice("Tsunami crest exceeds permitted escape height", 3)
        return false
    end
    if S.escape and S.escape.tsunamiObject == info.instance
        and current.Position.Y >= crest + Config.TsunamiCrestClearance - 8 then
        S.escape.earliestReturn = math.max(S.escape.earliestReturn, now + Config.TsunamiMinimumHold)
        S.escape.safeSince = nil
        return true
    end
    local orientation = current - current.Position
    local offset = current.Position - info.bounds.Position
    local flat = Vector3.new(offset.X, 0, offset.Z)
    flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(1, 0, 0)
    local side = Vector3.new(-flat.Z, 0, flat.X)
    local destinations = {Vector3.zero, flat * 15, -flat * 15,
        side * 20, -side * 20, flat * 35, -flat * 35}
    for _, horizontal in ipairs(destinations) do
        local where = Vector3.new(current.Position.X + horizontal.X, requiredY, current.Position.Z + horizontal.Z)
        local dest = CFrame.new(where) * orientation
        if H.clearSpace(dest) and not H.threatAt(info, where, Vector3.zero, false)
            and H.beginEscapeMove(dest, "emergency", home, "tsunami high escape") then
            S.escape.tsunamiObject = info.instance
            S.escape.earliestReturn = now + Config.TsunamiMinimumHold
            S.homeThreatAt = now
            S.lastEmergency, S.lastEscape = now, now
            H.logEvent("Tsunami", ("High escape: wave crest %.0f, target %.0f studs Y")
                :format(crest, requiredY))
            H.notice("TSUNAMI: escaped above detected wave crest", 3)
            return true
        end
    end
    H.notice("Tsunami approaching; no verified clear high destination", 3)
    return false
end

-- Fingerprints explain suspicious *objects*, not who owns or manipulated them.
function H.fingerprintThreat(info)
    if not S.flags.lock or not info or not info.instance then return end
    local now = os.clock()
    local old = S.threatSignatures[info.instance]
    local mark = (info.teleported and 3 or 0) + (info.erratic and 2 or 0)
        + (info.grabbed and 2 or 0) + (info.spinning and 1 or 0)
        + (info.velocity.Magnitude >= Config.UrgentExtremeSpeed and 2 or 0)
    if mark <= 0 then return end
    if not old then
        old = {score = 0, count = 0, lastAt = -math.huge, updatedAt = now}
        S.threatSignatures[info.instance] = old
    end
    old.updatedAt = now
    if now - old.lastAt >= 0.7 then
        old.count += 1
        old.score = math.min(20, old.score + mark)
        old.lastAt = now
        if old.count >= 2 and old.score >= 5 then
            H.logEvent("Threat", ("Repeated abnormal %s (score %d)"):format(info.name, old.score))
        end
    end
end

function H.cleanFingerprints()
    if not S.flags.lock then S.threatSignatures = {}; return end
    local now, items = os.clock(), {}
    for obj, entry in pairs(S.threatSignatures) do
        if not obj.Parent or now - entry.updatedAt > 7 then
            S.threatSignatures[obj] = nil
        else
            items[#items + 1] = {object = obj, at = entry.updatedAt}
        end
    end
    if #items <= Config.ThreatFingerprintLimit then return end
    table.sort(items, function(a, b) return a.at < b.at end)
    for index = 1, #items - Config.ThreatFingerprintLimit do
        S.threatSignatures[items[index].object] = nil
    end
end

function H.findHazard(position, observerVelocity, includeSweep)
    observerVelocity = observerVelocity or H.protectionObserverVelocity(position)
    local best, soonest, bestDistance = nil, math.huge, math.huge
    for _, info in ipairs(H.hazardSnapshot()) do
            local danger, distance, t = H.threatAt(info, position, observerVelocity, includeSweep)
            if danger and (t < soonest or (t == soonest and distance < bestDistance)) then
                best, soonest, bestDistance = table.clone(info), t, distance
                best.distance, best.impactTime = distance, t
            end
    end
    return best
end

function H.enemyMetadata(instance, names)
    local folders = Config.EnemyMetadataFolders
        or {"AI", "Config", "Configuration", "Stats", "Status", "Metadata", "Combat", "Data"}
    for _, name in ipairs(names) do
        local attribute = instance:GetAttribute(name)
        if attribute ~= nil then return attribute end
        local child = instance:FindFirstChild(name)
        if child and (child:IsA("BoolValue") or child:IsA("StringValue")
            or child:IsA("NumberValue") or child:IsA("IntValue") or child:IsA("ObjectValue")) then
            if child.Value ~= nil then return child.Value end
        end
        for _, folderName in ipairs(folders) do
            local folder = instance:FindFirstChild(folderName)
            local value = folder and folder:FindFirstChild(name)
            if value and (value:IsA("BoolValue") or value:IsA("StringValue")
                or value:IsA("NumberValue") or value:IsA("IntValue") or value:IsA("ObjectValue")) then
                if value.Value ~= nil then return value.Value end
            end
        end
    end
    return nil
end

function H.enemyWord(value)
    return type(value) == "string" and value:lower():gsub("[^%w]", "") or nil
end

function H.enemyFactionFriendly(instance)
    local faction = H.enemyMetadata(instance, {"Faction", "FactionId", "Alliance", "AllianceId"})
    local localFaction = H.enemyMetadata(player, {"Faction", "FactionId", "Alliance", "AllianceId"})
    if localFaction == nil and S.context then
        localFaction = H.enemyMetadata(S.context.character, {"Faction", "FactionId", "Alliance", "AllianceId"})
    end
    if faction ~= nil and localFaction ~= nil and faction ~= "" and localFaction ~= "" then
        if type(faction) == "string" and type(localFaction) == "string" then
            if faction:lower() == localFaction:lower() then return true end
        elseif faction == localFaction then return true end
    end
    local team = H.enemyMetadata(instance, {"Team", "TeamId"})
    if not player.Neutral and player.Team and team ~= nil then
        if team == player.Team or team == player.Team.Name then return true end
    end
    return false
end

function H.enemyFriendly(instance)
    if H.hasTag(instance, Config.FriendlyTags) or instance:GetAttribute("ProtectionIgnore") == true then return true end
    for _, name in ipairs({"Friendly", "IsFriendly", "Neutral", "IsNeutral", "Passive", "NonHostile", "Ally", "IsAlly"}) do
        if H.enemyMetadata(instance, {name}) == true then return true end
    end
    local friendly = {friendly = true, neutral = true, passive = true, ally = true,
        allied = true, nonhostile = true, civilian = true}
    for _, name in ipairs({"AIState", "State", "Disposition", "Alignment", "Attitude", "Faction"}) do
        if friendly[H.enemyWord(H.enemyMetadata(instance, {name}))] then return true end
    end
    return H.enemyFactionFriendly(instance)
end

function H.enemyHealth(instance)
    local value = H.enemyMetadata(instance, {"Health", "HP", "Hp", "HitPoints", "CurrentHealth"})
    return H.finite(value) and value or nil
end

function H.enemyInactive(instance)
    for _, name in ipairs({"Active", "IsActive", "Alive", "IsAlive"}) do
        if H.enemyMetadata(instance, {name}) == false then return true end
    end
    for _, name in ipairs({"Dead", "IsDead", "Destroyed"}) do
        if H.enemyMetadata(instance, {name}) == true then return true end
    end
    local humanoid = instance:IsA("Model") and instance:FindFirstChildOfClass("Humanoid") or nil
    if humanoid and (not H.finite(humanoid.Health) or humanoid.Health <= 0) then return true end
    local health = H.enemyHealth(instance)
    return health ~= nil and health <= 0
end

function H.enemyTargeted(instance)
    local ctx = S.context
    for _, name in ipairs({"Target", "CurrentTarget", "AttackTarget", "Enemy", "TargetPlayer", "TargetCharacter", "TargetUserId"}) do
        local target = H.enemyMetadata(instance, {name})
        if target == player or (ctx and (target == ctx.character or target == ctx.root or target == ctx.humanoid)) then return true end
        if typeof(target) == "Instance" and ctx and target:IsDescendantOf(ctx.character) then return true end
        if type(target) == "number" and target == player.UserId then return true end
        if type(target) == "string" and (target:lower() == player.Name:lower()
            or target == tostring(player.UserId)) then return true end
    end
    return false
end

function H.enemyExplicitHostile(instance)
    if H.hasTag(instance, Config.HostileTags) then return true end
    for _, name in ipairs({"Hostile", "IsHostile", "IsEnemy", "Enemy", "Attacking", "Aggro", "Aggressive"}) do
        if H.enemyMetadata(instance, {name}) == true then return true end
    end
    local hostile = {enemy = true, monster = true, attack = true, attacking = true,
        chase = true, chasing = true, aggro = true, aggressive = true, hostile = true,
        combat = true, hunting = true, huntingplayer = true}
    for _, name in ipairs({"AIState", "State", "Behavior", "Behaviour", "Disposition", "Alignment", "Attitude", "Faction"}) do
        if hostile[H.enemyWord(H.enemyMetadata(instance, {name}))] then return true end
    end
    return H.enemyTargeted(instance)
end

function H.enemyDamageable(instance)
    if H.hasTag(instance, {"Damageable"}) then return true end
    for _, name in ipairs({"Damageable", "IsDamageable", "CanTakeDamage", "CanBeDamaged"}) do
        if H.enemyMetadata(instance, {name}) == true then return true end
    end
    local health = H.enemyHealth(instance)
    return health ~= nil and health > 0
end

function H.watchEnemyMetadata(instance)
    if not H.combatValueRelevant(instance) then return false end
    if not (instance:IsA("BoolValue") or instance:IsA("StringValue") or instance:IsA("NumberValue")
        or instance:IsA("IntValue") or instance:IsA("ObjectValue")) then return false end
    if not instance:IsDescendantOf(Workspace) then return true end
    if S.watchers[instance] then H.refreshObject(instance); return true end
    local connections = {}
    S.watchers[instance] = connections
    H.connect(instance:GetPropertyChangedSignal("Value"), function() H.refreshObject(instance) end, connections)
    H.connect(instance:GetPropertyChangedSignal("Name"), function() H.refreshObject(instance) end, connections)
    H.refreshObject(instance)
    return true
end

function H.enemyOwner(instance)
    if instance:IsA("Model") then return instance end
    if not instance:IsA("BasePart") then return nil end
    local current, fallback = instance.Parent, nil
    while current and current ~= Workspace do
        if current:IsA("Model") then
            if current:FindFirstChildOfClass("Humanoid") or current:FindFirstChildOfClass("AnimationController")
                or H.enemyDamageable(current) then return current end
            -- Keep a real named/marked owning body; an arbitrary map model is
            -- not the owner of a separately tagged, damageable monster part.
            if not fallback and H.npcMarked(current) then fallback = current end
        end
        current = current.Parent
    end
    if H.enemyDamageable(instance) or H.npcMarked(instance) then return instance end
    return fallback or instance
end

function H.enemyRoot(instance)
    if instance:IsA("BasePart") then return instance end
    if not instance:IsA("Model") then return nil end
    local root = instance:FindFirstChild("HumanoidRootPart") or instance.PrimaryPart
        or instance:FindFirstChild("Head") or instance:FindFirstChildWhichIsA("BasePart", true)
    return root and root:IsA("BasePart") and root or nil
end

function H.combatMetadata(instance, names, predicate)
    if not instance then return false end
    local folderNames = Config.EnemyMetadataFolders
        or {"AI", "Config", "Configuration", "Stats", "Status", "Metadata", "Combat", "Data"}
    local folders
    local function inspect(value)
        return value and (value:IsA("BoolValue") or value:IsA("StringValue")
            or value:IsA("NumberValue") or value:IsA("IntValue") or value:IsA("ObjectValue"))
            and predicate(value.Value)
    end
    for _, name in ipairs(names) do
        local attribute = instance:GetAttribute(name)
        if attribute ~= nil and predicate(attribute) then return true end
        if inspect(instance:FindFirstChild(name)) then return true end
        if not folders then
            folders = {}
            for _, folderName in ipairs(folderNames) do
                local folder = instance:FindFirstChild(folderName)
                if folder then folders[#folders + 1] = folder end
            end
        end
        for _, folder in ipairs(folders) do
            if inspect(folder:FindFirstChild(name)) then return true end
        end
    end
    return false
end

function H.combatFlag(instance, names, expected)
    return H.combatMetadata(instance, names, function(value) return value == expected end)
end

function H.combatRelationEqual(first, second)
    if first == nil or second == nil or first == "" or second == "" then return false end
    if type(first) == "string" and type(second) == "string" then
        return first:lower() == second:lower()
    end
    if first == second then return true end
    if typeof(first) == "Instance" and type(second) == "string" then return first.Name:lower() == second:lower() end
    if typeof(second) == "Instance" and type(first) == "string" then return second.Name:lower() == first:lower() end
    return false
end

function H.combatSameRelation(instance)
    local contexts = {player}
    local character = S.context and S.context.character or player.Character
    if character then contexts[#contexts + 1] = character end
    for _, names in ipairs({{"Faction", "FactionId"}, {"Alliance", "AllianceId"},
        {"Team", "TeamId", "TeamName"}}) do
        if names[1] ~= "Team" or not player.Neutral then
            local matched = H.combatMetadata(instance, names, function(value)
                if names[1] == "Team" and player.Team and H.combatRelationEqual(value, player.Team) then return true end
                for _, context in ipairs(contexts) do
                    if H.combatMetadata(context, names, function(localValue)
                        return H.combatRelationEqual(value, localValue)
                    end) then return true end
                end
                return false
            end)
            if matched then return true end
        end
    end
    return false
end

function H.combatFriendly(instance)
    if H.hasTag(instance, Config.FriendlyTags) or H.hasTag(instance,
        {"Ally", "Allied", "Civilian", "NonCombatant", "FriendlyNPC", "Companion", "Pacifist"}) then return true end
    if H.combatFlag(instance, {"ProtectionIgnore", "Friendly", "IsFriendly", "Neutral", "IsNeutral",
        "Passive", "NonHostile", "Ally", "IsAlly", "Civilian", "NonCombatant", "Pacifist"}, true) then return true end
    local friendly = {friendly = true, neutral = true, passive = true, ally = true,
        allied = true, nonhostile = true, civilian = true, noncombatant = true, pacifist = true}
    if H.combatMetadata(instance, {"AIState", "State", "Disposition", "Alignment", "Attitude", "Faction"},
        function(value) return friendly[H.enemyWord(value)] == true end) then return true end
    return H.combatSameRelation(instance)
end

function H.combatOwnerFriendly(instance)
    return H.combatMetadata(instance, {"Owner", "OwnerPlayer", "OwnerUserId", "Creator", "CreatorUserId",
        "Summoner", "SummonerUserId"}, function(value)
        local owner
        if typeof(value) == "Instance" then
            if value:IsA("Player") then owner = value
            elseif value:IsA("Model") then owner = Players:GetPlayerFromCharacter(value) end
        elseif type(value) == "number" or type(value) == "string" then
            for _, candidate in ipairs(Players:GetPlayers()) do
                if tostring(value) == tostring(candidate.UserId)
                    or (type(value) == "string" and value:lower() == candidate.Name:lower()) then owner = candidate; break end
            end
        end
        if not owner then return false end
        return owner == player or (not player.Neutral and not owner.Neutral
            and player.Team ~= nil and owner.Team == player.Team) or H.combatSameRelation(owner)
    end)
end

function H.combatProtected(instance)
    if H.hasTag(instance, {"Invulnerable", "Invincible", "Immune", "Immortal", "NoDamage", "GodMode", "Untargetable",
        "Unkillable", "NonCombatant", "SafeZone", "SpawnProtected", "Protected", "DamageImmune", "AimIgnore"}) then return true end
    if H.combatFlag(instance, {"Dead", "IsDead", "Destroyed", "Invulnerable", "Invincible", "Immune",
        "NoDamage", "GodMode", "Unkillable", "SafeZone", "SpawnProtected", "Protected", "DamageImmune",
        "Untargetable", "IgnoreAim", "AimIgnore", "NonCombatant", "Pacifist", "IsInvulnerable",
        "IsInvincible", "IsImmune", "Immortal", "IsImmortal"}, true) then return true end
    if H.combatFlag(instance, {"Active", "IsActive", "Alive", "IsAlive", "Targetable", "IsTargetable",
        "CanBeTargeted", "Attackable", "CanBeAttacked", "Damageable", "IsDamageable", "CanTakeDamage",
        "CanBeDamaged", "CanBeKilled", "Killable", "CanDie", "Destructible"}, false) then return true end
    if instance:FindFirstChildOfClass("ForceField") then return true end
    if instance:IsA("Humanoid") and (not H.finite(instance.Health) or instance.Health <= 0) then return true end
    local humanoid = instance:IsA("Model") and instance:FindFirstChildOfClass("Humanoid") or nil
    if humanoid and (not H.finite(humanoid.Health) or humanoid.Health <= 0) then return true end
    return H.combatMetadata(instance, {"Health", "HP", "Hp", "HitPoints", "CurrentHealth"},
        function(value) return type(value) == "number" and (not H.finite(value) or value <= 0) end)
end

function H.combatBlocked(instance, root, humanoid, targetPlayer)
    local character = S.context and S.context.character or player.Character
    local current = instance
    while current and current ~= Workspace do
        if current == character or current:IsA("Accessory") or current:IsA("Tool")
            or H.combatFriendly(current) or H.combatProtected(current) or H.combatOwnerFriendly(current) then return true end
        current = current.Parent
    end
    if instance:IsA("Model") and instance:FindFirstChildWhichIsA("ForceField", true) then return true end
    for _, subject in pairs({root, humanoid, targetPlayer}) do
        if subject and (H.combatFriendly(subject) or H.combatProtected(subject)
            or H.combatOwnerFriendly(subject)) then return true end
    end
    return false
end

function H.combatKillable(instance, root, humanoid)
    if humanoid then return H.finite(humanoid.Health) and humanoid.Health > 0 end
    local subjects = {instance}
    if root ~= instance then subjects[#subjects + 1] = root end
    for _, subject in ipairs(subjects) do
        if H.hasTag(subject, {"Damageable"}) or H.combatFlag(subject,
            {"Damageable", "IsDamageable", "CanTakeDamage", "CanBeDamaged", "CanBeKilled", "Killable"}, true)
            or H.combatMetadata(subject, {"Health", "HP", "Hp", "HitPoints", "CurrentHealth"},
                function(value) return H.finite(value) and value > 0 end) then return true end
    end
    return false
end

function H.combatNameHostile(instance)
    if Config.UseNPCNameHints == false then return false end
    local genres = {enemy = true, hostile = true, monster = true, zombie = true, undead = true,
        ghoul = true, demon = true, skeleton = true, mutant = true, infected = true,
        worm = true, sandworm = true, deathworm = true, giantworm = true, wormmonster = true}
    local modifiers = {fast = true, slow = true, giant = true, mini = true, mega = true,
        boss = true, elite = true, armored = true, armoured = true, toxic = true, fire = true,
        ice = true, frost = true, dark = true, shadow = true, cave = true, sand = true,
        death = true, red = true, green = true, blue = true, big = true, small = true,
        alpha = true, super = true}
    for word in pairs(H.tokens(instance.Name)) do
        word = word:gsub("%d", "")
        if genres[word] then return true end
        for genre in pairs(genres) do
            if #word > #genre and word:sub(-#genre) == genre
                and modifiers[word:sub(1, #word - #genre)] then return true end
        end
    end
    return false
end

function H.combatHostile(instance, root, humanoid)
    local current = instance
    local containers = {enemies = true, hostiles = true, monsters = true, zombies = true,
        undead = true, infected = true, demons = true, bosses = true}
    while current and current ~= Workspace do
        if H.enemyExplicitHostile(current) then return true end
        if humanoid and current ~= instance and (current:IsA("Folder") or current:IsA("Model"))
            and containers[H.enemyWord(current.Name)] then return true end
        current = current.Parent
    end
    if root and H.enemyExplicitHostile(root) then return true end
    if humanoid and H.enemyExplicitHostile(humanoid) then return true end
    return humanoid ~= nil and H.combatNameHostile(instance)
end

function H.enemyRecord(instance, origin, options)
    options = options or {}
    if type(options) ~= "table" or typeof(instance) ~= "Instance"
        or typeof(origin) ~= "Vector3" or not H.finiteVector(origin) then return nil end
    if instance:IsA("Player") then instance = instance.Character end
    if not instance or not instance.Parent or not instance:IsDescendantOf(Workspace) then return nil end
    if not (instance:IsA("Model") or instance:IsA("BasePart")) then return nil end
    if instance:IsA("BasePart") then instance = H.enemyOwner(instance) end
    if not instance then return nil end
    local current, targetPlayer = instance, nil
    while current and current ~= Workspace do
        if current:IsA("Model") then
            targetPlayer = Players:GetPlayerFromCharacter(current)
            if targetPlayer then instance = current; break end
        end
        current = current.Parent
    end
    local humanoid = instance:IsA("Model") and instance:FindFirstChildOfClass("Humanoid") or nil
    local root = H.enemyRoot(instance)
    if not root or not root.Parent or not root:IsDescendantOf(Workspace)
        or not H.finiteVector(root.Position) or H.combatBlocked(instance, root, humanoid, targetPlayer)
        or not H.combatKillable(instance, root, humanoid) then return nil end
    if targetPlayer then
        if options.allowPlayers == false or not H.autoAimEnemyPlayer({instance = instance,
            root = root, humanoid = humanoid, player = targetPlayer}) then return nil end
    elseif not H.combatHostile(instance, root, humanoid) then return nil end
    local distance = (root.Position - origin).Magnitude
    local range = options.range or Config.EnemyScanRange or 1400
    if not H.finite(range) or range < 0 or distance > range then return nil end
    local head = instance:IsA("Model") and instance:FindFirstChild("Head") or nil
    local aimPosition = root.Position
    if head and head:IsA("BasePart") and H.finiteVector(head.Position) then aimPosition = head.Position end
    return {instance = instance, root = root, humanoid = humanoid, player = targetPlayer,
        position = root.Position, aimPosition = aimPosition, distance = distance,
        cameraEligible = true, bulletEligible = true}
end

function H.scanEnemies(origin, options)
    options = options or {}
    local records, seen, seenRoots = {}, {}, {}
    local function add(instance)
        if not instance then return end
        if instance:IsA("BasePart") then instance = H.enemyOwner(instance) end
        if not instance or seen[instance] then return end
        seen[instance] = true
        local record = H.enemyRecord(instance, origin, options)
        if record and not seenRoots[record.root] then
            seenRoots[record.root] = true
            records[#records + 1] = record
        end
    end
    if options.allowPlayers ~= false then
        for _, opponent in ipairs(Players:GetPlayers()) do add(opponent.Character) end
    end
    for instance in pairs(S.npcs) do
        if instance.Parent and instance:IsDescendantOf(Workspace) then
            if instance:IsA("BasePart") or (instance:IsA("Model")
                and (instance:FindFirstChildOfClass("Humanoid") or H.enemyDamageable(instance))) then add(instance) end
        end
    end
    table.sort(records, function(first, second) return first.distance < second.distance end)
    return records
end

function H.npcNameHint(name)
    if not Config.UseNPCNameHints then return false end
    local tokens = H.tokens(name)
    for _, word in ipairs(Config.NPCNameHints) do
        if tokens[word] then return true end
    end
    -- Also match lower-case compound names such as "sandwormboss".
    return name:lower():find("worm", 1, true) ~= nil
end

function H.npcMarked(instance)
    return H.enemyExplicitHostile(instance) or H.npcNameHint(instance.Name)
end

function H.npcCandidate(instance)
    if not (instance:IsA("Model") or instance:IsA("BasePart") or instance:IsA("Folder")) then return false end
    if H.npcMarked(instance) then return true end
    if instance:IsA("BasePart") and H.enemyDamageable(instance) then return true end
    if instance:IsA("Model") and (instance:FindFirstChildOfClass("Humanoid")
        or instance:FindFirstChildOfClass("AnimationController") or H.enemyDamageable(instance)) then return true end
    -- Target values can begin empty and change later; watch their owning rig now.
    for _, container in ipairs(instance:GetChildren()) do
        if container:IsA("ObjectValue") then
            local name = container.Name:lower()
            if name:find("target", 1, true) or name == "enemy" then return true end
        end
    end
    return false
end

function H.worldIndexNeeded()
    return S.flags.lock or S.flags.aim or S.flags.bullet
end

function H.enemyIndexNeeded()
    return S.flags.aim or S.flags.bullet
end

function H.combatIndexState()
    if not S.combatIndex then
        S.combatIndex = {objects = {}, lookup = {}, cursor = 1, jobs = {}, jobIndex = 1,
            queued = setmetatable({}, {__mode = "k"}), eventQueue = {}, eventIndex = 1,
            eventQueued = setmetatable({}, {__mode = "k"}), shots = {}, lastAcquire = -math.huge,
            lastTarget = -math.huge, nextLocal = -math.huge}
    end
    return S.combatIndex
end

function H.indexCombatObject(instance, enabled)
    local index = H.combatIndexState()
    S.npcs[instance] = enabled and true or nil
    local location = index.lookup[instance]
    if enabled then
        if not location then
            index.objects[#index.objects + 1] = instance
            index.lookup[instance] = #index.objects
        end
    elseif location then
        local last = index.objects[#index.objects]
        index.objects[location], index.objects[#index.objects] = last, nil
        index.lookup[instance] = nil
        if last and last ~= instance then index.lookup[last] = location end
        if index.cursor > #index.objects then index.cursor = 1 end
    end
end

function H.queueCombatObject(instance)
    if not S.alive or not H.worldIndexNeeded() or not instance then return end
    local index = H.combatIndexState()
    if index.eventQueued[instance] then return end
    index.eventQueued[instance] = true
    index.eventQueue[#index.eventQueue + 1] = instance
end

function H.queueCombatBranch(instance)
    if not S.alive or not H.worldIndexNeeded() or not instance then return end
    local index = H.combatIndexState()
    if index.queued[instance] then return end
    index.queued[instance] = true
    index.jobs[#index.jobs + 1] = {instance = instance}
end

function H.combatValueRelevant(instance)
    if not (instance:IsA("BoolValue") or instance:IsA("StringValue") or instance:IsA("NumberValue")
        or instance:IsA("IntValue") or instance:IsA("ObjectValue")) then return false end
    local current, depth = instance.Parent, 0
    while current and current ~= Workspace and depth < 16 do
        if S.npcs[current] or (current:IsA("Model") and (current:FindFirstChildOfClass("Humanoid")
            or current:FindFirstChildOfClass("AnimationController"))) then return true end
        current, depth = current.Parent, depth + 1
    end
    return false
end

function H.stepCombatIndex()
    if not H.worldIndexNeeded() then return end
    local index, deadline = H.combatIndexState(), os.clock() + 0.0015
    local budget = math.clamp(Config.IndexBatchSize or 40, 8, 40)
    local processed = 0
    while processed < budget and os.clock() < deadline do
        local instance
        index.indexTurn = (index.indexTurn or 0) + 1
        if index.eventIndex <= #index.eventQueue and (index.indexTurn % 3 ~= 0 or index.jobIndex > #index.jobs) then
            instance = index.eventQueue[index.eventIndex]
            index.eventQueue[index.eventIndex] = false
            index.eventIndex += 1
            index.eventQueued[instance] = nil
        else
            local job = index.jobs[index.jobIndex]
            if not job then
                if index.eventIndex > #index.eventQueue then break end
            elseif not job.instance or (job.instance ~= Workspace and not job.instance:IsDescendantOf(Workspace)) then
                index.queued[job.instance] = nil
                index.jobs[index.jobIndex] = false
                index.jobIndex += 1
            else
                if not job.children then job.children, job.cursor = job.instance:GetChildren(), 1 end
                instance = job.children[job.cursor]
                if not instance then
                    index.queued[job.instance] = nil
                    index.jobs[index.jobIndex] = false
                    index.jobIndex += 1
                else
                    job.children[job.cursor] = false
                    job.cursor += 1
                    H.queueCombatBranch(instance)
                end
            end
        end
        processed += 1
        if instance and instance.Parent and instance:IsDescendantOf(Workspace) then H.watchObject(instance) end
    end
    if index.eventIndex > #index.eventQueue then index.eventQueue, index.eventIndex = {}, 1 end
    if index.jobIndex > #index.jobs then index.jobs, index.jobIndex = {}, 1 end
    index.lastIndexCount = processed
end

function H.clearAimSelection()
    if S.aimWatchConnections then H.disconnectAll(S.aimWatchConnections) end
    S.aimWatchConnections, S.aimWatchState = nil, nil
    S.aimRecord, S.aimTarget, S.aimRecordAt, S.aimDirty, S.aimReleaseRequested = nil, nil, nil, nil, nil
end

function H.invalidateAimObject(instance)
    local record = S.aimRecord
    if not record or not instance then return end
    local character = S.context and S.context.character or player.Character
    if instance == record.instance or instance == record.root or instance == record.humanoid
        or instance == record.player or instance == player or instance == character
        or instance:IsDescendantOf(record.instance) or record.instance:IsDescendantOf(instance)
        or (character and instance:IsDescendantOf(character)) then S.aimDirty, S.aimTarget = true, nil end
end

function H.aimMetadataFolder(instance)
    for _, name in ipairs(Config.EnemyMetadataFolders or {"AI", "Config", "Configuration", "Stats",
        "Status", "Metadata", "Combat", "Data"}) do
        if instance.Name == name then return true end
    end
    return false
end

function H.aimMetadataEvent(instance)
    if not instance then return false end
    if instance:IsA("ForceField") or instance:IsA("Humanoid") or instance:IsA("AnimationController")
        or instance:IsA("BoolValue") or instance:IsA("StringValue") or instance:IsA("NumberValue")
        or instance:IsA("IntValue") or instance:IsA("ObjectValue") or H.aimMetadataFolder(instance) then return true end
    local record = S.aimRecord
    return instance:IsA("BasePart") and (instance.Name == "Head" or instance.Name == "HumanoidRootPart"
        or (record and (instance == record.root or instance == record.head)))
end

function H.aimWatchSubject(subject, connections, state)
    if not subject or state.seen[subject] then return end
    state.seen[subject] = true
    local function dirty() S.aimDirty, S.aimTarget = true, nil end
    H.connect(subject.AttributeChanged, dirty, connections)
    H.connect(subject:GetPropertyChangedSignal("Name"), dirty, connections)
    H.connect(subject.AncestryChanged, dirty, connections)
    local global = subject == Workspace or subject == game
    H.connect(subject.ChildAdded, function(child)
        if (not global and H.aimMetadataEvent(child)) or H.aimMetadataFolder(child) or child.Name == "PvPEnabled"
            or child.Name == "PVPEnabled" or child.Name == "CanPvP" or child.Name == "FFA" then
            dirty()
            if state.ready then state.ready = false end
            state.sources[#state.sources + 1] = {instance = child, direct = true}
        end
    end, connections)
    H.connect(subject.ChildRemoved, function(child)
        if H.aimMetadataEvent(child) then dirty() end
    end, connections)
    if subject:IsA("Humanoid") then H.connect(subject:GetPropertyChangedSignal("Health"), dirty, connections) end
    if subject:IsA("Player") then
        for _, name in ipairs({"Team", "Neutral", "Character"}) do
            H.connect(subject:GetPropertyChangedSignal(name), dirty, connections)
        end
    end
    if subject:IsA("BoolValue") or subject:IsA("StringValue") or subject:IsA("NumberValue")
        or subject:IsA("IntValue") or subject:IsA("ObjectValue") then
        H.connect(subject:GetPropertyChangedSignal("Value"), dirty, connections)
    else
        if not global then state.sources[#state.sources + 1] = {instance = subject}
        else
            for _, name in ipairs({"PvPEnabled", "PVPEnabled", "CanPvP", "FFA"}) do
                local value = subject:FindFirstChild(name)
                if value then state.sources[#state.sources + 1] = {instance = value, direct = true} end
            end
        end
        for _, name in ipairs(Config.EnemyMetadataFolders or {"AI", "Config", "Configuration", "Stats",
            "Status", "Metadata", "Combat", "Data"}) do
            local folder = subject:FindFirstChild(name)
            if folder and not state.seen[folder] then state.sources[#state.sources + 1] = {instance = folder, direct = true} end
        end
    end
end

function H.aimSameWatchScope(record)
    local state = S.aimWatchState
    if not state or not S.aimRecord or S.aimRecord.instance ~= record.instance
        or state.root ~= record.root or state.humanoid ~= record.humanoid or state.player ~= record.player
        or state.character ~= (S.context and S.context.character or player.Character) then return false end
    local current = record.instance.Parent
    for _, ancestor in ipairs(state.ancestors) do
        if current ~= ancestor then return false end
        current = current.Parent
    end
    return current == Workspace
end

function H.prepareAimSelection(record)
    if H.aimSameWatchScope(record) then
        S.aimRecord, S.aimTarget, S.aimRecordAt, S.aimDirty = record, record.instance, os.clock(), false
        return
    end
    H.clearAimSelection()
    S.aimRecord, S.aimTarget, S.aimRecordAt, S.aimDirty = record, record.instance, os.clock(), false
    local connections = {}
    local state = {seen = {}, sources = {}, cursor = 1, inspected = 0, ready = false,
        root = record.root, humanoid = record.humanoid, player = record.player,
        character = S.context and S.context.character or player.Character, ancestors = {}}
    S.aimWatchConnections, S.aimWatchState = connections, state
    H.connect(record.instance.DescendantAdded, function(descendant)
        if H.aimMetadataEvent(descendant) then
            S.aimDirty, S.aimTarget = true, nil
            state.ready = false
            state.sources[#state.sources + 1] = {instance = descendant, direct = true}
        end
    end, connections)
    H.connect(record.instance.DescendantRemoving, function(descendant)
        if H.aimMetadataEvent(descendant) then S.aimDirty, S.aimTarget = true, nil end
    end, connections)
    for _, subject in pairs({record.instance, record.root, record.humanoid, record.player,
        player, S.context and S.context.character or player.Character, Workspace, game}) do
        H.aimWatchSubject(subject, connections, state)
    end
    local current, depth = record.instance.Parent, 0
    while current and current ~= Workspace and depth < 16 do
        state.ancestors[#state.ancestors + 1] = current
        H.aimWatchSubject(current, connections, state)
        current, depth = current.Parent, depth + 1
    end
    local seenTags = {}
    for _, tags in ipairs({Config.FriendlyTags or {}, Config.HostileTags or {}, {"Invulnerable", "Invincible", "Immune", "Immortal", "NoDamage", "GodMode",
        "Untargetable", "Unkillable", "NonCombatant", "SafeZone", "SpawnProtected", "Protected", "DamageImmune",
        "AimIgnore", "Ally", "Allied", "Civilian", "FriendlyNPC", "Companion", "Pacifist", "Damageable"}}) do
        for _, tag in ipairs(tags) do
            if not seenTags[tag] then
                seenTags[tag] = true
                H.connect(CollectionService:GetInstanceAddedSignal(tag), H.invalidateAimObject, connections)
                H.connect(CollectionService:GetInstanceRemovedSignal(tag), H.invalidateAimObject, connections)
            end
        end
    end
    if current ~= Workspace then H.clearAimSelection() end
end

function H.stepAimWatchers()
    local state, connections = S.aimWatchState, S.aimWatchConnections
    if not state or state.ready then return end
    local deadline, processed = os.clock() + 0.0007, 0
    while processed < 32 and state.cursor <= #state.sources and os.clock() < deadline do
        local source = state.sources[state.cursor]
        if source.direct then
            if source.instance:IsA("BoolValue") or source.instance:IsA("StringValue")
                or source.instance:IsA("NumberValue") or source.instance:IsA("IntValue")
                or source.instance:IsA("ObjectValue") or H.aimMetadataFolder(source.instance) then H.aimWatchSubject(source.instance, connections, state) end
            state.cursor += 1
        else
            if not source.children then source.children, source.cursor = source.instance:GetChildren(), 1 end
            local child = source.children[source.cursor]
            if not child then state.cursor += 1
            else
                source.children[source.cursor] = false
                source.cursor += 1
                state.inspected += 1
                if child:IsA("BoolValue") or child:IsA("StringValue") or child:IsA("NumberValue")
                    or child:IsA("IntValue") or child:IsA("ObjectValue") then H.aimWatchSubject(child, connections, state) end
            end
        end
        processed += 1
        if state.inspected > 512 or #connections > 1600 then H.clearAimSelection(); return end
    end
    if state.cursor > #state.sources then state.ready = true; S.aimDirty = true end
end

function H.aimCanUpdate()
    if not S.flags.aim or not H.ready() or S.observingPlayer
        or UserInputService:GetFocusedTextBox() then return false end
    local camera = Workspace.CurrentCamera
    return camera and camera.CameraType ~= Enum.CameraType.Scriptable
end

function H.aimCheapRecord(record, origin)
    if not record or not record.instance or not record.instance.Parent or not record.root or not record.root.Parent
        or (record.root ~= record.instance and not record.root:IsDescendantOf(record.instance)) or not record.instance:IsDescendantOf(Workspace)
        or not H.finiteVector(record.root.Position) then return nil end
    if record.humanoid and (not record.humanoid.Parent or not H.finite(record.humanoid.Health)
        or record.humanoid.Health <= 0) then return nil end
    if record.player and (record.player == player or record.player.Character ~= record.instance
        or (not player.Neutral and not record.player.Neutral and player.Team and player.Team == record.player.Team)) then return nil end
    local range = H.finite(Config.AimRange) and Config.AimRange or 600
    local distance = (record.root.Position - origin).Magnitude
    if distance > range then return nil end
    local position = record.root.Position
    if record.head and record.head.Parent == record.instance and H.finiteVector(record.head.Position) then position = record.head.Position end
    return {instance = record.instance, root = record.root, humanoid = record.humanoid,
        player = record.player, position = record.root.Position, aimPosition = position, distance = distance}
end

function H.nextCombatCandidate(index)
    if #index.objects == 0 then return nil end
    if index.cursor > #index.objects then index.cursor = 1 end
    local instance = index.objects[index.cursor]
    index.cursor += 1
    return instance
end

function H.rememberShotCandidate(record, now)
    local index = H.combatIndexState()
    for position = #index.shots, 1, -1 do
        if index.shots[position].instance == record.instance then table.remove(index.shots, position); break end
    end
    record.sampledAt = now
    index.shots[#index.shots + 1] = record
    if #index.shots > 32 then table.remove(index.shots, 1) end
end


function H.updateAimWorker()
    local index, now = H.combatIndexState(), os.clock()
    if not H.aimCanUpdate() then H.clearAimSelection(); return end
    local camera = Workspace.CurrentCamera
    H.stepAimWatchers()
    if S.aimRecord and (S.aimDirty or now - (S.aimRecordAt or -math.huge) >= 0.05) then
        local record = H.enemyRecord(S.aimRecord.instance, camera.CFrame.Position,
            {range = Config.AimRange, camera = true, allowPlayers = true})
        if record and H.aimScreenOffset(record, camera)
            and H.enemyVisible(record, camera.CFrame.Position, nil, true, nil, true) then
            record.head = record.instance:IsA("Model") and record.instance:FindFirstChild("Head") or nil
            if record.head and not record.head:IsA("BasePart") then record.head = nil end
            H.prepareAimSelection(record)
        else H.clearAimSelection() end
        index.lastTarget = now
    end
    if not S.aimRecord and now - index.lastAcquire >= math.max(0.025, Config.AimScanInterval or 0.1) then
        index.lastAcquire = now
        local record = H.pickAimTarget(camera.CFrame.Position, camera)
        if record then
            record.head = record.instance:IsA("Model") and record.instance:FindFirstChild("Head") or nil
            if record.head and not record.head:IsA("BasePart") then record.head = nil end
            H.prepareAimSelection(record)
        end
    end
end

function H.updateCombatWork()
    if not S.alive or not H.worldIndexNeeded() then return end
    H.stepCombatIndex()
    local index, now = H.combatIndexState(), os.clock()
    if H.enemyIndexNeeded() and now >= (index.nextPlayers or -math.huge) then
        index.nextPlayers = now + 0.5
        for _, opponent in ipairs(Players:GetPlayers()) do
            if opponent ~= player and opponent.Character then H.indexCombatObject(opponent.Character, true) end
        end
    end
    if S.aimReleaseRequested then H.clearAimSelection(); S.aimReleaseRequested = nil end
    H.updateAimWorker()
    if S.flags.bullet
        and now - index.lastAcquire >= math.max(0.025, Config.AimScanInterval or 0.1) and H.ready() then
        index.lastAcquire = now
        H.pickAimTarget(S.context.root.Position, nil)
    end
end

function H.clearCombatWork()
    H.clearAimSelection()
    S.combatIndex = nil
end


function H.refreshObject(instance)
    H.invalidateAimObject(instance)
    if not S.alive or not instance or not instance.Parent or not H.worldIndexNeeded() then return end
    local wantHazard = S.flags.lock
    local wantEnemy = H.enemyIndexNeeded()
    local wasHazard = S.hazards[instance]
    S.hazards[instance] = wantHazard and H.hazardCandidate(instance) or nil
    if wasHazard or S.hazards[instance] then S.hazardCache = nil end
    H.indexCombatObject(instance, wantEnemy and H.npcCandidate(instance))
    if S.flags.bullet and instance:IsA("BasePart") then H.tryRegisterBullet(instance) end
    local ancestor = instance.Parent
    while ancestor and ancestor ~= Workspace do
        if ancestor:IsA("Model") or ancestor:IsA("Folder") then
            local old = S.hazards[ancestor]
            S.hazards[ancestor] = wantHazard and H.hazardCandidate(ancestor) or nil
            if old or S.hazards[ancestor] then S.hazardCache = nil end
            H.indexCombatObject(ancestor, wantEnemy and H.npcCandidate(ancestor))
        end
        ancestor = ancestor.Parent
    end
end

function H.watchObject(instance)
    if not S.alive or not H.worldIndexNeeded() or not instance
        or not instance:IsDescendantOf(Workspace) then return end
    if H.enemyIndexNeeded() and H.watchEnemyMetadata(instance) then return end
    if instance:IsA("Humanoid") or instance:IsA("AnimationController") then
        if H.enemyIndexNeeded() then H.refreshObject(instance) end
        return
    end
    if not (instance:IsA("BasePart") or instance:IsA("Model")
        or instance:IsA("Explosion") or instance:IsA("Folder")) then return end
    -- Do not attach listeners to every door, tree and decoration.
    local relevantHazard = S.flags.lock and H.hazardCandidate(instance)
    local relevantEnemy = H.enemyIndexNeeded() and H.npcCandidate(instance)
    if S.flags.bullet and instance:IsA("BasePart") then H.tryRegisterBullet(instance) end
    if not (relevantHazard or relevantEnemy or S.watchers[instance]) then return end
    if S.watchers[instance] then H.refreshObject(instance); return end
    local connections = {}
    S.watchers[instance] = connections
    H.connect(instance:GetPropertyChangedSignal("Name"), function()
        if not H.worldIndexNeeded() then return end
        H.refreshObject(instance)
        H.queueBranch(instance)
    end, connections)
    H.connect(instance.AttributeChanged, function(attribute)
        if not H.worldIndexNeeded() then return end
        H.refreshObject(instance)
        if attribute == "ProtectionIgnore" or attribute == "Active"
            or attribute == "IsActive" or attribute == "Armed"
            or attribute == "OwnerUserId" or attribute == "ShooterUserId"
            or attribute == "CreatorUserId" then H.queueBranch(instance) end
    end, connections)
    H.refreshObject(instance)
end

function H.queueBranch(instance)
    H.queueCombatBranch(instance)
end

function H.clearInactiveIndexes()
    if H.worldIndexNeeded() then return end
    S.pending, S.pendingIndex = {}, 1
    for instance in pairs(S.watchers) do H.removeObject(instance) end
    S.npcs, S.hazards, S.motion, S.hazardErrors, S.impactEntries = {}, {}, {}, {}, {}
    S.hazardCache, S.hazardCacheAt = nil, -math.huge
    H.clearCombatWork()
end

function H.removeObject(instance)
    H.invalidateAimObject(instance)
    H.indexCombatObject(instance, false)
    local connections = S.watchers[instance]
    if connections then H.disconnectAll(connections); S.watchers[instance] = nil end
    if S.hazards[instance] then S.hazardCache = nil end
    S.hazards[instance], S.motion[instance], S.npcs[instance] = nil, nil, nil
    local guided = S.guidedBullets[instance]
    if guided then H.releaseGuidedBullet(instance, guided) end
    S.hazardErrors[instance], S.impactEntries[instance] = nil, nil
end

function H.clearSpace(target)
    if not H.ready() or not H.finiteVector(target.Position)
        or target.Position.Y <= Workspace.FallenPartsDestroyHeight + 8 then return false end
    local ctx = S.context
    -- Character:GetBoundingBox includes oversized pets, shields and cosmetics, which
    -- previously made many perfectly reasonable saved/spawn positions look obstructed.
    local clearanceHeight = math.max(3.8, ctx.humanoid.HipHeight + ctx.root.Size.Y + 1.0)
    local clearance = Vector3.new(math.max(2.6, ctx.root.Size.X + 0.5),
        clearanceHeight, math.max(2.6, ctx.root.Size.Z + 0.5))
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ctx.character}
    params.MaxParts = 0
    for _, part in ipairs(Workspace:GetPartBoundsInBox(target, clearance * 0.92, params)) do
        if part.CanCollide then return false end
    end
    -- Terrain cannot be found by bounding-box overlap reliably on every terrain shape.
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {ctx.character}
    rayParams.RespectCanCollide = true
    for _, axis in ipairs({target.RightVector * clearance.X * 0.45,
        target.UpVector * clearance.Y * 0.45,
        target.LookVector * clearance.Z * 0.45}) do
        local hit = Workspace:Raycast(target.Position - axis, axis * 2, rayParams)
        if hit and hit.Instance:IsA("Terrain") then return false end
    end
    return true
end

function H.clearEscapePath(target)
    local ctx = S.context
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ctx.character}
    params.RespectCanCollide = true
    local displacement = target.Position - ctx.root.Position
    for _, height in ipairs({0, math.max(2, ctx.root.Size.Y * 0.5 + 1)}) do
        if Workspace:Raycast(ctx.root.Position + Vector3.new(0, height, 0), displacement, params) then return false end
    end
    return true
end

function H.safeDestination(target)
    return H.clearSpace(target) and H.findHazard(target.Position, Vector3.zero, false) == nil
end

function H.landingAt(target)
    if not H.ready() then return nil end
    local ctx = S.context
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ctx.character}
    params.RespectCanCollide = true
    local hit = Workspace:Raycast(target.Position + Vector3.new(0, 2, 0),
        Vector3.new(0, -(Config.MaxEscapeDistance + 50), 0), params)
    if not hit or hit.Normal.Y < 0.5 then return nil end
    local height = math.max(3, ctx.humanoid.HipHeight + ctx.root.Size.Y * 0.5 + 0.25)
    local result = CFrame.new(hit.Position + Vector3.new(0, height, 0)) * (target - target.Position)
    if H.safeDestination(result) then return result end
    return nil
end

function H.escapeDirections(pursuit, current)
    local away = pursuit and (current.Position - pursuit.bounds.Position) or current.LookVector
    away = Vector3.new(away.X, 0, away.Z)
    if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
    away = away.Unit
    local velocity = pursuit and pursuit.velocity or Vector3.zero
    local flat = Vector3.new(velocity.X, 0, velocity.Z)
    -- Cross the attack trajectory instead of just running ahead along it.
    local side = flat.Magnitude > 1 and Vector3.new(-flat.Z, 0, flat.X).Unit
        or Vector3.new(-away.Z, 0, away.X)
    if S.escape and (S.escape.chaseCount or 0) % 2 == 1 then side = -side end
    return away, side
end

function H.escapeClearance(target, records)
    local clearance = 180
    for _, info in ipairs(records) do
        if H.threatAt(info, target.Position, Vector3.zero, false) then return nil end
        local steps = (info.acceleration or Vector3.zero).Magnitude > 1 and Config.HazardPredictionSteps or 1
        local from = target.Position
        for step = 1, steps do
            local time = Config.PredictionSeconds * step / steps
            local relative = target.Position - info.velocity * time - H.hazardAccelerationOffset(info, time)
            local distance = H.segmentBoxDistance(info.bounds, info.size, from, relative - from)
                - info.radius - Config.HazardMargin - math.min(8, (info.angularSpeed or 0) * info.size.Magnitude * 0.025)
            clearance = math.min(clearance, distance)
            from = relative
        end
    end
    local score = clearance
    local now = os.clock()
    for _, entry in ipairs(S.escapeHistory) do
        if now - entry.time < Config.ChaseHistoryDuration then
            score -= math.max(0, 30 - (target.Position - entry.position).Magnitude) * 1.5
        end
    end
    score -= (target.Position - S.context.root.Position).Magnitude * 0.08
    return score
end

function H.selectEscapeTarget(candidates)
    if not H.ready() then return nil end
    local records, best, bestScore = H.hazardSnapshot(), nil, nil
    for _, target in ipairs(candidates) do
        if H.finiteVector(target.Position) and (target.Position - S.context.root.Position).Magnitude > 3 then
            local score = H.escapeClearance(target, records)
            -- PivotTo has no intervening physical path. A roof between the old
            -- and new poses must not veto an otherwise clear destination.
            if score and (not bestScore or score > bestScore) and H.clearSpace(target) then
                best, bestScore = target, score
            end
        end
    end
    return best
end

-- Urgent-only escape: consider a few clear destinations before the more
-- expensive normal emergency search. This does not relax the normal hazard
-- classification, ordinary dodge distances, or built-in manual teleports.
function H.urgentImpactEscape(threat)
    if not S.flags.lock or not H.ready() or not threat then return false end
    local now = os.clock()
    if now - (S.urgentLastMove or -math.huge) < Config.UrgentRelocateCooldown then return false end
    if not S.defenseManualInspection and (now < S.manualTeleportUntil or (S.escape and S.escape.mode == "manual")) then return false end
    local current = S.context.root.CFrame
    local home = S.escape and S.escape.home or S.lockTarget or current
    local orientation = current - current.Position
    local away, side = H.escapeDirections(threat, current)
    local height = S.escape and 26 or Config.EmergencyHeight
    local rise = Vector3.new(0, height, 0)
    local offsets = {rise, rise + side * 25, rise - side * 25,
        rise + away * 30, rise + away * 36 + side * 22,
        rise + away * 36 - side * 22, rise - away * 25 + side * 24,
        rise - away * 25 - side * 24}
    -- Capture the other known moving hazards once, not on each candidate.
    local known = H.hazardSnapshot()
    local checked = 0
    for _, offset in ipairs(offsets) do
        if checked >= Config.UrgentDestinationAttempts then break end
        checked = checked + 1
        local candidate = CFrame.new(current.Position + offset) * orientation
        if candidate.Position.Y <= home.Position.Y + Config.ChaseMaxHeight
            and H.finiteVector(candidate.Position)
            and H.clearSpace(candidate) then
            local unsafe = H.threatAt(threat, candidate.Position, Vector3.zero, false)
            if not unsafe then
                for _, info in ipairs(known) do
                    if info.instance ~= threat.instance and H.threatAt(info, candidate.Position, Vector3.zero, false) then
                        unsafe = true
                        break
                    end
                end
            end
            if not unsafe and H.beginEscapeMove(candidate, "emergency", home, "imminent high-speed hazard") then
                S.urgentLastMove = now
                S.lastEmergency, S.lastEscape, S.lastChaseRelocate = now, now, now
                S.escape.pursuer, S.escape.lastThreatAt = threat.instance, now
                H.logEvent("Urgent dodge", "Fast approaching " .. tostring(threat.name))
                H.notice("URGENT DODGE: rapid hazardous object", 2)
                return true
            end
        end
    end
    -- Normal emergency logic retains its broader destination search as fallback.
    S.urgentLastMove = now
    return H.emergencyEscape("fast lethal object", threat)
end

-- The urgent pass uses cheap predicted-approach math BEFORE heavy hazard metadata.
-- A newly arrived fast object can be detected without waiting for the ordinary
-- 0.14-second nearby hazard indexing pass. Ignore harmless objects moving away.
function H.urgentRawOnCourse(position, part, velocity, observerVelocity, horizon, minimumSpeed)
    observerVelocity = observerVelocity or H.protectionObserverVelocity(position)
    horizon = horizon or Config.UrgentCollisionTime
    minimumSpeed = minimumSpeed or Config.UrgentExtremeSpeed
    if not H.finiteVector(velocity) or not H.finiteVector(position) or not H.finiteVector(part.Size)
        or velocity.Magnitude < minimumSpeed then return false end
    local relative = velocity - observerVelocity
    local speedSquared = relative:Dot(relative)
    if speedSquared < 1 then return false end
    local delta = position - part.Position
    local approach = delta:Dot(relative) / speedSquared
    if approach < 0 or approach > horizon then return false end
    local miss = delta - relative * approach
    return miss.Magnitude <= part.Size.Magnitude * 0.5 + Config.HazardMargin + 4
end

-- Extra hazard query only runs when Position Lock is active. This is bounded
-- and independently throttled, so the normal panel features keep their cadence.
function H.urgentImpactProbe()
    if not S.flags.lock or not H.ready() then return false end
    local now = os.clock()
    if not S.defenseManualInspection and (now < S.manualTeleportUntil or (S.escape and S.escape.mode == "manual")) then return false end
    if now - (S.urgentLastScan or -math.huge) < Config.UrgentScanInterval then return false end
    S.urgentLastScan = now
    local position = S.context.root.Position
    local observer = H.protectionObserverVelocity(position)
    local imminent, closestTime = nil, math.huge
    for _, info in ipairs(H.defenseProbeRecords()) do
                local gap = H.boxDistance(position, info.bounds, info.size) - info.radius
                local contact = gap <= Config.HazardMargin + 2 and (info.explicit or info.grabbed or info.moving)
                local jumpedNear = info.teleported and gap <= Config.UrgentTeleportProximity
                local danger, _, impact = H.threatAt(info, position, observer, true)
                if contact or jumpedNear or (danger and impact <= Config.UrgentCollisionTime) then
                    local rank = (contact or jumpedNear) and 0 or impact
                    if rank < closestTime then
                        imminent, closestTime = table.clone(info), rank
                        imminent.impactTime = rank
                    end
                end
    end
    if imminent then return H.urgentImpactEscape(imminent) end
    return false
end

-- Smart Shield 2.0: lightweight non-collidable proximity detection. It never
-- anchors/changes the shield and only asks existing dodge routines to move.
function H.smartShieldScan()
    if not S.flags.lock or not H.ready() or S.escape then return false end
    local now = os.clock()
    if now - S.shieldSenseAt < Config.ShieldSenseInterval then return false end
    S.shieldSenseAt = now
    if now < S.manualTeleportUntil and not S.defenseManualInspection then return false end
    local position = S.context.root.Position
    local observer = H.protectionObserverVelocity(position)
    local best, bestTime
    for _, info in ipairs(H.defenseProbeRecords()) do
                local danger, _, impact = H.threatAt(info, position, observer, true)
                if danger and impact <= Config.ShieldSenseImpactWindow and (not bestTime or impact < bestTime) then
                    best, bestTime = table.clone(info), impact
                    best.impactTime = impact
                end
    end
    if best then return H.escape(best, "shield forecast " .. tostring(best.name)) end
    return false
end

-- Repeated pursuit widens the search, changes its angle and checks every
-- destination against the entire sampled hazard set.
function H.emergencyEscape(reason, pursuit)
    if not S.flags.lock or not H.ready() then return false end
    local now = os.clock()
    local current = S.context.root.CFrame
    local previous = S.escape
    local already = previous and previous.mode == "emergency"
    local home = previous and previous.home or S.lockTarget or current
    if already then
        previous.earliestReturn = math.max(previous.earliestReturn, now + Config.EmergencyMinDuration)
        previous.safeSince = nil
        pursuit = pursuit or H.findSevereHazardNear(current.Position)
            or H.findHazard(current.Position)
        local urgent = pursuit and H.threatAt(pursuit, current.Position)
            and select(3, H.threatAt(pursuit, current.Position)) <= Config.UrgentImpactTime
        local cooldown = urgent and Config.UrgentRelocateCooldown or Config.EmergencyRetriggerCooldown
        if now - S.lastEmergency < cooldown then return true end
        -- A new HP drop is enough to shift, even without a named hazard.
        if not pursuit and now - S.lastDamageAt > 0.28 then return true end
    end

    local orientation = current - current.Position
    local count = (previous and previous.chaseCount or 0) + (already and 1 or 0)
    local away, side = H.escapeDirections(pursuit, current)
    local radius = pursuit and pursuit.radius or 0
    local bodyReach = pursuit and pursuit.size.Magnitude * 0.5 or 0
    local needed = radius + bodyReach + Config.HazardMargin + 24
    local step = math.min(Config.ChaseMaxHorizontalDistance * 0.6,
        math.max(36 + count * 10 + radius * 0.5, needed))
    local baseY = already and current.Position.Y or math.max(current.Position.Y, home.Position.Y) + Config.EmergencyHeight
    if pursuit then
        baseY = math.max(baseY, pursuit.bounds.Position.Y + pursuit.size.Magnitude * 0.5
            + radius + Config.HazardMargin + 12)
    end
    baseY = math.min(baseY, home.Position.Y + Config.ChaseMaxHeight)
    local base = Vector3.new(current.Position.X, baseY, current.Position.Z)
    local candidates = {CFrame.new(base) * orientation}
    local directions = {side, -side, away, -away}
    for _, diagonal in ipairs({away + side, away - side}) do
        if diagonal.Magnitude > 0.1 then table.insert(directions, diagonal.Unit) end
    end
    local target
    for _, distance in ipairs({step, math.min(Config.ChaseMaxHorizontalDistance, math.max(step * 1.8, needed + 70))}) do
        for _, direction in ipairs(directions) do
            for _, lift in ipairs({0, already and 24 or 12, already and -16 or -Config.EmergencyHeight}) do
                local position = base + direction * distance + Vector3.new(0, lift, 0)
                local flatHome = Vector3.new(position.X - home.Position.X, 0, position.Z - home.Position.Z)
                if flatHome.Magnitude <= Config.ChaseMaxHorizontalDistance
                    and position.Y <= home.Position.Y + Config.ChaseMaxHeight then
                    table.insert(candidates, CFrame.new(position) * orientation)
                end
            end
        end
        target = H.selectEscapeTarget(candidates)
        if target then break end
    end
    if target and (target.Position - current.Position).Magnitude > 3
        and H.beginEscapeMove(target, "emergency", home, reason) then
        S.escape.chaseCount, S.escape.pursuer = count, pursuit and pursuit.instance
        S.escape.lastThreatAt = now
        S.escape.earliestReturn = now + Config.EmergencyMinDuration
        S.lastEmergency, S.lastEscape, S.lastChaseRelocate = now, now, now
        H.logEvent("Emergency escape", tostring(reason) .. " | relocations=" .. tostring(count))
        H.notice(already and "EMERGENCY: changed direction to evade pursuit"
            or "EMERGENCY: moved to a clear escape position", 3)
        return true
    end
    if already then
        previous.safeSince = nil
        H.notice("Chase detected; no clear alternative escape point", 3)
    else
        H.notice("Emergency move blocked by local geometry", 3)
    end
    return false
end

function H.isSevereThreat(info, position)
    if not info then return false end
    local distance = H.boxDistance(position, info.bounds, info.size)
    local reach = Config.EmergencyGuardRadius + math.min(info.radius, Config.EmergencyProactiveRadiusCap)
    local observer = H.protectionObserverVelocity(position)
    local danger = H.threatAt(info, position, observer)
    local approaching = (info.velocity - observer):Dot(position - info.bounds.Position) > 0
    local contact = distance - info.radius <= Config.HazardMargin + 4
    if distance > reach and not danger then return false end
    if not danger and not contact and not approaching then return false end
    return (info.grabbed and (danger or contact))
        or (info.moving and info.velocity.Magnitude >= Config.EmergencyFastThreatSpeed
            and (danger or (distance <= reach and approaching)))
        or (info.spinning and (danger or contact))
        or ((info.erratic or info.teleported) and (danger or contact or approaching))
        or (os.clock() - S.lastDamageAt < 0.8 and info.explicit and (danger or contact))
end

-- Fast preliminary screening does not require the threat to already be on a
-- collision course. Grabs, violent motion and sudden reversals can precede hits.
function H.findSevereHazardNear(position)
    local closest, bestDistance = nil, math.huge
    for _, info in ipairs(H.hazardSnapshot()) do
        if info and H.isSevereThreat(info, position) then
            local distance = H.boxDistance(position, info.bounds, info.size)
            if distance < bestDistance then
                closest, bestDistance = info, distance
            end
        end
    end
    return closest
end

function H.findChaseThreat(position)
    local observer = H.protectionObserverVelocity(position)
    local impact = H.findHazard(position, observer)
    if impact then return impact end
    local best, bestDistance = nil, math.huge
    for _, info in ipairs(H.hazardSnapshot()) do
        local distance = H.boxDistance(position, info.bounds, info.size) - info.radius
        local approaching = (info.velocity - observer):Dot(position - info.bounds.Position) > 0
        local contact = distance <= Config.HazardMargin + 4
        local abnormal = info.grabbed or info.spinning or info.erratic or info.teleported
        local pausedPursuer = not info.moving and info.recentlyMoved
            and S.escape and S.escape.pursuer == info.instance
        if distance <= Config.ChaseGuardRadius and distance < bestDistance
            and ((approaching and (info.moving or abnormal)) or (contact and abnormal) or pausedPursuer) then
            best, bestDistance = table.clone(info), distance
            best.distance = distance
        end
    end
    return best
end

function H.nearHazard(position, radius)
    local closest, bestDistance = nil, math.huge
    for _, info in ipairs(H.hazardSnapshot()) do
        if info then
            -- Do not allow static name-only scenery to pin the player in the sky.
            if info.explicit or info.moving or info.grabbed then
                local distance = H.boxDistance(position, info.bounds, info.size)
                if distance <= radius + info.radius and distance < bestDistance then
                    closest, bestDistance = info, distance
                end
            end
        end
    end
    return closest
end

function H.recordContact(info)
    if not info then return false end
    local now = os.clock()
    local key = info.instance
    local last = S.impactEntries[key]
    if not last or now - last.last > 3.5 then
        S.impactEntries[key] = {last = now, first = now, countedAt = now, count = 1}
        return false
    end
    -- Continuous pressure is also a persistent encounter. Use a separate
    -- counting timestamp; refreshing last every frame previously prevented it.
    if now - (last.countedAt or last.first) >= 0.55 then
        last.count, last.countedAt = last.count + 1, now
    end
    last.last = now
    return last.count >= 3
end

function H.escape(hazard, reason)
    if not hazard or not S.flags.lock or not H.ready()
        or (S.escape and S.escape.mode == "emergency")
        or (os.clock() - S.lastEscape < Config.EscapeCooldown
            and (hazard.impactTime or math.huge) > Config.UrgentImpactTime) then return false end
    local ctx = S.context
    local home = S.escape and S.escape.home or S.lockTarget or ctx.root.CFrame
    local origin = ctx.root.CFrame
    local away, side = H.escapeDirections(hazard, origin)
    local offsets = {side * 12, -side * 12, away * 14,
        side * 20, -side * 20, away * 24,
        Vector3.new(0, Config.EscapeHeight, 0),
        side * 14 + Vector3.new(0, 8, 0),
        -side * 14 + Vector3.new(0, 8, 0)}
    local candidates = {}
    for _, offset in ipairs(offsets) do
        if offset.Magnitude <= Config.MaxEscapeDistance then
            table.insert(candidates, origin + offset)
        end
    end
    local count = S.escape and (S.escape.chaseCount or 0) or 0
    local target = H.selectEscapeTarget(candidates)
    if target and H.beginEscapeMove(target, "dodge", home, reason) then
        S.escape.chaseCount, S.escape.pursuer = count, hazard.instance
        S.escape.lastThreatAt = os.clock()
        S.lastEscape, S.lastChaseRelocate = os.clock(), os.clock()
        H.logEvent("Dodge", tostring(reason))
        H.notice("Dodged " .. tostring(reason) .. "; tracking pursuit", 3)
        return true
    end
    H.notice("Danger detected; no clear small dodge destination", 3)
    return false
end

function H.destroyShield()
    if S.ui.shield and S.ui.shield.Parent then S.ui.shield:Destroy() end
    S.ui.shield = nil
    if S.ui.forceField and S.ui.forceField.Parent then S.ui.forceField:Destroy() end
    S.ui.forceField = nil
end

function H.ensureShield()
    H.destroyShield()
end

-- Temporarily release collision/anchor leases while preserving the ON toggle.
-- A local AlignPosition holds the actual unanchored rig at the escape position,
-- rather than continuing to pin body limbs to the original lock point.
function H.stopEscapeHold()
    local hold = S.escapeHold
    S.escapeHold = nil
    if hold then
        if hold.position then hold.position:Destroy() end
        if hold.orientation then hold.orientation:Destroy() end
        if hold.attachment then hold.attachment:Destroy() end
    end
end

function H.suspendLock()
    if not S.flags.lock then return end
    if not S.lockSuspended then
        H.resetLockWalking()
        H.release("lock")
        H.destroyShield() -- local solid shell would fight movement while teleporting
        S.lockSuspended = true
        S.lockMaintenanceAt = -math.huge
    end
end

function H.ensureEscapeHold(target)
    if not H.ready() or typeof(target) ~= "CFrame" or not H.finiteVector(target.Position) then return false end
    local root = S.context.root
    local hold = S.escapeHold
    if not hold or not hold.attachment or hold.attachment.Parent ~= root
        or not hold.position or hold.position.Parent ~= root
        or not hold.orientation or hold.orientation.Parent ~= root
        or hold.position.Attachment0 ~= hold.attachment or hold.orientation.Attachment0 ~= hold.attachment
        or hold.position.Enabled == false or hold.orientation.Enabled == false then
        H.stopEscapeHold()
        local attachment, position, orientation
        local ok, message = pcall(function()
            attachment = Instance.new("Attachment")
            attachment.Name, attachment.Parent = "GR33D_EscapeAttachment", root
            position = Instance.new("AlignPosition")
            position.Name = "GR33D_EscapePosition"
            position.Mode = Enum.PositionAlignmentMode.OneAttachment
            position.Attachment0 = attachment
            position.ApplyAtCenterOfMass = true
            position.MaxForce = math.max(160000, root.AssemblyMass * (Workspace.Gravity * 18 + 1200))
            position.MaxVelocity = Config.EscapeHoldMaxVelocity
            position.Responsiveness = Config.EscapeHoldResponsiveness
            position.Position = target.Position
            position.Parent = root
            orientation = Instance.new("AlignOrientation")
            orientation.Name = "GR33D_EscapeOrientation"
            orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
            orientation.Attachment0 = attachment
            orientation.MaxTorque = math.max(120000, root.AssemblyMass * 150000)
            orientation.MaxAngularVelocity = 45
            orientation.Responsiveness = 85
            orientation.CFrame = target - target.Position
            orientation.Parent = root
        end)
        if not ok then
            if orientation then orientation:Destroy() end
            if position then position:Destroy() end
            if attachment then attachment:Destroy() end
            H.report("Escape stabilization", message)
            return false
        end
        hold = {attachment = attachment, position = position, orientation = orientation}
        S.escapeHold = hold
    end
    hold.position.Position = target.Position
    hold.orientation.CFrame = target - target.Position
    return true
end

function H.beginEscapeMove(target, mode, home, reason)
    if mode ~= "manual" and S.manualMove then H.cancelManualMovement(nil,true) end
    if not S.flags.lock or not H.ready() then return false end
    local prior = S.escape
    local wasSuspended = S.lockSuspended
    local oldTarget = S.lockTarget
    local origin = S.context.root.CFrame
    H.releaseIdle(true)
    H.releaseFlingHold(Config.IdleInputGrace)
    S.flingSnapshot = nil
    local ok, held = pcall(function()
        H.suspendLock() -- release anchors BEFORE moving the model
        if not H.moveRoot(target) then return false end
        H.zeroRigVelocity()
        return H.ensureEscapeHold(target)
    end)
    if not ok or held ~= true then
        H.notice("Escape hold unavailable; resuming protection", 5)
        H.stopEscapeHold()
        S.lockTarget = oldTarget or origin
        pcall(H.moveRoot, S.lockTarget)
        if wasSuspended and oldTarget then
            local restored, result = pcall(H.ensureEscapeHold, oldTarget)
            if restored and result then
                S.lockSuspended = true
                return false
            end
        end
        -- If even the previous hold cannot be recovered, do not strand the
        -- character in a temporary unlocked state with no active stabilizer.
        S.escape, S.lockSuspended = nil, false
        local restored, message = pcall(H.applyLock)
        if not restored then
            S.lockTarget = S.context.root.CFrame
            pcall(H.zeroRigVelocity)
            H.report("Escape rollback", message)
        end
        return false
    end
    local now = os.clock()
    S.lockTarget = target
    S.escape = {home = home, mode = mode, reason = reason,
        earliestReturn = now + (mode == "emergency" and Config.EmergencyMinDuration
            or mode == "manual" and Config.ManualRearmDelay or Config.EscapeMinDuration),
        safeSince = nil,
        chaseCount = prior and prior.chaseCount or 0,
        pursuer = prior and prior.pursuer,
        lastThreatAt = prior and prior.lastThreatAt or -math.huge}
    if mode == "manual" then S.escapeHistory = {} end
    table.insert(S.escapeHistory, {position = origin.Position, time = now})
    table.insert(S.escapeHistory, {position = target.Position, time = now})
    while #S.escapeHistory > Config.ChaseHistorySize do table.remove(S.escapeHistory, 1) end
    return true
end

function H.rearmLockAt(target)
    if not H.ready() or not S.flags.lock then return false end
    H.stopEscapeHold()
    local ok, moved = pcall(H.moveRoot, target)
    if not ok or not moved then
        local restored, held = pcall(H.ensureEscapeHold, S.lockTarget)
        if not restored or not held then
            -- If movement and hold recreation both fail, pin the current pose
            -- instead of leaving an airborne rig with no supporting constraint.
            H.stopEscapeHold()
            S.lockTarget = S.context.root.CFrame
            S.escape, S.lockSuspended = nil, false
            local locked, message = pcall(H.applyLock)
            if not locked then
                pcall(H.zeroRigVelocity)
                H.report("Protection restore", message)
            end
            H.notice("Return move failed; mobile protection resumed", 4)
        end
        return false
    end
    S.lockTarget, S.escape, S.lockSuspended = target, nil, false
    S.lockMaintenanceAt = -math.huge
    H.applyLock()
    return true
end

function H.updateEscapeHold()
    if not S.escape or not H.ready() then return end
    H.steerEscapeHold()
    H.suspendLock()
    local target = S.lockTarget
    local ok, held = pcall(H.ensureEscapeHold, target)
    if not ok or held ~= true then
        H.notice("Escape stabilizer unavailable; check Output", 4)
        return
    end
    -- If another local controller displaced the rig, try one correction.
    -- Server-owned displacement cannot be overridden with a LocalScript.
    local now = os.clock()
    if (S.context.root.Position - target.Position).Magnitude > Config.EscapeDriftCorrection
        and now - (S.lastEscapeDriftCorrection or -math.huge) > 0.3 then
        S.lastEscapeDriftCorrection = now
        H.moveRoot(target)
        H.zeroRigVelocity()
    end
end

function H.stopLock(tryLanding)
    -- Turning OFF must cancel the temporary hold before dropping the player.
    local landing = nil
    if tryLanding and S.escape and H.ready() then
        landing = H.safeDestination(S.escape.home) and S.escape.home
            or H.landingAt(S.context.root.CFrame)
        if not landing then H.notice("Protection off; no safe landing found", 5) end
    end
    H.stopEscapeHold()
    if landing then H.moveRoot(landing) end
    S.lockSuspended = false
    S.lockTarget, S.escape = nil, nil
    H.resetLockWalking()
    S.defenseMotion, S.defenseMotionSlots, S.defenseHazardRecords = nil, nil, nil
    S.defenseHazardCursor, S.defenseQueries, S.defenseDetection = nil, nil, nil
    S.defenseInfoCache, S.defenseInfoSlots, S.defenseSnapshotCache = nil, nil, nil
    S.defenseProbeAt, S.defenseProbeRecords, S.defenseSnapshotAt = nil, nil, nil
    H.destroyShield()
    H.release("lock")
    S.threatSignatures, S.shieldSenseOverlap = {}, nil
end

local BODY_PART_NAMES = {
    HumanoidRootPart = true, Head = true, Torso = true,
    UpperTorso = true, LowerTorso = true,
    LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
    RightUpperArm = true, RightLowerArm = true, RightHand = true,
    LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
    RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
    ["Left Arm"] = true, ["Right Arm"] = true,
    ["Left Leg"] = true, ["Right Leg"] = true,
}

local FLING_STATES = {
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.PlatformStanding,
}

function H.zeroRigVelocity()
    if not S.context then return end
    for _, part in ipairs(S.context.character:GetChildren()) do
        if part:IsA("BasePart") and BODY_PART_NAMES[part.Name] then
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

function H.recoverRagdoll()
    if not H.ready() or not (S.flags.fling or S.flags.lock) then return end
    if (S.flying or S.hovering) and not S.flags.lock then return end
    local humanoid = S.context.humanoid
    if S.flags.fling then
        for _, state in ipairs(FLING_STATES) do H.claimState(humanoid, state, false, "fling") end
    end
    if S.flags.lock then
        for _, state in ipairs(FLING_STATES) do H.claimState(humanoid, state, false, "lock") end
    end
    if humanoid.PlatformStand then humanoid.PlatformStand = false end
    if humanoid.Sit then humanoid.Sit = false end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.PlatformStanding then
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

function H.defenseControllerEvidence(part)
    if not part or not part:IsA("BasePart") then return false end
    for _, className in ipairs({"BodyPosition", "AlignPosition", "BodyVelocity", "LinearVelocity"}) do
        if part:FindFirstChildOfClass(className) then return true end
    end
    return false
end

function H.lockWalkIntent(ctx)
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local input = H.inputMoveVector()
    local synthetic = S.afkPulseUntil ~= nil or os.clock() < S.afkPostPulseUntil
    if synthetic and not (input and input.Magnitude > 0.06) then return Vector3.zero end
    local direction = H.skywalkDirection()
    if not H.finiteVector(direction) then return Vector3.zero end
    direction = Vector3.new(direction.X, 0, direction.Z)
    return direction.Magnitude > 1 and direction.Unit or direction
end

function H.lockWalkSpeed(ctx)
    local speed = H.nativeWalkSpeed(ctx)
    if S.flags.run and H.finite(S.runAppliedSpeed) then speed = math.max(speed, S.runAppliedSpeed) end
    if os.clock() <= (S.runAuthorizedUntil or -math.huge) and H.finite(S.runAuthorizedSpeed) then
        speed = math.max(speed, S.runAuthorizedSpeed)
    end
    return math.clamp(speed, 0, Config.MaxRunSpeed)
end

function H.protectionObserverVelocity(position)
    if S.escape or S.manualMove or not H.ready() then return Vector3.zero end
    if position and (position - S.context.root.Position).Magnitude > 2 then return Vector3.zero end
    local velocity = S.lockWalkVelocity
    return H.finiteVector(velocity) and velocity or Vector3.zero
end

function H.updateLockWalking(deltaTime)
    if not S.flags.lock or not H.ready() or S.escape or S.lockSuspended or S.manualMove
        or S.mover or S.flying or S.hovering then
        S.lockWalking, S.lockWalkSample, S.lockWalkVelocity = false, nil, Vector3.zero
        return false
    end
    local ctx, now = S.context, os.clock()
    if S.flags.afk and S.idleTarget then
        S.lockTarget = S.idleTarget
        S.lockWalking, S.lockWalkSample, S.lockWalkVelocity = false, nil, Vector3.zero
        return false
    end
    local root, previous = ctx.root, S.lockWalkSample
    local direction = H.lockWalkIntent(ctx)
    local moving = direction.Magnitude > 0.06
    local duration = previous and now - previous.at or deltaTime or 1 / 60
    local speed = H.lockWalkSpeed(ctx)
    local velocity, angular = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
    local valid = H.finiteVector(root.Position) and H.finiteVector(velocity) and H.finiteVector(angular)
    if not valid then
        H.zeroRigVelocity()
        S.lockWalking, S.lockWalkSample, S.lockWalkVelocity = false, nil, Vector3.zero
        return false
    end
    local seated = ctx.humanoid.Sit or ctx.humanoid.SeatPart ~= nil
    local recent = previous and previous.root == root and H.finite(duration) and duration > 0 and duration <= 0.25
    local correction = false
    if valid and recent and not seated and not root.Anchored
        and now >= (S.manualTeleportUntil or -math.huge)
        and now >= (S.runExternalCorrectionUntil or -math.huge) then
        local displacement = root.Position - previous.pose.Position
        local horizontal = Vector3.new(displacement.X, 0, displacement.Z).Magnitude
        local previousVelocity = previous.velocity
        local previousSpeed = Vector3.new(previousVelocity.X, 0, previousVelocity.Z).Magnitude
        local expected = math.max(speed, math.min(previousSpeed, Config.FlingLinearThreshold))
        local horizontalBudget = math.max(Config.DefenseDisplacementDistance, expected * duration * 2 + 7)
        local jumpPower = now <= (S.jumpAuthorizedUntil or -math.huge) and (S.jumpAuthorizedPower or 0) or 0
        local verticalSpeed = math.max(math.abs(previousVelocity.Y), jumpPower, math.min(math.abs(velocity.Y), 100))
        local verticalBudget = math.max(Config.DefenseVerticalDistance, verticalSpeed * duration * 2 + 8)
        correction = horizontal > horizontalBudget or math.abs(displacement.Y) > verticalBudget
        local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        local impulse = horizontalSpeed > math.max(Config.FlingLinearThreshold, speed + 40)
            or angular.Magnitude > Config.FlingAngularThreshold
            or (velocity.Y > math.max(Config.FlingLinearThreshold, jumpPower + 35)
                and velocity.Y - previousVelocity.Y > Config.FlingImpulseDeltaThreshold)
        if impulse then H.zeroRigVelocity(); velocity = Vector3.zero end
    end
    if correction and now - (S.lockWalkRejectedAt or -math.huge) >= Config.DefenseCorrectionCooldown then
        H.zeroRigVelocity()
        H.recoverRagdoll()
        H.moveRoot(previous.pose)
        velocity = Vector3.zero
        S.lockWalkRejectedAt = now
        H.logEvent("Position guard", "Large unexplained displacement; normal movement remains enabled")
    end
    S.lockTarget = root.CFrame
    S.lockWalking = moving
    S.lockWalkVelocity = valid and velocity or Vector3.zero
    S.lockWalkSample = valid and {at = now, root = root, pose = root.CFrame, velocity = velocity} or nil
    return moving
end

function H.defensePartVelocity(part)
    if not part:IsA("BasePart") or H.ignored(part) or not H.finiteVector(part.Position) then return Vector3.zero end
    local now = os.clock()
    S.defenseMotion, S.defenseMotionSlots = S.defenseMotion or {}, S.defenseMotionSlots or {}
    local record = S.defenseMotion[part]
    local physical = H.finiteVector(part.AssemblyLinearVelocity) and part.AssemblyLinearVelocity or Vector3.zero
    if part.Anchored then physical = Vector3.zero end
    if record and now - record.at < 0.015 then
        local measured = record.velocity
        return measured and (measured.Magnitude > physical.Magnitude or measured:Dot(physical) < 0)
            and measured or physical
    end
    local measured = Vector3.zero
    if record and now - record.at <= Config.HazardMotionMaxAge then
        measured = (part.Position - record.position) / math.max(0.015, now - record.at)
        if not H.finiteVector(measured) then measured = Vector3.zero end
        if measured.Magnitude > Config.HazardMaxSampleSpeed then measured = measured.Unit * Config.HazardMaxSampleSpeed end
        if not S.motion[part] then
            S.motion[part] = {position = record.position, bounds = record.bounds, time = record.at,
                velocity = record.velocity or Vector3.zero, acceleration = Vector3.zero,
                angularSpeed = 0, reversedAt = -math.huge, teleportedAt = -math.huge}
        end
    end
    if not record then
        S.defenseMotionCursor = (S.defenseMotionCursor or 0) % Config.DefenseMotionSampleLimit + 1
        local replaced = S.defenseMotionSlots[S.defenseMotionCursor]
        if replaced then
            S.defenseMotion[replaced.instance] = nil
            if not S.hazards[replaced.instance] then S.motion[replaced.instance] = nil end
        end
        record = {instance = part}
        S.defenseMotionSlots[S.defenseMotionCursor] = record
        S.defenseMotion[part] = record
    end
    record.position, record.bounds, record.at, record.velocity = part.Position, part.CFrame, now, measured
    if part.Anchored or measured.Magnitude > physical.Magnitude
        or (measured.Magnitude >= Config.ProjectileSpeedThreshold and measured:Dot(physical) < 0) then return measured end
    return physical
end

function H.defensePhysicalCourse(part, velocity)
    if not S.flags.lock or not H.ready() or not part:IsA("BasePart")
        or H.ignored(part) or not H.finiteVector(velocity) then return false end
    local controlled = H.grabEvidence(part)
    if not part.CanCollide and not controlled then return false end
    local speed = controlled and Config.ProjectileSpeedThreshold or Config.DefenseDynamicMinSpeed
    if velocity.Magnitude < speed then return false end
    return H.urgentRawOnCourse(S.context.root.Position, part, velocity,
        H.protectionObserverVelocity(), Config.PredictionSeconds, speed)
end

function H.defenseCandidateInfo(part)
    local now = os.clock()
    S.defenseInfoCache, S.defenseInfoSlots = S.defenseInfoCache or {}, S.defenseInfoSlots or {}
    local cached = S.defenseInfoCache[part]
    if cached and now - cached.at < Config.DefenseInfoInterval then return cached.info, cached.candidate end
    if not S.defenseBudgetUntil or now >= S.defenseBudgetUntil then
        S.defenseBudgetUntil = now + Config.UrgentScanInterval
        S.defenseBudgetCount, S.defenseBudgetDeadline = 0, now + Config.DefenseWorkSeconds
    end
    if S.defenseBudgetCount >= Config.DefensePartBudget or now >= S.defenseBudgetDeadline then return nil, false end
    S.defenseBudgetCount += 1
    local velocity = H.defensePartVelocity(part)
    local candidate = H.hazardCandidate(part) or H.defensePhysicalCourse(part, velocity)
    local info
    if candidate then
        local ok, sampled = pcall(H.hazardInfo, part)
        if ok then info = sampled end
        if info and not S.hazards[part] then S.hazards[part] = true end
    end
    if not cached then
        S.defenseInfoCursor = (S.defenseInfoCursor or 0) % Config.DefenseInfoLimit + 1
        local replaced = S.defenseInfoSlots[S.defenseInfoCursor]
        if replaced then S.defenseInfoCache[replaced] = nil end
        S.defenseInfoSlots[S.defenseInfoCursor] = part
    end
    S.defenseInfoCache[part] = {at = now, info = info, candidate = candidate}
    return info, candidate
end

function H.defenseQuery(origin, radius, maximum, key)
    S.defenseQueries = S.defenseQueries or {}
    local now, record = os.clock(), S.defenseQueries[key]
    local interval = key == "near" and Config.UrgentScanInterval or Config.LockLocalScanInterval
    if record and record.character == S.context.character and now - record.at < interval
        and (origin - record.origin).Magnitude < 12 then return record.parts end
    if not record then
        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        record = {overlap = overlap}
        S.defenseQueries[key] = record
    end
    local overlap = record.overlap
    overlap.MaxParts = maximum
    overlap.FilterDescendantsInstances = {S.context.character}
    record.parts = Workspace:GetPartBoundsInRadius(origin, radius, overlap)
    record.origin, record.character, record.at = origin, S.context.character, now
    return record.parts
end

function H.defenseProbeRecords()
    local now, position = os.clock(), S.context.root.Position
    if S.defenseProbeAt and now - S.defenseProbeAt < Config.UrgentScanInterval
        and S.defenseProbeOrigin and (position - S.defenseProbeOrigin).Magnitude < 12 then
        return S.defenseProbeRecords or {}
    end
    local parts = H.defenseQuery(position, Config.UrgentScanRadius, Config.UrgentScanMaxParts, "near")
    local records, count = {}, #parts
    local cursor = count > 0 and ((S.defenseProbeCursor or 1) - 1) % count + 1 or 1
    local inspected = 0
    while inspected < count do
        local part = parts[(cursor + inspected - 1) % count + 1]
        if part:IsA("BasePart") then
            local info = H.defenseCandidateInfo(part)
            if info then records[#records + 1] = info end
        end
        inspected += 1
        if (S.defenseBudgetCount or 0) >= Config.DefensePartBudget
            or (S.defenseBudgetDeadline and os.clock() >= S.defenseBudgetDeadline) then break end
    end
    S.defenseProbeCursor = count > 0 and (cursor + inspected - 1) % count + 1 or 1
    S.defenseProbeAt, S.defenseProbeOrigin, S.defenseProbeRecords = now, position, records
    return records
end

function H.resetLockWalking()
    H.release("lock_motion")
    S.lockWalking, S.lockWalkSample, S.lockWalkVelocity = false, nil, Vector3.zero
end

function H.inspectManualDefense()
    if not S.manualMove or not S.flags.lock or not H.ready() then return false end
    local original = S.manualMove
    H.sampleNearbyHazards(false)
    S.defenseManualInspection = true
    local ok, intercepted = pcall(function()
        H.urgentImpactProbe()
        if S.manualMove == original then H.smartShieldScan() end
        return S.manualMove ~= original or S.escape ~= nil
    end)
    S.defenseManualInspection = false
    if not ok then H.report("Travel defense", intercepted); return false end
    return intercepted
end

function H.steerEscapeHold()
    if not S.escape or S.escape.mode == "manual" or not H.ready() or S.mover or S.manualMove then return end
    local now = os.clock()
    local previous = S.defenseSteerAt or now - Config.DefenseEscapeSteerInterval
    if S.defenseSteerAt and now - previous < Config.DefenseEscapeSteerInterval then return end
    S.defenseSteerAt = now
    local direction = H.lockWalkIntent(S.context)
    if direction.Magnitude <= 0.06 then return end
    local duration = math.clamp(now - previous, 0, 0.2)
    local speed = math.min(36, H.lockWalkSpeed(S.context))
    local target = S.lockTarget
    if not target then return end
    local moved = CFrame.new(target.Position + direction * speed * duration) * (target - target.Position)
    local home = S.escape.home
    if home then
        local offset = moved.Position - home.Position
        if Vector3.new(offset.X, 0, offset.Z).Magnitude > Config.ChaseMaxHorizontalDistance
            or offset.Y > Config.ChaseMaxHeight then return end
    end
    if H.clearSpace(moved) and not H.findHazard(moved.Position, direction * speed, false) then
        S.lockTarget = moved
    end
end

function H.applyLock()
    if not S.flags.lock or not H.ready() or S.manualMove then return end
    if S.lockSuspended or S.escape then return end
    local now = os.clock()
    if now - (S.lockMaintenanceAt or -math.huge) >= Config.LockMaintenanceInterval then
        S.lockMaintenanceAt = now
        if not S.context.humanoid.Sit and not S.context.humanoid.SeatPart then H.recoverRagdoll() end
    end
end

function H.updateEscape()
    if not S.flags.lock or not H.ready() then return end
    if S.manualMove then H.inspectManualDefense(); return end
    local now = os.clock()
    if now - S.lastProtectionScanAt < Config.HazardScanInterval then return end
    S.lastProtectionScanAt = now
    H.sampleNearbyHazards(false)
    local position = S.context.root.Position
    local home = S.escape and S.escape.home or S.lockTarget
    -- High-wave escape takes priority over ordinary sideways/small hazard dodge.
    -- Probe both the grounded home position and current position while airborne.
    local wave = home and H.findTsunamiThreat(home.Position)
    if wave then
        S.homeThreatAt = now
        if H.escapeAboveTsunami(wave) then return end
    end
    if S.escape and S.escape.tsunamiObject then
        local object = S.escape.tsunamiObject
        local existing = object and object.Parent and H.hazardInfo(object) or nil
        if existing and existing.wave and home and H.tsunamiDanger(existing, home.Position) then
            S.homeThreatAt = now
            S.escape.safeSince = nil
            S.escape.earliestReturn = math.max(S.escape.earliestReturn, now + Config.TsunamiQuietAfterPass)
        end
    end
    local severeAtHome = home and H.findSevereHazardNear(home.Position)
    if severeAtHome then
        S.lastSevereThreatAt, S.homeThreatAt = now, now
        if not S.escape or S.escape.mode == "dodge" then
            if H.emergencyEscape(severeAtHome.name .. " abnormal movement", severeAtHome) then
                return
            end
        end
    end
    if home and S.escape and S.escape.mode == "emergency"
        and H.nearHazard(home.Position, Config.EmergencyGuardRadius) then
        S.homeThreatAt = now
    end

    local threat = H.findHazard(position)
    local pursuing = S.escape and (threat or H.findChaseThreat(position))
    if pursuing then
        S.lastChaseThreatAt = now
        S.escape.lastThreatAt = now
        S.escape.safeSince = nil
        local cooldown = (pursuing.impactTime or math.huge) <= Config.UrgentImpactTime
            and Config.UrgentRelocateCooldown or Config.ChaseRelocateCooldown
        if now - S.lastChaseRelocate >= cooldown then
            if S.escape.mode == "emergency" or S.escape.mode == "manual" then
                H.emergencyEscape("pursuing " .. pursuing.name, pursuing)
            elseif H.isSevereThreat(pursuing, position) or (S.escape.chaseCount or 0) >= 2 then
                H.emergencyEscape("pursuing " .. pursuing.name, pursuing)
            else
                local count = (S.escape.chaseCount or 0) + 1
                if H.escape(pursuing, pursuing.name) then
                    S.escape.chaseCount = count
                elseif threat then
                    H.emergencyEscape("repeated " .. pursuing.name, pursuing)
                end
            end
        end
    elseif threat then
        S.recentHazard = threat
    end

    if not S.escape and threat then
        S.recentHazard = threat
        if H.isSevereThreat(threat, position) or H.recordContact(threat) then
            S.lastSevereThreatAt = now
            H.emergencyEscape(threat.name .. " abnormal contact", threat)
        else
            if not H.escape(threat, threat.name) then H.emergencyEscape(threat.name .. " blocked small dodge", threat) end
        end
    end
    if not S.escape then return end
    if now < S.escape.earliestReturn then return end
    -- Cannot safely re-arm while a hazard is still following the airborne rig.
    local persistent = (S.escape.chaseCount or 0) >= 2
    local quiet = persistent and Config.ChaseReturnQuiet or Config.ChaseQuietWindow
    if now - math.max(S.lastChaseThreatAt, S.escape.lastThreatAt or -math.huge) < quiet then
        S.escape.safeSince = nil
        return
    end
    local safeHome = H.safeDestination(S.escape.home)
    if S.escape.mode == "emergency" or persistent then
        if H.nearHazard(S.escape.home.Position, Config.EmergencyGuardRadius) then
            S.homeThreatAt = now
            safeHome = false
        end
        if now - S.homeThreatAt < Config.EmergencyHomeDangerHold
            or now - S.lastDamageAt < Config.EmergencyReturnQuiet then
            safeHome = false
        end
    end
    if not safeHome then
        S.escape.safeSince = nil
        return
    end
    S.escape.safeSince = S.escape.safeSince or now
    local grace = persistent and Config.ChaseReturnQuiet or S.escape.mode == "emergency" and Config.EmergencyReturnQuiet
        or S.escape.mode == "manual" and Config.ManualRearmDelay
        or Config.ReturnSafeGrace
    if now - S.escape.safeSince < grace then return end
    local destination = S.escape.home
    if H.rearmLockAt(destination) then
        H.notice("Returned to safe position; protection resumed", 3)
    end
end

function H.noclip(owner, enabled)
    if not H.ready() then return end
    if not enabled then H.release(owner); return end
    for part in pairs(S.context.parts) do
        if part:IsDescendantOf(S.context.character) then H.claim(part, "CanCollide", false, owner) end
    end
end

-- Anti Trap only changes CanTouch on character body parts.
-- Never modify CanCollide or CanQuery: walls, floors and normal raycasts remain intact.
-- Seats rely on touch events, so temporarily restore CanTouch when seated
-- or while approaching a Seat/VehicleSeat.
function H.releaseTrapProperty(instance, property)
    local fields = S.properties[instance]
    local entry = fields and fields[property]
    if not entry or not entry.owners.trap then return end
    entry.owners.trap = nil
    if next(entry.owners) == nil then
        local ok, message = pcall(function() instance[property] = entry.original end)
        if not ok and instance.Parent then H.report("Anti Trap restore " .. property, message) end
        fields[property] = nil
    end
    if next(fields) == nil then S.properties[instance] = nil end
end

function H.releaseAntiTrap()
    -- Restore the original CanTouch without touching CanCollide or CanQuery.
    local instances = {}
    for instance in pairs(S.properties) do table.insert(instances, instance) end
    for _, instance in ipairs(instances) do
        H.releaseTrapProperty(instance, "CanTouch")
    end
    S.trapSeatSuspended = false
end

function H.trapNearSeat(ctx)
    local humanoid = ctx.humanoid
    if humanoid.Sit or humanoid.SeatPart ~= nil
        or humanoid:GetState() == Enum.HumanoidStateType.Seated then return true end
    local now = os.clock()
    if now - (S.trapSeatScanAt or -math.huge) < 0.12 then
        return S.trapSeatNearby == true
    end
    S.trapSeatScanAt = now
    local params = S.trapSeatParams
    if not params then
        params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        S.trapSeatParams = params
    end
    params.FilterDescendantsInstances = {ctx.character}
    local ok, nearby = pcall(function()
        return Workspace:GetPartBoundsInRadius(ctx.root.Position, 6, params)
    end)
    S.trapSeatNearby = false
    if ok then
        for _, part in ipairs(nearby) do
            if part:IsA("Seat") or part:IsA("VehicleSeat") then
                S.trapSeatNearby = true
                break
            end
        end
    end
    return S.trapSeatNearby
end

function H.applyAntiTrap()
    if not S.flags.trap or not H.ready() then return end
    local ctx = S.context
    if H.trapNearSeat(ctx) then
        if not S.trapSeatSuspended then H.releaseAntiTrap() end
        S.trapSeatSuspended = true
        return
    end
    S.trapSeatSuspended = false
    for part in pairs(ctx.parts) do
        if part.Parent == ctx.character and part:IsA("BasePart")
            and BODY_PART_NAMES[part.Name] then
            H.claim(part, "CanTouch", false, "trap")
        end
    end
end

-- Skywalk only: manually play the character's own walk animation, because
-- PlatformStand used by hover blocks normal humanoid walking animation updates.
function H.startSkywalkWalk()
    if not S.hovering or not S.mover or not H.ready() then return end
    local ctx, mover = S.context, S.mover
    local animate = ctx.character:FindFirstChild("Animate")
    local walkFolder = animate and animate:FindFirstChild("walk")
    local template = walkFolder and walkFolder:FindFirstChildWhichIsA("Animation")
    if not template then
        local runFolder = animate and animate:FindFirstChild("run")
        template = runFolder and runFolder:FindFirstChildWhichIsA("Animation")
    end
    local anim = Instance.new("Animation")
    anim.Name = "GR33D_SkywalkWalk"
    anim.AnimationId = template and template.AnimationId ~= "" and template.AnimationId
        or (ctx.humanoid.RigType == Enum.HumanoidRigType.R15
            and "rbxassetid://507777826" or "rbxassetid://180426354")
    local ok, track = pcall(function()
        local animator = ctx.humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = ctx.humanoid
        end
        return animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        anim:Destroy()
        H.report("Skywalk walk animation", track)
        return
    end
    track.Priority = Enum.AnimationPriority.Action
    track.Looped = true
    mover.walkAnimation, mover.walkTrack = anim, track
end

function H.stopMover()
    local wasHovering = S.hovering
    if S.mover then
        if S.mover.walkTrack then
            pcall(function() S.mover.walkTrack:Stop(0.12) end)
            S.mover.walkTrack:Destroy()
        end
        if S.mover.walkAnimation then S.mover.walkAnimation:Destroy() end
        S.mover.velocity:Destroy()
        if S.mover.heightHold then S.mover.heightHold:Destroy() end
        if S.mover.orientation then S.mover.orientation:Destroy() end
        S.mover.attachment:Destroy()
        S.mover = nil
    end
    H.release("mover")
    S.flying, S.hovering, S.hoverY = false, false, nil
    S.hoverStartedAt, S.hoverQuietSince = nil, nil
    if wasHovering and H.ready() and not S.context.humanoid.PlatformStand then
        H.zeroRigVelocity()
        S.context.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

function H.startMover(kind, target)
    if not H.ready() or S.flags.lock then return false end
    H.releaseIdle(true)
    H.releaseFlingHold(Config.IdleInputGrace)
    S.flingSnapshot = nil
    if S.afkPulseUntil then S.context.humanoid:Move(Vector3.zero, false) end
    S.afkPulseUntil, S.afkPostPulseUntil = nil, -math.huge
    H.stopMover()
    local ctx = S.context
    if ctx.root.Anchored then
        H.notice("Movement blocked: character is anchored", 3)
        return false
    end
    if kind == "hover" and not target then return false end
    local attachment = Instance.new("Attachment")
    attachment.Name = "GR33D_MovementAttachment"
    attachment.Parent = ctx.root
    local velocity = Instance.new("LinearVelocity")
    velocity.Name = "GR33D_MovementVelocity"
    velocity.Attachment0 = attachment
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    if kind == "hover" then
        -- Plane motor owns only X/Z; dedicated height controller owns Y.
        -- Avoids competing vertical forces and bobbing while skywalking.
        velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
        velocity.PrimaryTangentAxis = Vector3.xAxis
        velocity.SecondaryTangentAxis = Vector3.zAxis
        velocity.PlaneVelocity = Vector2.zero
    else
        velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    end
    velocity.ForceLimitsEnabled = true
    velocity.ForceLimitMode = Enum.ForceLimitMode.Magnitude
    velocity.MaxForce = kind == "flight" and Config.FlightMaxForce
        or math.max(10000, ctx.root.AssemblyMass * (Workspace.Gravity * 4 + 1000))
    velocity.VectorVelocity = Vector3.zero
    velocity.Parent = ctx.root
    S.mover = {attachment = attachment, velocity = velocity, kind = kind}
    -- Set the flags before property listeners can run anti-ragdoll recovery.
    S.flying, S.hovering = kind == "flight", kind == "hover"
    -- Reference flight leaves the Humanoid's state and normal movement control intact.
    if kind == "hover" then
        H.release("fling") -- restore PlatformStanding while our mover owns it
        H.claim(ctx.humanoid, "PlatformStand", true, "mover")
        H.claim(ctx.humanoid, "AutoRotate", false, "mover")
        H.noclip("mover", true)
        local orientation = Instance.new("AlignOrientation")
        orientation.Name = "GR33D_SkywalkOrientation"
        orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        orientation.Attachment0 = attachment
        orientation.MaxTorque = math.max(100000, ctx.root.AssemblyMass * 10000)
        orientation.MaxAngularVelocity = 30
        orientation.Responsiveness = 25
        local facing = Vector3.new(ctx.root.CFrame.LookVector.X, 0, ctx.root.CFrame.LookVector.Z)
        if facing.Magnitude < 0.001 then facing = Vector3.new(0, 0, -1) end
        orientation.CFrame = CFrame.lookAt(Vector3.zero, facing)
        orientation.Parent = ctx.root
        S.mover.orientation = orientation
        local heightHold = Instance.new("BodyPosition")
        heightHold.Name = "GR33D_SkywalkHeightHold"
        heightHold.MaxForce = Vector3.new(0, math.max(50000,
            ctx.root.AssemblyMass * Workspace.Gravity * 6), 0)
        heightHold.P, heightHold.D = 10000, 1100
        heightHold.Position = target.Position
        heightHold.Parent = ctx.root
        S.mover.heightHold = heightHold
        S.hoverY, S.hoverStartedAt = target.Position.Y, os.clock()
        if not H.moveRoot(target) then H.stopMover(); return false end
        H.zeroRigVelocity()
        H.startSkywalkWalk()
    else
        ctx.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
    return true
end

function H.endHover(land, requireLanding)
    if not S.hovering then return false end
    local target = land and H.ready() and H.npcLandingAt(S.context.root.CFrame) or nil
    -- An automatic exit must never remove support over a void or a monster.
    if requireLanding and not target then return false end
    H.stopMover()
    if target then H.moveRoot(target) end
    if H.ready() then
        H.zeroRigVelocity()
        S.context.humanoid:ChangeState(target and Enum.HumanoidStateType.GettingUp
            or Enum.HumanoidStateType.Freefall)
    end
    H.releaseFlingHold(Config.IdleInputGrace)
    S.flingSnapshot = nil
    S.lastDrop = os.clock()
    return true
end

function H.npcExcluded(instance)
    if not instance.Parent or not instance:IsDescendantOf(Workspace) then return true end
    local current = instance
    while current and current ~= Workspace do
        if current:IsA("Accessory") or current:IsA("Tool") then return true end
        if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then return true end
        if H.enemyFriendly(current) or H.enemyInactive(current) then return true end
        current = current.Parent
    end
    return false
end

function H.hostileNPC(instance)
    if H.npcExcluded(instance) then return false end
    local current, nearestModel = instance, nil
    while current and current ~= Workspace do
        if current:IsA("Model") and not nearestModel then nearestModel = current end
        if H.enemyExplicitHostile(current) then return true end
        -- The worm reference marks some monsters with AIState even while idling.
        if current:IsA("Model") and current:GetAttribute("AIState") ~= nil
            and not H.enemyFriendly(current) then return true end
        -- An owning rig's optional name hint is useful; a whole map/container's
        -- generic name must not turn every AI below it into an enemy.
        if (current == instance or current == nearestModel) and H.npcNameHint(current.Name) then return true end
        -- A folder-only segmented worm can still use its explicit worm name.
        if current:IsA("Folder") and Config.UseNPCNameHints and current.Name:lower():find("worm", 1, true) then return true end
        current = current.Parent
    end
    return false
end

function H.npcExtents(bounds, size)
    local half = size * 0.5
    local right, up, look = bounds.RightVector, bounds.UpVector, bounds.LookVector
    return Vector3.new(
        math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
        math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
        math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z)
end

function H.npcBounds(instance)
    if instance:IsA("BasePart") then return instance.CFrame, instance.Size end
    if instance:IsA("Model") then
        if not instance:FindFirstChildWhichIsA("BasePart", true) then return nil end
        return instance:GetBoundingBox()
    end
    -- Some segmented worms are stored in a Folder rather than a Model.
    local minimum, maximum
    for _, part in ipairs(instance:GetDescendants()) do
        if part:IsA("BasePart") and not H.ignored(part) then
            local half = H.npcExtents(part.CFrame, part.Size)
            local low, high = part.Position - half, part.Position + half
            if not minimum then minimum, maximum = low, high else
                minimum = Vector3.new(math.min(minimum.X, low.X), math.min(minimum.Y, low.Y), math.min(minimum.Z, low.Z))
                maximum = Vector3.new(math.max(maximum.X, high.X), math.max(maximum.Y, high.Y), math.max(maximum.Z, high.Z))
            end
        end
    end
    if minimum then return CFrame.new((minimum + maximum) * 0.5), maximum - minimum end
    return nil
end

function H.npcProximity(position)
    -- Monster-only scanning is LOCAL and ON-DEMAND; no Workspace-wide index.
    if not (S.flags.monster or S.hovering) or not S.context then
        return math.huge, math.huge, -math.huge
    end
    local overlap = S.npcOverlap
    if not overlap then
        overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.MaxParts = Config.NPCMaxLocalParts
        S.npcOverlap = overlap
    end
    overlap.FilterDescendantsInstances = {S.context.character}
    -- A narrow, uncapped query avoids missing a monster behind hundreds of map parts.
    -- This changes scan cost, NOT the 15-stud activation distance.
    local radius = S.hovering and Config.NPCScanRadius or (Config.NPCStartDistance + 2)
    overlap.MaxParts = S.hovering and Config.NPCMaxLocalParts or 0
    -- During a 15-stud hover, include nearby ground-level worm segments.
    local center = position
    if S.hovering then center = position - Vector3.new(0, Config.NPCLiftHeight * 0.5, 0) end
    local parts = Workspace:GetPartBoundsInRadius(center, radius, overlap)
    local nearest3D, nearestXZ, highestTop = math.huge, math.huge, -math.huge
    local excluded, seen, classified, excludedOwner = {}, {}, {}, {}
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and not seen[part] then
            seen[part] = true
            local owner = part:FindFirstAncestorOfClass("Model") or part.Parent
            if owner == Workspace or owner == nil then owner = part end
            local hostile = classified[owner]
            if hostile == nil then
                hostile = not H.npcExcluded(part) and H.hostileNPC(part)
                classified[owner] = hostile
            end
            if hostile then
                local bounds, size = part.CFrame, part.Size
                local half = H.npcExtents(bounds, size)
                local offset = position - bounds.Position
                local flat = Vector3.new(math.max(0, math.abs(offset.X) - half.X), 0,
                    math.max(0, math.abs(offset.Z) - half.Z)).Magnitude
                local distance = H.boxDistance(position, bounds, size)
                nearest3D = math.min(nearest3D, distance)
                nearestXZ = math.min(nearestXZ, flat)
                if flat <= Config.NPCStopDistance then
                    highestTop = math.max(highestTop, bounds.Position.Y + half.Y)
                end
                -- Ignore the actual NPC rig when raycasting to find safe ground.
                if not excludedOwner[owner] then
                    table.insert(excluded, owner)
                    excludedOwner[owner] = true
                end
            end
        end
    end
    S.npcNearbyIgnore = excluded
    return nearest3D, nearestXZ, highestTop
end

function H.npcEscapeTarget(minimumY)
    local root = S.context.root
    for _, extra in ipairs({0, 3, 7, 12, 20}) do
        local target = root.CFrame + Vector3.new(0, minimumY + extra - root.Position.Y, 0)
        -- This is a teleport: a ceiling along the old path must not block a clear
        -- destination above it. The active skywalk owns noclip for the character.
        if H.safeDestination(target) then return target end
    end
    return nil
end

function H.npcLandingAt(target)
    if not H.ready() then return nil end
    local ctx = S.context
    -- Refresh actual local monster geometry before choosing any landing spot.
    H.npcProximity(target.Position)
    local exclusions = {ctx.character}
    for _, instance in ipairs(S.npcNearbyIgnore) do table.insert(exclusions, instance) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = exclusions
    params.RespectCanCollide = true
    local orientation = target - target.Position
    local height = math.max(3, ctx.humanoid.HipHeight + ctx.root.Size.Y * 0.5 + 0.25)
    -- Try immediately beneath the character first. An edge, prop or sloped
    -- ledge must not strand Sky Walk in midair when clear ground is close by.
    local offsets = {Vector3.zero,
        Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0),
        Vector3.new(0, 0, 4), Vector3.new(0, 0, -4),
        Vector3.new(8, 0, 0), Vector3.new(-8, 0, 0),
        Vector3.new(0, 0, 8), Vector3.new(0, 0, -8)}
    for _, offset in ipairs(offsets) do
        local hit = Workspace:Raycast(target.Position + offset + Vector3.new(0, 2, 0),
            Vector3.new(0, -Config.NPCLandingDepth, 0), params)
        if hit and hit.Normal.Y >= 0.5 then
            local result = CFrame.new(hit.Position + Vector3.new(0, height, 0)) * orientation
            local distance, flat = H.npcProximity(result.Position)
            if distance > Config.NPCStartDistance and flat > Config.NPCStopDistance
                and H.safeDestination(result) then return result end
        end
    end
    return nil
end

function H.updateNPCs()
    if not S.flags.monster or not H.ready() or S.flags.lock or S.flying then return end
    local position, now = S.context.root.Position, os.clock()
    if now - S.npcLastScanAt < Config.NPCScanInterval then return end
    S.npcLastScanAt = now
    local closest3D, closestXZ, highestTop = H.npcProximity(position)
    if not S.hovering then
        if closest3D <= Config.NPCStartDistance then
            local target = H.npcEscapeTarget(math.max(position.Y + Config.NPCLiftHeight,
                highestTop + Config.NPCClearanceHeight))
            if target and H.startMover("hover", target) then
                S.lastNPCLift = now
                H.notice("Anti-Monster: teleported up; skywalk active", 3)
            elseif not target and now - S.lastNPCLift >= 2 then
                S.lastNPCLift = now
                H.notice("Anti-Monster: no clear skywalk destination", 2)
            end
        end
    elseif closestXZ <= Config.NPCStopDistance then
        -- Track the worm below without a vertical cutoff; gaining altitude does
        -- not mean the same body underneath is safe to land on.
        S.hoverQuietSince = nil
        if highestTop + Config.NPCClearanceHeight > S.hoverY
            and now - S.lastNPCLift >= Config.NPCLiftCooldown then
            local target = H.npcEscapeTarget(highestTop + Config.NPCClearanceHeight)
            if target and H.moveRoot(target) then
                S.hoverY, S.lastNPCLift = target.Position.Y, now
                if S.mover and S.mover.heightHold then S.mover.heightHold.Position = target.Position end
                H.zeroRigVelocity()
            end
        end
    else
        -- Immediately try a verified landing once the monster leaves the
        -- horizontal danger radius. Avoid a second hold/quiet countdown.
        -- Retry promptly if ground was temporarily blocked, without busy-looping raycasts.
        if now - (S.npcLastLandingAttempt or -math.huge) >= 0.06 then
            S.npcLastLandingAttempt = now
            if not H.endHover(true, true)
                and now - (S.npcLastLandingNotice or -math.huge) >= 2 then
                S.npcLastLandingNotice = now
                H.notice("Anti-Monster: waiting for clear, safe ground", 2)
            end
        end
    end
end

function H.inputMoveVector()
    if not S.controls then return nil end
    local ok, vector = pcall(function() return S.controls:GetMoveVector() end)
    if ok and typeof(vector) == "Vector3" and H.finiteVector(vector) then return vector end
    return nil
end

function H.skywalkDirection()
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local input = H.inputMoveVector()
    local camera = Workspace.CurrentCamera
    if not input then
        local function down(key) return UserInputService:IsKeyDown(key) and 1 or 0 end
        local x = math.max(down(Enum.KeyCode.D), down(Enum.KeyCode.Right))
            - math.max(down(Enum.KeyCode.A), down(Enum.KeyCode.Left))
        local z = math.max(down(Enum.KeyCode.S), down(Enum.KeyCode.Down))
            - math.max(down(Enum.KeyCode.W), down(Enum.KeyCode.Up))
        if x ~= 0 or z ~= 0 then input = Vector3.new(x, 0, z) end
    end
    if input and camera then
        local forward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
        if forward.Magnitude < 0.001 then
            local right = camera.CFrame.RightVector
            forward = Vector3.new(right.Z, 0, -right.X)
        end
        forward = forward.Unit
        local right = Vector3.new(-forward.Z, 0, forward.X)
        local direction = right * input.X - forward * input.Z
        return direction.Magnitude > 1 and direction.Unit or direction
    end
    local direction = S.context.humanoid.MoveDirection
    return Vector3.new(direction.X, 0, direction.Z)
end

function H.updateMover()
    if not S.mover or not H.ready() then return end
    local ctx = S.context
    if ctx.root.Anchored then H.stopMover(); H.notice("Movement stopped: root is anchored", 3); return end
    local direction = ctx.humanoid.MoveDirection
    if S.flying then
        -- Same steering as the reference v6.1: Camera X/Z movement is normalized;
        -- looking up/down permits climbing/descending without separate keys.
        if ctx.humanoid.FloorMaterial ~= Enum.Material.Air then
            H.stopMover()
            return
        end
        local camera = Workspace.CurrentCamera
        local input = H.inputMoveVector()
        if camera and input then
            direction = camera.CFrame.RightVector * input.X - camera.CFrame.LookVector * input.Z
        end
        direction = direction.Magnitude > 0.001 and direction.Unit * Config.FlightSpeed or Vector3.zero
    else
        H.claim(ctx.humanoid, "PlatformStand", true, "mover")
        H.noclip("mover", true)
        local speed = S.flags.run and S.runSpeed or ctx.humanoid.WalkSpeed
        direction = H.skywalkDirection()
        if direction.Magnitude > 0.01 and S.mover.orientation then
            S.mover.orientation.CFrame = CFrame.lookAt(Vector3.zero, direction)
        end
        local flat = direction.Magnitude > 1 and direction.Unit or direction
        direction = Vector3.new(flat.X * speed, 0, flat.Z * speed)
        -- Walk-cycle follows actual movement; stop moving = stop the walk cycle.
        local track = S.mover.walkTrack
        if track then
            if flat.Magnitude > 0.08 then
                if not track.IsPlaying then track:Play(0.12, 1, 1) end
                track:AdjustSpeed(math.clamp(speed * flat.Magnitude / 16, 0.6, 2.2))
            elseif track.IsPlaying then
                track:Stop(0.16)
            end
        end
        if S.mover.heightHold then
            S.mover.heightHold.Position = Vector3.new(ctx.root.Position.X, S.hoverY, ctx.root.Position.Z)
        end
        ctx.root.AssemblyAngularVelocity = Vector3.zero
    end
    if S.hovering then
        S.mover.velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z)
    else
        S.mover.velocity.VectorVelocity = direction
    end
end

-- Shield against locally simulated flings without freezing ordinary movement.
-- While truly idle on stable ground, anchor only the root assembly (not every
-- limb: anchoring all limbs splits physical assemblies and breaks animations).
function H.releaseFlingHold(grace)
    if S.flingHoldTarget then
        H.release("fling_hold")
        S.flingHoldTarget = nil
    end
    if grace and grace > 0 then
        S.flingPauseUntil = math.max(S.flingPauseUntil, os.clock() + grace)
    end
end

function H.flingMovementInput(ctx)
    local now = os.clock()
    local input = H.inputMoveVector()
    local synthetic = S.afkPulseUntil ~= nil or now < S.afkPostPulseUntil
    return now < S.flingInputUntil or (input and input.Magnitude > 0.06)
        or (not synthetic and ctx.humanoid.MoveDirection.Magnitude > 0.06)
        or ctx.humanoid.Jump == true
end

function H.flingCanOperate(ctx)
    -- Important: never fight Lock On's temporary escape, voluntary flight,
    -- hover, teleporting, or another feature's movement constraint.
    return S.flags.fling and os.clock() >= S.manualTeleportUntil
        and not S.flags.lock and not S.escape
        and not S.mover and not S.flying and not S.hovering
        and ctx.character:GetAttribute("ProtectionAllowHighVelocity") ~= true
end

function H.flingRestore(reason, fallback)
    local ctx = S.context
    if not ctx or S.flingRecovering then return end
    S.flingRecovering = true
    local ok, message = pcall(function()
        -- Cooldowns limit notices; every detected impulse is neutralized.
        H.zeroRigVelocity()
        H.recoverRagdoll()
        local now = os.clock()
        local target = fallback
        if not target and S.flingLastStableCF
            and now - S.flingLastStableAt <= Config.FlingGroundSnapshotAge then
            target = S.flingLastStableCF
        end
        if H.allowFlingPositionRestore() and target and H.finiteVector(target.Position)
            and (ctx.root.Position - target.Position).Magnitude < 38
            and H.safeDestination(target) then
            H.moveRoot(target)
        end
        if now - S.lastFlingRecovery >= 1 then
            S.lastFlingRecovery = now
            H.logEvent("Anti-fling", tostring(reason) .. " | local recovery attempted")
            H.notice("Anti-Fling: " .. tostring(reason) .. " corrected locally", 2)
        end
    end)
    S.flingSnapshot = nil
    S.flingRecovering = false
    if not ok then H.report("Anti-Fling recovery", message) end
end

-- Only the panel's own teleport buttons authorize a position jump.
-- Unsolicited external/server displacement cannot rebase the saved lock.
function H.markOwnTeleport(target)
    local now = os.clock()
    S.manualTeleportUntil = now + Config.ManualTeleportGrace
    S.manualTeleportLastTarget = target
    S.flingSnapshot = nil
    S.flingLastStableCF = target
    S.flingLastStableAt = now
    H.releaseFlingHold(Config.ManualTeleportGrace)
    H.releaseIdle(true)
    S.idleBlockedUntil = math.max(S.idleBlockedUntil, S.manualTeleportUntil)
end

function H.updateFling(phase, deltaTime)
    if not H.ready() or not (S.flags.fling or S.flags.lock) then
        H.releaseFlingHold()
        return
    end
    local ctx = S.context
    local humanoid, root = ctx.humanoid, ctx.root
    -- Capture the forced state BEFORE recovery changes it to GettingUp;
    -- otherwise the high-priority position correction can be skipped.
    local stateBefore = humanoid:GetState()
    local wasForced = stateBefore == Enum.HumanoidStateType.Ragdoll
        or stateBefore == Enum.HumanoidStateType.Physics
        or stateBefore == Enum.HumanoidStateType.FallingDown
        or stateBefore == Enum.HumanoidStateType.PlatformStanding
        or humanoid.PlatformStand or humanoid.Sit
    H.recoverRagdoll()
    if not H.flingCanOperate(ctx) then
        H.releaseFlingHold()
        S.flingSnapshot = nil
        return
    end

    local now = os.clock()
    local state = humanoid:GetState()
    local forcedState = wasForced or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.PlatformStanding
        or humanoid.PlatformStand or humanoid.Sit
    local hasInput = H.flingMovementInput(ctx)
    local grounded, movingPlatform = H.idleGroundInfo(ctx)
    local canHold = now >= S.flingPauseUntil and not hasInput
        and not forcedState and grounded and not movingPlatform
        and not S.flags.noclip and not S.flying and not S.hovering
        and state ~= Enum.HumanoidStateType.Jumping
        and state ~= Enum.HumanoidStateType.Climbing
        and state ~= Enum.HumanoidStateType.Swimming
        and state ~= Enum.HumanoidStateType.Seated
        and not (S.flags.afk and S.idleTarget) -- AFK Streak owns that hold

    if S.flingHoldTarget then
        if not canHold then
            H.releaseFlingHold(hasInput and Config.FlingInputReleaseGrace or nil)
        else
            -- Keep the same exact place even during light repeated contact.
            H.claim(root, "Anchored", true, "fling_hold")
            if (root.Position - S.flingHoldTarget.Position).Magnitude > 0.08 then
                H.moveRoot(S.flingHoldTarget)
            end
            H.zeroRigVelocity()
            S.flingSnapshot = nil
            return
        end
    end

    local linear, angular = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
    local finite = H.finiteVector(linear) and H.finiteVector(angular)
    local bad = not finite
    if finite then
        if not H.flingVelocityAllowed(linear, ctx) or angular.Magnitude > Config.FlingAngularThreshold then
            bad = true
        end
    end
    -- Check parts as well as the root: constraints can transfer a fling through
    -- the limbs while the root still reports an ordinary velocity.
    if not bad then
        for _, part in ipairs(ctx.character:GetChildren()) do
            if part:IsA("BasePart") and BODY_PART_NAMES[part.Name] then
                local v, w = part.AssemblyLinearVelocity, part.AssemblyAngularVelocity
                if not H.finiteVector(v) or not H.finiteVector(w)
                    or not H.flingVelocityAllowed(v, ctx) or w.Magnitude > Config.FlingAngularThreshold then
                    bad = true
                    break
                end
            end
        end
    end
    local previous = S.flingSnapshot
    if not bad and phase == "post" and previous and finite then
        local dt = math.clamp(deltaTime or 1 / 60, 1 / 240, 0.12)
        local velocityJump = (linear - previous.velocity).Magnitude
        -- Ignore large acceleration if controlled movement is already ongoing,
        -- but never ignore extreme spins / impulses in avatar body parts.
        local shockThreshold = hasInput and Config.FlingMovingImpulseThreshold
            or Config.FlingImpulseDeltaThreshold
        if not humanoid.Jump and velocityJump > shockThreshold
            and not H.isAuthorizedJumpImpulse(ctx, linear, previous.velocity) then
            bad = true
        elseif not H.flingDisplacementAllowed(ctx, root.Position - previous.cframe.Position,
            linear, previous.velocity, dt) then
            bad = true
        end
    end
    if bad or forcedState then
        H.flingRestore(forcedState and "ragdoll" or "unexpected impulse",
            previous and previous.cframe or nil)
        return
    end

    if phase == "pre" then
        -- The most recent pre-physics pose is our safest non-lagging recovery
        -- point. Do not copy an already violent velocity into the snapshot.
        S.flingSnapshot = {cframe = root.CFrame, velocity = linear}
        if grounded and not movingPlatform then
            S.flingLastStableCF = root.CFrame
            S.flingLastStableAt = now
        end
        -- Idle hold engages immediately once ground and low movement are
        -- verified. Releasing it happens before the next physics step.
        if canHold and not root.Anchored and finite then
            local flat = Vector3.new(linear.X, 0, linear.Z).Magnitude
            if flat <= Config.FlingStationaryMaxSpeed
                and math.abs(linear.Y) <= Config.FlingStationaryMaxVertical then
                S.flingHoldTarget = root.CFrame
                H.claim(root, "Anchored", true, "fling_hold")
                H.zeroRigVelocity()
                S.flingSnapshot = nil
            end
        end
    elseif phase == "post" then
        S.flingSnapshot = nil
    end
end

-- AFK Streak combines stable position hold with the original 18-second local
-- movement pulse. The single AFK switch owns both behaviors. Never anchor
-- when moving, jumping, flying, locked, teleporting, or on a moving platform.
function H.afkState()
    if not S.afkStats then S.afkStats={current=0,best=0,state="OFF"} end
    return S.afkStats
end

function H.afkBreak(reason)
    local stats=H.afkState()
    if stats.startedAt then stats.best=math.max(stats.best,os.clock()-stats.startedAt) end
    stats.startedAt=nil
    stats.current=0
    stats.state=reason or "WAITING"
end

function H.afkStopPulse()
    if S.afkPulseUntil and S.context and S.context.humanoid then
        local input=H.inputMoveVector()
        if not input or input.Magnitude<=0.06 then
            pcall(function() S.context.humanoid:Move(Vector3.zero,false) end)
        end
    end
    S.afkPulseUntil=nil
    S.afkPostPulseUntil=-math.huge
end

function H.afkSummary()
    local stats=H.afkState()
    local function clockText(seconds)
        seconds=math.max(0,math.floor(seconds))
        return string.format("%02d:%02d",math.floor(seconds/60),seconds%60)
    end
    return string.format("AFK %s · Best %s · %s",clockText(stats.current),clockText(stats.best),S.flags.afk and stats.state or "OFF")
end

function H.afkMeasure()
    local stats=H.afkState()
    local held=S.flags.afk and S.idleTarget and H.ready() and S.context.root.Anchored
        and S.afkHolding and not S.escape and not S.mover and not S.manualMove
        and not S.flying and not S.hovering
    if held then
        stats.startedAt=stats.startedAt or os.clock()
        stats.current=math.max(0,os.clock()-stats.startedAt)
        stats.best=math.max(stats.best,stats.current)
        stats.state=S.afkPulseUntil and "PULSE" or ((S.afkRecoveredUntil or 0)>os.clock() and "RECOVERED LOCALLY" or "HOLDING")
    else
        H.afkBreak(not S.flags.afk and "OFF" or "WAITING")
    end
end

function H.afkYieldReason(ctx, now)
    if S.escape or S.manualMove or now<S.manualTeleportUntil
        or S.mover or S.flying or S.hovering then return "MOVEMENT" end
    if ctx.character:GetAttribute("ProtectionAllowTeleport")==true
        or ctx.character:GetAttribute("ProtectionAllowHighVelocity")==true then return "GAME MOVEMENT" end
    local humanoid=ctx.humanoid
    local state=humanoid:GetState()
    if state==Enum.HumanoidStateType.Dead or humanoid.SeatPart then return "GAME MOVEMENT" end
    local input=H.inputMoveVector()
    if input and input.Magnitude>0.06 then return "INPUT" end
    local displaced=S.idleTarget and (ctx.root.Position-S.idleTarget.Position).Magnitude>1
    local synthetic=S.afkPulseUntil~=nil or now<S.afkPostPulseUntil
    if not displaced and not synthetic and humanoid.MoveDirection.Magnitude>0.06 then return "INPUT" end
    if not displaced and (humanoid.Sit or humanoid.Jump or humanoid.PlatformStand
        or state==Enum.HumanoidStateType.Jumping or state==Enum.HumanoidStateType.Climbing
        or state==Enum.HumanoidStateType.Swimming) then return "GAME MOVEMENT" end
end

function H.afkSavedSupport(ctx, now)
    local snapshot=S.afkSupport
    if snapshot and snapshot.character~=ctx.character then return false end
    if snapshot and snapshot.instance:IsA("BasePart") then
        local part=snapshot.instance
        if not part.Parent or not part.CanCollide then return false end
        local linear,angular=part.AssemblyLinearVelocity,part.AssemblyAngularVelocity
        if not H.finiteVector(linear) or not H.finiteVector(angular)
            or linear.Magnitude>Config.IdleMovingPlatformSpeed or angular.Magnitude>0.05 then return false end
        if snapshot.position and (part.Position-snapshot.position).Magnitude>0.08 then return false end
        if snapshot.frame and part.CFrame.LookVector:Dot(snapshot.frame.LookVector)<0.999 then return false end
    end
    if snapshot and now<snapshot.nextCheck then return true end
    local grounded,moving,hit=H.idleGroundInfo(ctx,S.idleTarget.Position)
    if not grounded or moving or not hit then return false end
    if snapshot and snapshot.instance~=hit.Instance then return false end
    if not snapshot then
        local part=hit.Instance
        snapshot={instance=part,character=ctx.character,
            position=part:IsA("BasePart") and part.Position or nil,
            frame=part:IsA("BasePart") and part.CFrame or nil}
        S.afkSupport=snapshot
    end
    snapshot.nextCheck=now+0.2
    return true
end

function H.afkPauseRecovery()
    local now=os.clock()
    H.afkStopPulse()
    H.releaseIdle(true)
    S.flags.afk=false
    H.afkBreak("PAUSED")
    if H.updateSwitches then H.updateSwitches() end
    if now-(S.afkLastRecoveryNotice or -math.huge)>=5 then
        S.afkLastRecoveryNotice=now
        if H.notice then H.notice("AFK paused: repeated position corrections",6,100,
            "Local hold is contested; server-controlled teleports cannot be blocked.") end
    end
end

function H.releaseIdle(grace, keepTarget)
    S.afkHolding=false
    if not keepTarget then S.afkSupport,S.afkRecovery=nil,nil;H.afkBreak() end
    H.release("idle")
    if not keepTarget then
        S.idleTarget, S.idleSince, S.idleSample = nil, nil, nil
    end
    if grace then
        S.idleBlockedUntil = os.clock() + Config.IdleInputGrace
    end
end

function H.idleGroundInfo(ctx, position)
    if not ctx or not ctx.root or not ctx.humanoid then return false,false end
    position=position or ctx.root.Position
    if not H.finiteVector(position) then return false,false end
    local params=S.idleGroundParams
    if not params then params=RaycastParams.new();S.idleGroundParams=params end
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={ctx.character}
    params.RespectCanCollide=true
    local height=math.max(3.5,ctx.humanoid.HipHeight+ctx.root.Size.Y*0.5+1.5)
    local hit=Workspace:Raycast(position,Vector3.new(0,-height,0),params)
    if not hit or hit.Normal.Y<0.45 then return false,false end
    if hit.Instance:IsA("BasePart") then
        local velocity=hit.Instance.AssemblyLinearVelocity
        local angular=hit.Instance.AssemblyAngularVelocity
        if not H.finiteVector(velocity) or not H.finiteVector(angular) then return false,false end
        return true,velocity.Magnitude>Config.IdleMovingPlatformSpeed or angular.Magnitude>0.05,hit
    end
    return true,false,hit
end

-- AFK hold rejects incidental local physics pushes and client-visible CFrame
-- displacements. It deliberately releases for user input, seats, flight,
-- Lock-On, teleport and moving platforms; server positions can still win.
function H.guardAFKPosition()
    if not S.flags.afk or not S.idleTarget or not H.ready() then return false end
    local ctx=S.context
    local now=os.clock()
    local reason=H.afkYieldReason(ctx,now)
    if reason then
        H.afkStopPulse()
        H.releaseIdle(true)
        return false
    end
    if now<S.idleBlockedUntil then return false end
    if not H.afkSavedSupport(ctx,now) then
        H.afkStopPulse()
        H.releaseIdle(true)
        return false
    end
    H.claim(ctx.root,"Anchored",true,"idle")
    S.afkHolding=true
    local actual=ctx.root.CFrame
    if (actual.Position-S.idleTarget.Position).Magnitude>Config.AFKHoldPositionTolerance
        or actual.LookVector:Dot(S.idleTarget.LookVector)<0.998 then
        local recovery=S.afkRecovery
        if not recovery then
            recovery={count=0,nextAt=-math.huge,lastAt=now}
            S.afkRecovery=recovery
        end
        if now>=recovery.nextAt then
            if recovery.count>=6 then H.afkPauseRecovery();return false end
            recovery.count+=1
            recovery.lastAt=now
            recovery.nextAt=now+0.1
            if H.moveRoot(S.idleTarget) then S.afkRecoveredUntil=now+1 end
        end
    elseif S.afkRecovery and now-S.afkRecovery.lastAt>2 then
        S.afkRecovery=nil
    end
    local linear,angular=ctx.root.AssemblyLinearVelocity,ctx.root.AssemblyAngularVelocity
    if not H.finiteVector(linear) or not H.finiteVector(angular)
        or linear.Magnitude>0.01 or angular.Magnitude>0.01 then H.zeroVelocity() end
    return true
end

function H.updateAFKHold()
    if not S.flags.afk or not H.ready() then
        if S.idleTarget or S.afkHolding or S.afkPulseUntil then
            H.afkStopPulse()
            H.releaseIdle(false)
        end
        return
    end
    local ctx,now=S.context,os.clock()
    local reason=H.afkYieldReason(ctx,now)
    if reason then
        H.afkStopPulse()
        S.afkLastPulse=now
        H.releaseIdle(true)
        return
    end
    if now<S.idleBlockedUntil then return end
    if S.idleTarget then
        if not H.guardAFKPosition() then return end
        if S.afkPulseUntil then
            if now>=S.afkPulseUntil then
                ctx.humanoid:Move(Vector3.zero,false)
                S.afkPulseUntil=nil
                S.afkPostPulseUntil=now+Config.IdleInputGrace
            else
                ctx.humanoid:Move(Vector3.new(0,0,Config.AFKMovementPulse),false)
            end
        elseif now-S.afkLastPulse>=Config.AFKPulsingInterval then
            S.afkLastPulse=now
            S.afkPulseUntil=now+Config.AFKPulsingDuration
            ctx.humanoid:Move(Vector3.new(0,0,Config.AFKMovementPulse),false)
        end
        return
    end
    local state=ctx.humanoid:GetState()
    local grounded,moving=H.idleGroundInfo(ctx)
    if not grounded or moving or state==Enum.HumanoidStateType.Freefall
        or state==Enum.HumanoidStateType.Ragdoll or state==Enum.HumanoidStateType.FallingDown
        or state==Enum.HumanoidStateType.PlatformStanding or state==Enum.HumanoidStateType.Physics then
        S.idleSample,S.idleSince=nil,nil
        return
    end
    local velocity=ctx.root.AssemblyLinearVelocity
    if not H.finiteVector(velocity) or Vector3.new(velocity.X,0,velocity.Z).Magnitude>Config.IdleMaxHorizontalSpeed
        or math.abs(velocity.Y)>Config.IdleMaxHorizontalSpeed then
        S.idleSample,S.idleSince=nil,nil
        return
    end
    local position=ctx.root.Position
    if not S.idleSample or (position-S.idleSample).Magnitude>Config.IdleSettleRadius then
        S.idleSample,S.idleSince=position,now
        return
    end
    if now-(S.idleSince or now)<Config.IdleSettleTime then return end
    S.idleTarget=ctx.root.CFrame
    S.afkSupport,S.afkRecovery=nil,nil
    S.afkLastPulse=now
    H.guardAFKPosition()
end

function H.updateAFK()
    H.updateAFKHold()
    H.afkMeasure()
end

function H.applyCollision()
    if S.flags.noclip then H.noclip("noclip", true) end
    if S.flags.trap then H.applyAntiTrap() end
end

function H.movementNumber(value, minimum, maximum, fallback)
    local number = tonumber(value)
    if not H.finite(number) then number = fallback end
    return math.clamp(number,minimum,maximum)
end

function H.manualSurface(target)
    if not H.ready() or typeof(target) ~= "CFrame" or not H.finiteVector(target.Position) then return nil end
    local landing = H.landingAt(target)
    if not landing or (landing.Position-target.Position).Magnitude > 8 then return nil end
    return H.safeDestination(landing) and landing or nil
end

function H.manualPathClear(origin, destination)
    if not H.ready() then return false end
    local displacement = destination.Position-origin.Position
    if not H.finiteVector(displacement) then return false end
    if displacement.Magnitude < 0.01 then return true end
    local ctx = S.context
    local parameters = RaycastParams.new()
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = {ctx.character}
    parameters.RespectCanCollide = true
    local size = Vector3.new(math.max(2.6,ctx.root.Size.X+0.4),
        math.max(3.8,ctx.humanoid.HipHeight+ctx.root.Size.Y+0.8),math.max(2.6,ctx.root.Size.Z+0.4))
    if Workspace:Blockcast(origin,size * 0.85,displacement,parameters) then return false end
    local samples = math.clamp(math.ceil(displacement.Magnitude/8),1,10)
    for index=1,samples do
        if not H.manualSurface(origin:Lerp(destination,index/samples)) then return false end
    end
    return true
end

function H.cancelManualMovement(reason, deferLock)
    local move = S.manualMove
    S.manualMove = nil
    S.manualTeleportUntil = -math.huge
    S.manualTeleportLastTarget = nil
    S.flingSnapshot = nil
    H.resetRunObservation()
    if move and move.context == S.context and H.ready() then
        H.releaseIdle(true)
        H.releaseFlingHold(Config.IdleInputGrace)
        if H.finiteVector(S.context.root.Position) then
            S.flingLastStableCF,S.flingLastStableAt = S.context.root.CFrame,os.clock()
        else S.flingLastStableCF=nil end
        if S.flags.lock then
            H.stopEscapeHold()
            S.escape = nil
            S.lockTarget = S.context.root.CFrame
            S.lockSuspended = deferLock == true
            S.lockMaintenanceAt = -math.huge
            if not deferLock then H.applyLock() end
        end
    end
    if reason then H.notice(reason,5) end
end

function H.finishManualMovement(move)
    if S.manualMove ~= move or move.context ~= S.context or not H.ready() then return false end
    local accepted = S.context.root.CFrame
    S.manualMove = nil
    S.manualTeleportUntil = os.clock()+0.25
    S.manualTeleportLastTarget = accepted
    S.safeRoot,S.safeTime = accepted,os.clock()
    S.flingLastStableCF,S.flingLastStableAt = accepted,os.clock()
    if S.flags.lock then
        H.stopEscapeHold()
        S.lockTarget,S.escape,S.lockSuspended = accepted,nil,false
        S.lockMaintenanceAt = -math.huge
        H.applyLock()
    end
    H.logEvent("Own teleport","Local request settled at observed position: "..move.label)
    H.notice("TP request settled: "..move.label,3)
    return true
end

function H.updateManualMovement(deltaTime)
    local move = S.manualMove
    if not move then return false end
    if not H.ready() or move.context ~= S.context then H.cancelManualMovement(nil,true);return false end
    if S.mover or S.context.humanoid.Sit or S.context.humanoid.PlatformStand then
        H.cancelManualMovement("Manual move stopped: another movement controller is active",true)
        return false
    end
    local root,now = S.context.root,os.clock()
    if not H.finiteVector(root.Position) then H.cancelManualMovement("Manual move stopped: invalid position",true);return false end
    if (root.Position-move.expected.Position).Magnitude > 6 then
        H.cancelManualMovement("Position changed externally; manual move stopped at the observed position")
        return false
    end
    if S.flags.lock and H.inspectManualDefense then
        local interrupted = H.inspectManualDefense()
        if interrupted or S.manualMove ~= move then return false end
    end
    local threat = S.flags.lock and H.findSevereHazardNear(root.Position)
    if threat then
        H.cancelManualMovement(nil,true)
        H.emergencyEscape("hazard during manual movement",threat)
        return false
    end
    if move.phase == "observe" then
        if now >= move.observeUntil then H.finishManualMovement(move);return false end
        return true
    end
    local alpha = math.clamp((now-move.started)/move.duration,0,1)
    local eased = alpha*alpha*(3-2*alpha)
    local nextTarget = move.origin:Lerp(move.target,eased)
    if not H.manualPathClear(root.CFrame,nextTarget) then
        H.cancelManualMovement("Manual move stopped: route became blocked or unsupported")
        return false
    end
    local moved = H.moveRoot(nextTarget)
    if not moved then H.cancelManualMovement("Manual move failed",true);return false end
    move.expected = nextTarget
    if alpha >= 1 then move.phase="observe";move.observeUntil=now+0.8 end
    return true
end

function H.teleport(target, label)
    if not H.ready() or typeof(target) ~= "CFrame" or not H.finiteVector(target.Position) then
        H.notice("Teleport failed: character or destination unavailable",4)
        return false
    end
    if S.escape and S.escape.mode ~= "manual" then
        H.notice("Teleport waiting: emergency defense currently owns movement",4)
        return false
    end
    H.cancelManualMovement(nil)
    local chosen
    for _, lift in ipairs(Config.ManualTeleportLiftSteps) do
        if H.finite(lift) then
            chosen = H.manualSurface(target+Vector3.new(0,lift,0))
            if chosen then break end
        end
    end
    if not chosen then H.notice("Teleport blocked: no clear supported destination",5);return false end
    local ctx = S.context
    local origin = ctx.root.CFrame
    local distance = (chosen.Position-origin.Position).Magnitude
    local smooth = distance <= 72
    if smooth and not H.manualPathClear(origin,chosen) then
        H.notice("Teleport blocked: nearby route is obstructed or unsupported",5)
        return false
    end
    local duration = smooth and math.clamp(distance/40,0.15,1.8) or 0
    local move = {context=ctx,origin=origin,target=chosen,expected=origin,started=os.clock(),duration=duration,
        label=tostring(label or "destination"),phase=smooth and "travel" or "observe"}
    local ok,message = pcall(function()
        if type(H.afkStopPulse) == "function" then H.afkStopPulse()
        elseif S.afkPulseUntil then
            local input = H.inputMoveVector()
            if not input or input.Magnitude <= 0.06 then ctx.humanoid:Move(Vector3.zero,false) end
        end
        H.stopMover()
        H.release("run")
        S.runCommandSpeed,S.runAppliedSpeed = nil,nil
        H.stopEscapeHold()
        H.suspendLock()
        H.markOwnTeleport(chosen)
        S.manualTeleportUntil = os.clock()+duration+1.2
        S.idleBlockedUntil = math.max(S.idleBlockedUntil,S.manualTeleportUntil)
        S.flingSnapshot = nil
        S.afkPulseUntil,S.afkPostPulseUntil,S.afkLastPulse = nil,-math.huge,os.clock()
        S.manualMove = move
        if not smooth then
            if not H.moveRoot(chosen) then error("relocation request failed") end
            move.expected,move.observeUntil = chosen,os.clock()+0.8
        end
    end)
    if not ok then
        H.cancelManualMovement(nil)
        H.report("Manual teleport",message)
        return false
    end
    H.notice((smooth and "Moving to " or "TP request sent: ")..move.label,3)
    return true
end

local function eligibleSpawn(inst)
    return inst and inst:IsA("SpawnLocation") and inst.Enabled
        and inst:IsDescendantOf(Workspace)
        and (inst.Neutral or inst.TeamColor == player.TeamColor)
end

function H.findJoinSpawn()
    -- RespawnLocation is an explicit server-selected spawn where available.
    if eligibleSpawn(player.RespawnLocation) then return player.RespawnLocation end
    if eligibleSpawn(S.joinSpawn) then return S.joinSpawn end
    -- For maps without RespawnLocation, use the spawn nearest to the position
    -- first observed when this panel was started, not the player's current spot.
    local origin = S.entrySpawn and S.entrySpawn.Position
        or (H.ready() and S.context.root.Position)
    if not origin then return nil end
    local closest, bestDistance
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if eligibleSpawn(inst) then
            local distance = (inst.Position - origin).Magnitude
            if not bestDistance or distance < bestDistance then
                closest, bestDistance = inst, distance
            end
        end
    end
    return closest
end

function H.spawnRootTarget(spawn)
    if not H.ready() or not eligibleSpawn(spawn) then return nil end
    local root = S.context.root
    local humanoid = S.context.humanoid
    local height = spawn.Size.Y * 0.5 + humanoid.HipHeight + root.Size.Y * 0.5 + 0.8
    return CFrame.new(spawn.Position + spawn.CFrame.UpVector * height)
        * (root.CFrame - root.Position)
end

function H.updateSwitches()
    for key, switch in pairs(S.switches) do
        local enabled = S.flags[key]
        switch.button.BackgroundColor3 = enabled and Color3.fromRGB(39, 168, 131) or Color3.fromRGB(55, 66, 83)
        switch.knob.Position = enabled and UDim2.new(1, -30, 0.5, -12) or UDim2.new(0, 6, 0.5, -12)
    end
end

Config.RunAcceleration = 90
Config.RunDeceleration = 140
Config.RunCorrectionWindow = 4
Config.RunCorrectionCount = 3
Config.RunCorrectionPause = 4
Config.RunCorrectionCapDuration = 16
Config.RunReleaseGrace = 0.8
Config.HealthTickInterval = 0.15
Config.HealthDamageDelay = 0.8
Config.HealthRatePerSecond = 8
Config.HealthFractionPerSecond = 0.08
Config.HealthMaxStep = 2
Config.MinJumpPower = 0
Config.MaxJumpPower = 200
S.jumpPower = S.jumpPower or 50

function H.resetRunObservation()
    S.runObservation = nil
    S.runCorrectionEvents = {}
end

function H.resetMovementHealth()
    H.cancelManualMovement(nil,true)
    S.jumpAppliedPower,S.jumpCycleStarted,S.jumpWasAirborne,S.jumpNextRequestAt = nil,nil,nil,nil
    S.runStatus,S.jumpStatus = nil,nil
    H.release("jump")
    H.release("run")
    H.resetRunObservation()
    S.runCommandSpeed = nil
    S.runAppliedSpeed, S.runBackoffUntil, S.runSpeedCap, S.runCapUntil = nil, nil, nil, nil
    S.runAuthorizedSpeed, S.runAuthorizedUntil, S.runExternalCorrectionUntil = nil, nil, nil
    S.jumpAuthorizedUntil, S.jumpAuthorizedPower = nil, nil
    S.healthLastTick, S.healthNextWrite, S.healthStatus = nil, nil, nil
    S.healing = false
end

function H.updateHealthRecovery(deltaTime)
    local now = os.clock()
    if not S.flags.health or not H.ready() then
        S.healthLastTick, S.healthNextWrite, S.healthStatus = nil, nil, nil
        return false
    end
    local humanoid = S.context.humanoid
    local health, maximum = humanoid.Health, humanoid.MaxHealth
    if not H.finite(health) or not H.finite(maximum) or maximum <= 0 or health <= 0 then
        return false -- A local health write must never attempt to revive a dead rig.
    end
    if health >= maximum then
        S.healthLastTick = now
        S.healthStatus = "Full health"
        return false
    end
    if now - S.lastDamageAt < Config.HealthDamageDelay then
        S.healthLastTick = now
        S.healthStatus = "Recovery waiting after damage"
        return false
    end
    if now < (S.healthNextWrite or -math.huge) then return false end
    local elapsed = math.clamp(now - (S.healthLastTick or now - Config.HealthTickInterval), 0, 0.25)
    S.healthLastTick = now
    S.healthNextWrite = now + Config.HealthTickInterval
    local rate = math.min(Config.HealthRatePerSecond, maximum * Config.HealthFractionPerSecond)
    local increment = math.min(Config.HealthMaxStep, rate * elapsed, maximum - health)
    if increment <= 0 then return false end
    S.healing = true
    local ok, message = pcall(function() humanoid.Health = math.min(maximum, health + increment) end)
    S.healing = false
    if not ok then
        S.healthNextWrite = now + 5
        S.healthStatus = "Local recovery unavailable"
        H.report("Local health recovery", message)
        return false
    end
    S.healthStatus = "Local recovery; server controls actual HP"
    return true
end

function H.noteCustomJump()
    if not S.flags.jump or not H.ready() then return end
    local humanoid,now = S.context.humanoid,os.clock()
    local state = humanoid:GetState()
    if humanoid.FloorMaterial == Enum.Material.Air or humanoid.Sit or humanoid.PlatformStand
        or state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
        or S.jumpCycleStarted or now < (S.jumpNextRequestAt or -math.huge) then return end
    local power = H.movementNumber(S.jumpPower,Config.MinJumpPower,Config.MaxJumpPower,50)
    local gravity = H.finite(Workspace.Gravity) and math.max(1,Workspace.Gravity) or 196.2
    S.jumpCycleStarted,S.jumpWasAirborne,S.jumpNextRequestAt = now,false,now+0.2
    S.jumpAuthorizedPower = power
    S.jumpAuthorizedUntil = now+math.min(8,power*2/gravity+0.75)
end

function H.applyCustomJump()
    if not S.flags.jump or not H.ready() then
        H.release("jump")
        S.jumpAppliedPower,S.jumpCycleStarted,S.jumpWasAirborne = nil,nil,nil
        S.jumpAuthorizedPower,S.jumpAuthorizedUntil = nil,nil
        return false
    end
    local humanoid,now = S.context.humanoid,os.clock()
    local fields = S.properties[humanoid]
    local powerLease = fields and fields.JumpPower
    local useLease = fields and fields.UseJumpPower
    local changedPower = S.jumpAppliedPower and powerLease and powerLease.owners.jump and humanoid.JumpPower ~= S.jumpAppliedPower
    local changedUse = S.jumpAppliedPower and useLease and useLease.owners.jump and not humanoid.UseJumpPower
    if changedPower or changedUse then
        if changedPower and H.finite(humanoid.JumpPower) then powerLease.original=humanoid.JumpPower end
        if changedUse then useLease.original=humanoid.UseJumpPower end
        H.release("jump")
        S.flags.jump = false
        S.jumpAppliedPower,S.jumpAuthorizedPower,S.jumpAuthorizedUntil = nil,nil,nil
        S.jumpStatus = "Custom jump stopped after an external setting change"
        H.updateSwitches()
        H.notice(S.jumpStatus,5)
        return false
    end
    local power = H.movementNumber(S.jumpPower,Config.MinJumpPower,Config.MaxJumpPower,50)
    S.jumpPower = power
    H.claim(humanoid,"UseJumpPower",true,"jump")
    H.claim(humanoid,"JumpPower",power,"jump")
    S.jumpAppliedPower = power
    S.jumpStatus = nil
    local state = humanoid:GetState()
    local airborne = humanoid.FloorMaterial == Enum.Material.Air
        or state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
    if airborne then S.jumpWasAirborne=true
    elseif S.jumpWasAirborne then
        S.jumpCycleStarted,S.jumpWasAirborne,S.jumpAuthorizedUntil = nil,false,nil
    elseif S.jumpCycleStarted and now-S.jumpCycleStarted > 0.45 and not humanoid.Jump then
        S.jumpCycleStarted = nil
    end
    if humanoid.Jump and not airborne then H.noteCustomJump() end
    return true
end

function H.nativeWalkSpeed(ctx)
    local fields = S.properties[ctx.humanoid]
    local lease = fields and fields.WalkSpeed
    local speed = lease and lease.owners.run and lease.original or ctx.humanoid.WalkSpeed
    return H.finite(speed) and math.max(0, speed) or 16
end

function H.effectiveRunSpeed(ctx)
    local speed = H.movementNumber(S.runSpeed,Config.MinRunSpeed,Config.MaxRunSpeed,50)
    S.runSpeed = speed
    if S.runSpeedCap and os.clock() < (S.runCapUntil or -math.huge) then
        speed = math.min(speed,math.max(H.nativeWalkSpeed(ctx),S.runSpeedCap))
    end
    return speed
end

function H.runCanOperate(ctx)
    return S.flags.run and not S.escape and not S.manualMove and not S.mover
        and not S.flying and not S.hovering and not ctx.root.Anchored
        and not ctx.humanoid.Sit and not ctx.humanoid.PlatformStand
end

function H.pauseRunCorrection(reason)
    H.release("run")
    S.flags.run = false
    S.runCommandSpeed,S.runAppliedSpeed,S.runObservation = nil,nil,nil
    S.runAuthorizedSpeed,S.runAuthorizedUntil = nil,nil
    S.runBackoffUntil,S.runExternalCorrectionUntil = os.clock()+4,os.clock()+0.8
    S.runStatus = reason
    H.releaseFlingHold(0.8)
    S.flingSnapshot = nil
    H.updateSwitches()
    H.notice(reason,5)
end

function H.observeRunCorrection(deltaTime)
    if not H.ready() or not H.runCanOperate(S.context) then
        H.release("run")
        S.runCommandSpeed,S.runAppliedSpeed = nil,nil
        H.resetRunObservation()
        return false
    end
    local ctx,now = S.context,os.clock()
    local fields = S.properties[ctx.humanoid]
    local lease = fields and fields.WalkSpeed
    if lease and lease.owners.run and S.runCommandSpeed and H.finite(ctx.humanoid.WalkSpeed)
        and math.abs(ctx.humanoid.WalkSpeed-S.runCommandSpeed)>0.5 then
        lease.original = ctx.humanoid.WalkSpeed
        H.pauseRunCorrection("Run stopped after an external speed-setting change")
        return true
    end
    local previous = S.runObservation
    S.runObservation = nil
    if not previous or previous.context ~= ctx or now-previous.time > 0.3 or now-S.lastDrop < 0.6 then return false end
    local dt = H.finite(deltaTime) and math.clamp(deltaTime,0,0.12) or 1/60
    local offset = ctx.root.Position-previous.position
    offset = Vector3.new(offset.X,0,offset.Z)
    local tolerance = math.max(8,previous.velocity.Magnitude*dt*1.5+3)
    local backwards = offset:Dot(previous.velocity) < -3*previous.velocity.Magnitude
    if not H.finiteVector(offset) or offset.Magnitude <= tolerance
        or (not backwards and offset.Magnitude <= tolerance*2) then return false end
    H.pauseRunCorrection("Run stopped after a large external position change; lower the speed before retrying")
    return true
end

function H.recordRunPosition()
    if not H.ready() or not H.runCanOperate(S.context) then S.runObservation=nil;return end
    local root = S.context.root
    local velocity = root.AssemblyLinearVelocity
    if H.finiteVector(root.Position) and H.finiteVector(velocity) then
        S.runObservation={context=S.context,time=os.clock(),position=root.Position,velocity=Vector3.new(velocity.X,0,velocity.Z)}
    else S.runObservation=nil end
end

function H.updateRun(deltaTime)
    if not H.ready() or not H.runCanOperate(S.context) or os.clock() < (S.runBackoffUntil or -math.huge) then
        H.release("run")
        S.runCommandSpeed,S.runAppliedSpeed = nil,nil
        return false
    end
    local ctx,now = S.context,os.clock()
    local direction = ctx.humanoid.MoveDirection
    if not H.finiteVector(direction) or Vector3.new(direction.X,0,direction.Z).Magnitude <= 0.01 then
        H.release("run")
        S.runCommandSpeed,S.runAppliedSpeed = nil,nil
        return false
    end
    local velocity = ctx.root.AssemblyLinearVelocity
    if not H.finiteVector(velocity) then H.release("run");return false end
    local dt = H.finite(deltaTime) and math.clamp(deltaTime,0,0.1) or 1/60
    if dt <= 0 then return false end
    local command = H.finite(S.runCommandSpeed) and S.runCommandSpeed or H.nativeWalkSpeed(ctx)
    local selected = H.effectiveRunSpeed(ctx)
    local rate = selected < command and Config.RunDeceleration or Config.RunAcceleration
    command += math.clamp(selected-command,-rate*dt,rate*dt)
    H.claim(ctx.humanoid,"WalkSpeed",command,"run")
    S.runCommandSpeed = command
    S.runAppliedSpeed = math.min(command,Vector3.new(velocity.X,0,velocity.Z).Magnitude)
    S.runAuthorizedSpeed,S.runAuthorizedUntil = S.runAppliedSpeed,now+Config.RunReleaseGrace
    S.runStatus = nil
    return true
end

function H.allowFlingPositionRestore()
    local now = os.clock()
    return now >= S.manualTeleportUntil
        and now >= (S.runExternalCorrectionUntil or -math.huge)
        and now >= (S.runBackoffUntil or -math.huge)
end

function H.authorizePhysicsVelocity()
    if not S.flingSnapshot or not H.ready() then return end
    local velocity = S.context.root.AssemblyLinearVelocity
    if H.finiteVector(velocity) then S.flingSnapshot.velocity = velocity end
end

function H.flingVelocityAllowed(velocity, ctx)
    if not H.finiteVector(velocity) then return false end
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
    local horizontalLimit = math.max(Config.FlingLinearThreshold, ctx.humanoid.WalkSpeed + 30,
        S.flags.run and (S.runAppliedSpeed or ctx.humanoid.WalkSpeed) + 30 or 0)
    if os.clock() <= (S.runAuthorizedUntil or -math.huge) then
        horizontalLimit = math.max(horizontalLimit, (S.runAuthorizedSpeed or 0) + 30)
    end
    local verticalLimit = Config.FlingLinearThreshold
    if os.clock() <= (S.jumpAuthorizedUntil or -math.huge) then
        verticalLimit = math.max(verticalLimit, (S.jumpAuthorizedPower or 0) + 30)
    end
    return horizontal <= horizontalLimit and math.abs(velocity.Y) <= verticalLimit
end

function H.isAuthorizedJumpImpulse(ctx, velocity, previousVelocity)
    if os.clock() > (S.jumpAuthorizedUntil or -math.huge)
        or not H.finiteVector(velocity) or not H.finiteVector(previousVelocity) then return false end
    local change = velocity - previousVelocity
    local horizontalChange = Vector3.new(change.X, 0, change.Z).Magnitude
    return change.Y > 0 and velocity.Y >= 0
        and velocity.Y <= (S.jumpAuthorizedPower or 0) + 8
        and horizontalChange <= Config.FlingImpulseDeltaThreshold
end

function H.flingDisplacementAllowed(ctx, displacement, velocity, previousVelocity, deltaTime)
    if not H.finiteVector(displacement) or not H.flingVelocityAllowed(velocity, ctx)
        or not H.flingVelocityAllowed(previousVelocity, ctx) then return false end
    local dt = H.finite(deltaTime) and math.clamp(deltaTime, 0, 0.12) or 1 / 60
    local horizontalSpeed = math.max(ctx.humanoid.WalkSpeed,
        Vector3.new(velocity.X, 0, velocity.Z).Magnitude,
        Vector3.new(previousVelocity.X, 0, previousVelocity.Z).Magnitude)
    local verticalSpeed = math.max(math.abs(velocity.Y), math.abs(previousVelocity.Y))
    local gravity = H.finite(Workspace.Gravity) and math.max(0, Workspace.Gravity) or 196.2
    local horizontalBudget = math.max(Config.FlingFrameDistance, horizontalSpeed * dt + 3.5)
    local verticalBudget = math.max(Config.FlingFrameDistance,
        verticalSpeed * dt + 0.5 * gravity * dt * dt + 3.5)
    -- Separate budgets permit a fast legitimate jump without also authorizing
    -- equally large horizontal teleports. Only measured authorized velocities
    -- widen them; raising the numeric speed/jump input alone does not.
    local horizontalDistance = Vector3.new(displacement.X, 0, displacement.Z).Magnitude
    return horizontalDistance <= horizontalBudget and math.abs(displacement.Y) <= verticalBudget
end


function H.shotRaycastParams(source, excluded)
    if source ~= nil and typeof(source) ~= "RaycastParams" then return nil end
    local params = RaycastParams.new()
    params.FilterType = source and source.FilterType or Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = source and table.clone(source.FilterDescendantsInstances) or {}
    if source then
        params.IgnoreWater = source.IgnoreWater
        params.CollisionGroup = source.CollisionGroup
        params.RespectCanCollide = source.RespectCanCollide
        for _, property in ipairs({"IncludeInstances", "ExcludeInstances", "BruteForceAllSlow", "Margin", "SizeGradient"}) do
            pcall(function()
                local value = source[property]
                params[property] = type(value) == "table" and table.clone(value) or value
            end)
        end
    else params.RespectCanCollide = false end
    if params.FilterType == Enum.RaycastFilterType.Exclude then
        local filters = params.FilterDescendantsInstances
        local character = S.context and S.context.character or player.Character
        if character and not table.find(filters, character) then table.insert(filters, character) end
        if excluded and not table.find(filters, excluded) then table.insert(filters, excluded) end
        params.FilterDescendantsInstances = filters
    end
    -- New runtimes allow independent include and exclude lists. Exclusion wins,
    -- so self can be excluded while retaining the gun's inclusion whitelist.
    pcall(function()
        local filters = params.ExcludeInstances
        filters = type(filters) == "table" and table.clone(filters) or {}
        local character = S.context and S.context.character or player.Character
        if character and not table.find(filters, character) then table.insert(filters, character) end
        if excluded and not table.find(filters, excluded) then table.insert(filters, excluded) end
        params.ExcludeInstances = filters
    end)
    return params
end

function H.enemyVisible(record, origin, excluded, aim, customParams, requireHit)
    local displacement = (aim and record.aimPosition or record.position) - origin
    if displacement.Magnitude < 0.01 then return not requireHit end
    local params = H.shotRaycastParams(customParams, excluded)
    if not params then return false end
    local hit = Workspace:Raycast(origin, displacement, params)
    if requireHit and not hit then return false end
    return not hit or hit.Instance == record.instance or hit.Instance:IsDescendantOf(record.instance)
end

-- Conservative enemy-player identification. Only an explicit PvP/FFA game
-- declaration, different assigned teams, or hostile markers can qualify a
-- living player. The client cannot prove a server will accept weapon damage.
function H.autoAimEnemyPlayer(record)
    local opponent = record and record.player
    local character = record and record.instance
    local humanoid = record and record.humanoid
    if not opponent or opponent == player or not character or opponent.Character ~= character
        or not humanoid or not H.finite(humanoid.Health) or humanoid.Health <= 0
        or H.combatBlocked(character, record.root, humanoid, opponent) then return false end
    for _, subject in pairs({player, player.Character, opponent, character, Workspace, game}) do
        if subject and H.combatFlag(subject, {"PvPEnabled", "PVPEnabled", "CanPvP"}, false) then return false end
    end
    if not player.Neutral and not opponent.Neutral and player.Team and opponent.Team then
        return player.Team ~= opponent.Team
    end
    if H.enemyExplicitHostile(opponent) or H.enemyExplicitHostile(character) then return true end
    for _, subject in ipairs({game, Workspace}) do
        if H.combatFlag(subject, {"PvPEnabled", "PVPEnabled", "FFA"}, true) then return true end
    end
    local localPvP = H.combatFlag(player, {"PvPEnabled", "PVPEnabled", "CanPvP"}, true)
        or (player.Character and H.combatFlag(player.Character, {"PvPEnabled", "PVPEnabled", "CanPvP"}, true))
    local enemyPvP = H.combatFlag(opponent, {"PvPEnabled", "PVPEnabled", "CanPvP"}, true)
        or H.combatFlag(character, {"PvPEnabled", "PVPEnabled", "CanPvP"}, true)
    return localPvP and enemyPvP
end

-- Auto Aim supports marked hostile NPCs AND verified enemy players.
-- Camera and bullet guidance share the same live hostile/damageable filters.
function H.autoAimHostile(record)
    if not record or not record.instance or not record.root or not record.root.Parent
        or not H.finiteVector(record.root.Position) then return false end
    return H.enemyRecord(record.instance, record.root.Position,
        {range = Config.EnemyScanRange or Config.BulletRange or 1500, allowPlayers = true}) ~= nil
end

function H.aimScreenOffset(record, camera)
    if not record or not camera or not H.finiteVector(record.aimPosition) then return nil end
    local point, onScreen = camera:WorldToViewportPoint(record.aimPosition)
    if not onScreen or not H.finiteVector(point) or point.Z <= 0 then return nil end
    local center = camera.ViewportSize * 0.5
    local offset = Vector2.new(point.X, point.Y) - center
    local radius = H.finite(Config.AimRadiusPixels) and math.max(0, Config.AimRadiusPixels) or 220
    return offset.Magnitude <= radius and offset.Magnitude or nil
end

function H.pickAimTarget(origin, camera)
    local index, now = H.combatIndexState(), os.clock()
    local deadline, inspected, sight = now + 0.0015, 0, 0
    local best, bestScore, seen = nil, nil, {}
    while inspected < math.min(#index.objects, 6) and sight < 2 and os.clock() < deadline do
        local instance = H.nextCombatCandidate(index)
        inspected += 1
        local record = H.enemyRecord(instance, origin, {range = math.max(Config.AimRange, Config.BulletRange), allowPlayers = true})
        if record and not seen[record.root] then
            seen[record.root] = true
            if S.flags.bullet then H.rememberShotCandidate(record, now) end
            if camera and record.distance <= Config.AimRange then
                local offset = H.aimScreenOffset(record, camera)
                local score = offset and offset + record.distance * 0.01
                if score and (not bestScore or score < bestScore) and sight < 2 then
                    sight += 1
                    if H.enemyVisible(record, origin, nil, true, nil, true) then best, bestScore = record, score end
                end
            end
        end
    end
    index.lastCandidateCount, index.lastSightCount = inspected, sight
    return best
end

function H.updateAim(deltaTime)
    local active = H.aimCanUpdate()
    if not active or S.aimDirty or not S.aimWatchState or not S.aimWatchState.ready
        or os.clock() - (S.aimRecordAt or -math.huge) > 0.12 then
        if not active then S.aimReleaseRequested, S.aimTarget, S.aimDirty = true, nil, true end
        return
    end
    local camera = Workspace.CurrentCamera
    local origin = camera.CFrame.Position
    local record = H.aimCheapRecord(S.aimRecord, origin)
    if not record or not H.aimScreenOffset(record, camera) then
        S.aimReleaseRequested, S.aimTarget, S.aimDirty = true, nil, true
        return
    end
    if (record.aimPosition - origin).Magnitude < 0.01 then return end
    local elapsed = H.finite(deltaTime) and math.clamp(deltaTime, 0, 0.1) or 1 / 60
    local response = H.finite(Config.AimResponse) and math.max(0, Config.AimResponse) or 18
    local alpha = 1 - math.exp(-response * elapsed)
    camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(origin, record.aimPosition), alpha)
end

function H.stopAim()
    if S.aimBound then RunService:UnbindFromRenderStep(S.aimBinding) end
    H.clearAimSelection()
    S.aimBound, S.lastAimScan = false, -math.huge
    if S.combatIndex then S.combatIndex.lastAcquire = -math.huge end
end

function H.startAim()
    H.stopAim()
    RunService:BindToRenderStep(S.aimBinding, Enum.RenderPriority.Camera.Value + 1, function(dt)
        local ok, message = pcall(H.updateAim, dt)
        if not ok then
            S.flags.aim = false
            H.stopAim()
            H.updateSwitches()
            H.report("Auto Aim", message)
        end
    end)
    S.aimBound = true
end

function H.guidanceTarget(origin, excluded, range, customParams, requireHit, allowOccluded)
    if not H.finiteVector(origin) then return nil end
    range = H.finite(range) and math.min(range, Config.BulletRange) or Config.BulletRange
    local index, now = H.combatIndexState(), os.clock()
    local best, bestDistance, inspected, sight = nil, nil, 0, 0
    local deadline, seen = now + 0.0012, {}
    local attempts = math.min(#index.shots + #index.objects, 8)
    while inspected < attempts and os.clock() < deadline do
        local candidate
        index.guidanceTurn = (index.guidanceTurn or 0) + 1
        if #index.shots > 0 and index.guidanceTurn % 2 == 0 then
            index.shotCursor = ((index.shotCursor or 0) % #index.shots) + 1
            local cached = index.shots[index.shotCursor]
            if cached and now - cached.sampledAt <= 2 then candidate = cached.instance end
        else candidate = H.nextCombatCandidate(index) end
        inspected += 1
        if candidate and not seen[candidate] then
            seen[candidate] = true
            local record = H.enemyRecord(candidate, origin, {range = range, bullet = true, allowPlayers = true})
            if record and (not bestDistance or record.distance < bestDistance) then
                if allowOccluded then best, bestDistance = record, record.distance
                elseif sight < 2 then
                    sight += 1
                    if H.enemyVisible(record, origin, excluded, false, customParams, requireHit) then
                        best, bestDistance = record, record.distance
                    end
                end
            end
        end
    end
    index.lastGuidanceCount, index.lastGuidanceSightCount = inspected, sight
    return best
end

function H.getShotAim(origin)
    if not S.flags.bullet or not H.ready() or typeof(origin) ~= "Vector3" or not H.finiteVector(origin) then return nil end
    local record = H.guidanceTarget(origin)
    if not record then return nil end
    local offset = record.position - origin
    if offset.Magnitude < 0.001 then return nil end
    return record.instance, record.position, offset.Unit
end

function H.castGuidedShot(origin, ordinaryDirection, range, sourceParams)
    if typeof(origin) ~= "Vector3" or not H.finiteVector(origin)
        or typeof(ordinaryDirection) ~= "Vector3" or not H.finiteVector(ordinaryDirection)
        or ordinaryDirection.Magnitude < 0.001 then return nil, nil, false, nil, "Expected finite origin and nonzero direction" end
    range = range or Config.BulletRange
    if not H.finite(range) or range <= 0 then return nil, nil, false, nil, "Expected positive finite shot range" end
    local params = H.shotRaycastParams(sourceParams)
    if not params then return nil, nil, false, nil, "Expected RaycastParams" end
    range = math.min(range, 15000)
    local direction, guided = ordinaryDirection.Unit, false
    if S.flags.bullet and H.ready() then
        local record = H.guidanceTarget(origin, nil, range, params, true)
        if record then
            local offset = record.position - origin
            if offset.Magnitude > 0.001 then direction, guided = offset.Unit, true end
        end
    end
    local hit = Workspace:Raycast(origin, direction * range, params)
    local enemy
    if hit and H.ready() then
        local owner = H.enemyOwner(hit.Instance)
        local record = owner and H.enemyRecord(owner, origin, {range = range, bullet = true})
        enemy = record and record.instance or nil
    end
    return hit, enemy, guided, direction
end

function H.registerShot(mode, data)
    if type(data) ~= "table" then return {accepted = false, reason = "Expected shot data"} end
    if mode == nil then mode = "Auto" end
    if type(mode) ~= "string" then return {accepted = false, reason = "Expected shot mode"} end
    mode = mode:lower()
    if mode == "auto" then mode = data.Projectile ~= nil and "projectile" or "raycast" end
    if mode == "raycast" or mode == "hitscan" then
        local hit, enemy, guided, direction, reason = H.castGuidedShot(data.Origin, data.Direction, data.Range, data.RaycastParams)
        return {mode = "Raycast", accepted = reason == nil, reason = reason,
            hit = hit, enemy = enemy, guided = guided, direction = direction}
    elseif mode == "projectile" then
        local accepted, reason = H.registerBullet(data.Projectile, data.ProjectileOptions or data)
        return {mode = "Projectile", accepted = accepted, guided = accepted, reason = reason,
            projectile = data.Projectile}
    end
    return {accepted = false, reason = "Supported shot modes: Auto, Raycast, Projectile"}
end

function H.bulletOwner(part)
    local current = part
    while current and current ~= Workspace do
        for _, attribute in ipairs({"OwnerUserId", "ShooterUserId", "CreatorUserId"}) do
            local id = current:GetAttribute(attribute)
            if id ~= nil then return tostring(id) end
        end
        for _, name in ipairs({"creator", "Creator", "Owner", "Shooter"}) do
            local value = current:FindFirstChild(name)
            if value and value:IsA("ObjectValue") and value.Value then
                if value.Value:IsA("Player") then return tostring(value.Value.UserId) end
                local owner = value.Value:IsA("Model") and Players:GetPlayerFromCharacter(value.Value)
                if owner then return tostring(owner.UserId) end
            end
        end
        if current:IsA("Model") then
            local owner = Players:GetPlayerFromCharacter(current)
            if owner then return tostring(owner.UserId) end
        end
        current = current.Parent
    end
    return nil
end

function H.bulletRigidMember(part)
    local current = part
    local depth = 0
    while current and current ~= Workspace do
        if current:IsA("Tool") or current:IsA("Accessory")
            or (current:IsA("Model") and (current:FindFirstChildOfClass("Humanoid")
                or Players:GetPlayerFromCharacter(current))) then return false end
        current = current.Parent
        depth += 1
        if depth > 64 then return false end
    end
    return current == Workspace
end

function H.bulletOwnershipEvidence(part)
    local current, declared, depth = part, false, 0
    while current and current ~= Workspace do
        for _, attribute in ipairs({"OwnerUserId", "ShooterUserId", "CreatorUserId"}) do
            local id = current:GetAttribute(attribute)
            if id ~= nil then
                if tostring(id) ~= tostring(player.UserId) then return false end
                declared = true
            end
        end
        for _, name in ipairs({"creator", "Creator", "Owner", "Shooter"}) do
            local reference = current:FindFirstChild(name)
            if reference and reference:IsA("ObjectValue") and reference.Value then
                local value = reference.Value
                local author = value:IsA("Player") and value
                    or (value:IsA("Model") and Players:GetPlayerFromCharacter(value))
                if author then
                    if author ~= player then return false end
                    declared = true
                end
            end
        end
        current = current.Parent
        depth += 1
        if depth > 64 then return false end
    end
    return true, declared
end

function H.bulletControllable(part, moveAnchored)
    if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part.Parent
        or not part:IsDescendantOf(Workspace) or not H.finiteVector(part.Position)
        or not H.finiteVector(part.AssemblyLinearVelocity) then return false end
    local evidence, declared = H.bulletOwnershipEvidence(part)
    if not evidence then return false end
    local assembly = part.AssemblyRootPart or part
    if assembly ~= part or not H.bulletRigidMember(part) then return false end
    local connectedOk, connected = pcall(function() return part:GetConnectedParts(true) end)
    if not connectedOk or #connected > 16 then return false end
    for _, member in ipairs(connected) do
        if not H.bulletRigidMember(member) or not H.bulletOwnershipEvidence(member) then return false end
    end
    if S.context and part:IsDescendantOf(S.context.character) then return false end
    if part.Anchored then return moveAnchored == true and declared, connected end
    local readable, networkOwner = pcall(function() return part:GetNetworkOwner() end)
    if readable and networkOwner ~= player then return false end
    return true, connected
end

function H.bulletVelocity(part, state, velocity)
    if not part.Anchored and H.finiteVector(velocity) then
        part.AssemblyLinearVelocity = velocity
        state.appliedVelocity = velocity
    end
end

function H.releaseGuidedBullet(part, state, keepVelocity)
    if S.guidedBullets[part] == state then S.guidedBullets[part] = nil end
    if not keepVelocity and state.appliedVelocity and H.bulletControllable(part, state.moveAnchored)
        and (part.AssemblyLinearVelocity - state.appliedVelocity).Magnitude < 0.01 then
        pcall(function() part.AssemblyLinearVelocity = state.originalVelocity end)
    end
    state.route, state.target, state.appliedVelocity = nil, nil, nil
end

function H.bulletBounds(part, members)
    if not H.finiteVector(part.Size) then return nil end
    local radius = part.Size.Magnitude * 0.5
    for _, member in ipairs(members) do
        if not H.finiteVector(member.Position) or not H.finiteVector(member.Size) then return nil end
        radius = math.max(radius, (member.Position - part.Position).Magnitude + member.Size.Magnitude * 0.5)
    end
    return H.finite(radius) and radius or nil
end

function H.registerBullet(part, options)
    if not S.flags.bullet or not H.ready() then return false, "Bullet Aim is off" end
    if options ~= nil and type(options) ~= "table" then return false, "Expected projectile options" end
    options = options or {}
    local controllable, members = H.bulletControllable(part, options.MoveAnchored == true)
    if not controllable then
        return false, "Register a standalone locally controlled projectile, not another player, rig, or tool"
    end
    if S.guidedBullets[part] then return true end
    local active = 0
    for _ in pairs(S.guidedBullets) do active += 1 end
    if active >= Config.BulletMaxActive then return false, "Local projectile guidance capacity reached" end
    local radius = H.bulletBounds(part, members)
    if not H.finite(radius) or radius <= 0 or radius > Config.BulletMaxRadius then
        return false, "Projectile bounds exceed safe swept-guidance size"
    end
    local speed = options.Speed or part.AssemblyLinearVelocity.Magnitude
    if not H.finite(speed) or speed < 1 then speed = Config.BulletSpeed end
    local lifetime = options.Lifetime or Config.BulletLifetime
    if not H.finite(lifetime) then return false, "Expected finite projectile lifetime" end
    local parameters = H.shotRaycastParams(options.RaycastParams, part)
    if not parameters then return false, "Expected projectile RaycastParams" end
    local memberLookup = {}
    for _, member in ipairs(members) do
        parameters = H.shotRaycastParams(parameters, member)
        memberLookup[member] = true
    end
    local solidParameters = RaycastParams.new()
    solidParameters.FilterType = Enum.RaycastFilterType.Exclude
    solidParameters.FilterDescendantsInstances = {S.context.character, part, table.unpack(members)}
    solidParameters.RespectCanCollide, solidParameters.CollisionGroup, solidParameters.IgnoreWater = true, part.CollisionGroup, true
    local overlap = OverlapParams.new()
    overlap.FilterType, overlap.FilterDescendantsInstances = parameters.FilterType, table.clone(parameters.FilterDescendantsInstances)
    overlap.CollisionGroup, overlap.RespectCanCollide, overlap.MaxParts = parameters.CollisionGroup, parameters.RespectCanCollide, 32
    for _, property in ipairs({"IncludeInstances", "ExcludeInstances"}) do
        pcall(function()
            local value = parameters[property]
            overlap[property] = type(value) == "table" and table.clone(value) or value
        end)
    end
    local solidOverlap = OverlapParams.new()
    solidOverlap.FilterType, solidOverlap.FilterDescendantsInstances = solidParameters.FilterType, table.clone(solidParameters.FilterDescendantsInstances)
    solidOverlap.CollisionGroup, solidOverlap.RespectCanCollide, solidOverlap.MaxParts = solidParameters.CollisionGroup, true, 32
    local state = {speed = math.clamp(speed, 1, 3000), radius = math.max(0.05, radius),
        expiresAt = os.clock() + math.clamp(lifetime, 0.05, 30),
        lastPosition = part.Position, traveled = 0, target = nil, lastScan = -math.huge,
        moveAnchored = options.MoveAnchored == true, context = S.context, parameters = parameters, overlap = overlap,
        solidParameters = solidParameters, solidOverlap = solidOverlap, members = memberLookup, memberCount = #members,
        originalVelocity = part.AssemblyLinearVelocity, lastRouteAt = -math.huge,
        destroyOnHit = options.DestroyOnHit == true,
        onHit = type(options.OnHit) == "function" and options.OnHit or nil, status = "acquiring"}
    if options.Target then
        local record = H.enemyRecord(options.Target, part.Position, {range = Config.BulletRange, bullet = true})
        if record then state.target = record.instance end
    end
    S.guidedBullets[part] = state
    return true
end

function H.tryRegisterBullet(part)
    if not S.flags.bullet or not part:IsA("BasePart") or part:GetAttribute("GR33D_GuidedBullet") ~= true then return end
    if H.bulletOwner(part) ~= tostring(player.UserId) then return end
    H.registerBullet(part)
end

function H.projectileConsumeBudget(routeQuery)
    if (S.bulletSweepBudget or 0) < 2 or (routeQuery and (S.bulletRouteBudget or 0) < 2) then return false end
    S.bulletSweepBudget -= 2
    if routeQuery then S.bulletRouteBudget -= 2 end
    return true
end

function H.projectileSweep(state, origin, displacement, routeQuery)
    if displacement.Magnitude < 0.001 then return nil, true end
    if not H.finiteVector(origin) or not H.finiteVector(displacement)
        or not H.projectileConsumeBudget(routeQuery) then return nil, false end
    local success, hit = pcall(function()
        local weaponHit = Workspace:Spherecast(origin, state.radius, displacement, state.parameters)
        local solidHit = Workspace:Spherecast(origin, state.radius, displacement, state.solidParameters)
        if solidHit and (not weaponHit or solidHit.Distance < weaponHit.Distance) then return solidHit end
        return weaponHit
    end)
    return success and hit or nil, success
end

function H.projectileTargetHit(hit, record)
    return hit and record and (hit.Instance == record.instance
        or hit.Instance:IsDescendantOf(record.instance)) or false
end

function H.projectileClearance(state, position, routeQuery)
    if not H.projectileConsumeBudget(routeQuery) then return false end
    for _, parameters in ipairs({state.overlap, state.solidOverlap}) do
        local success, parts = pcall(function()
            return Workspace:GetPartBoundsInRadius(position, state.radius, parameters)
        end)
        if not success or #parts >= parameters.MaxParts then return false end
        for _, part in ipairs(parts) do
            if not part:IsA("BasePart") then return false end
            local localPoint, half = part.CFrame:PointToObjectSpace(position), part.Size * 0.5
            local closest = Vector3.new(math.clamp(localPoint.X, -half.X, half.X),
                math.clamp(localPoint.Y, -half.Y, half.Y), math.clamp(localPoint.Z, -half.Z, half.Z))
            if (localPoint - closest).Magnitude <= state.radius + 0.01 then return false end
        end
    end
    return true
end

function H.projectileRoute(position, record, state, obstacle)
    local direct = record.position - position
    if direct.Magnitude < 0.01 or not obstacle or not obstacle.Instance:IsA("BasePart") then return nil end
    local part = obstacle.Instance
    local frame, half = part.CFrame, part.Size * 0.5
    local extents = Vector3.new(
        math.abs(frame.RightVector.X) * half.X + math.abs(frame.UpVector.X) * half.Y + math.abs(frame.LookVector.X) * half.Z,
        math.abs(frame.RightVector.Y) * half.X + math.abs(frame.UpVector.Y) * half.Y + math.abs(frame.LookVector.Y) * half.Z,
        math.abs(frame.RightVector.Z) * half.X + math.abs(frame.UpVector.Z) * half.Y + math.abs(frame.LookVector.Z) * half.Z)
    local direction = direct.Unit
    local tangent = Vector3.new(-direction.Z, 0, direction.X)
    tangent = tangent.Magnitude > 0.1 and tangent.Unit or Vector3.new(1, 0, 0)
    local depth = math.abs(direction.X) * extents.X + math.abs(direction.Y) * extents.Y + math.abs(direction.Z) * extents.Z
    local clearance = state.radius + 1.25
    local nearest, nearestLength
    for _, side in ipairs({tangent, -tangent, Vector3.new(0, 1, 0), Vector3.new(0, -1, 0)}) do
        if (S.bulletRouteBudget or 0) < 10 then break end
        local span = math.abs(side.X) * extents.X + math.abs(side.Y) * extents.Y + math.abs(side.Z) * extents.Z
        local offset = math.max(clearance, (part.Position - obstacle.Position):Dot(side) + span + clearance)
        local first = obstacle.Position + obstacle.Normal * clearance + side * offset
        local second = first + direction * (depth * 2 + clearance * 2)
        local firstLeg, secondLeg, finalLeg = first - position, second - first, record.position - second
        local length = firstLeg.Magnitude + secondLeg.Magnitude + finalLeg.Magnitude
        if firstLeg.Magnitude <= Config.BulletRouteMaxDetour
            and (second - position).Magnitude <= Config.BulletRouteMaxDetour
            and length <= direct.Magnitude + Config.BulletRouteMaxDetour * 2 then
            local clear = H.projectileClearance(state, first, true) and H.projectileClearance(state, second, true)
            local firstHit, firstOk
            if clear then firstHit, firstOk = H.projectileSweep(state, position, firstLeg, true) end
            local secondHit, secondOk
            if firstOk and not firstHit then secondHit, secondOk = H.projectileSweep(state, first, secondLeg, true) end
            local finalHit, finalOk
            if secondOk and not secondHit then finalHit, finalOk = H.projectileSweep(state, second, finalLeg, true) end
            if finalOk and (not finalHit or H.projectileTargetHit(finalHit, record))
                and (not nearestLength or length < nearestLength) then
                nearest, nearestLength = {first, second}, length
            end
        end
    end
    return nearest
end

function H.guidedHit(part, state, hit)
    H.releaseGuidedBullet(part, state, true)
    local owner = H.enemyOwner(hit.Instance)
    local current = owner and H.enemyRecord(owner, hit.Position, {range = Config.BulletRange, bullet = true})
    local target = current and current.instance or nil
    if S.weaponHooks.hit then
        local ok, message = pcall(function() S.weaponHooks.hit:Fire(part, target, hit.Position, hit.Normal) end)
        if not ok then H.report("Guided projectile event", message) end
    end
    if state.onHit then
        local ok, message = pcall(state.onHit, part, target, hit.Position, hit.Normal)
        if not ok then H.report("Guided projectile hit handler", message) end
    end
    if state.destroyOnHit and part.Parent then part:Destroy() end
end

function H.stepGuidedBullet(part, state, dt, now)
    local controllable, members = H.bulletControllable(part, state.moveAnchored)
    local changed = controllable and #members ~= state.memberCount
    if controllable and not changed then
        for _, member in ipairs(members) do if not state.members[member] then changed = true; break end end
        local radius = H.bulletBounds(part, members)
        if not radius or radius > state.radius + 0.01 then changed = true end
    end
    if state.context ~= S.context or now >= state.expiresAt or not controllable or changed then
        H.releaseGuidedBullet(part, state)
        return
    end
    local position = part.Position
    local traveled = position - state.lastPosition
    if traveled.Magnitude > math.max(12, state.speed * dt * 4 + 6) then
        H.releaseGuidedBullet(part, state, true)
        return
    end
    state.traveled += traveled.Magnitude
    if state.traveled > Config.BulletMaxTravel then H.releaseGuidedBullet(part, state); return end
    local observedHit, observedOk = H.projectileSweep(state, state.lastPosition, traveled)
    if not observedOk then state.status = "blocked"; H.bulletVelocity(part, state, Vector3.zero); return end
    if observedHit then H.guidedHit(part, state, observedHit); return end
    state.lastPosition = position
    if not H.projectileClearance(state, position) then
        state.route, state.status = nil, "blocked"
        H.bulletVelocity(part, state, Vector3.zero)
        return
    end
    local record = state.target and H.enemyRecord(state.target, position,
        {range = Config.BulletRange, bullet = true, allowPlayers = true})
    if not record then
        state.target, state.route, state.routeTarget = nil, nil, nil
        if (S.bulletAcquireBudget or 0) > 0 and now - state.lastScan >= Config.AimScanInterval then
            S.bulletAcquireBudget -= 1
            record = H.guidanceTarget(position, part, nil, state.parameters, false, true)
            state.lastScan = now
        end
        state.target = record and record.instance or nil
    end
    if not record then
        state.status = "acquiring"
        if state.appliedVelocity then H.bulletVelocity(part, state, state.originalVelocity) end
        return
    end
    local directHit, directOk = H.projectileSweep(state, position, record.position - position)
    if not directOk then state.status = "blocked"; H.bulletVelocity(part, state, Vector3.zero); return end
    if not directHit or H.projectileTargetHit(directHit, record) then
        state.route, state.routeTarget, state.status = nil, nil, "tracking"
    else
        local changed = not state.routeTarget or (state.routeTarget - record.position).Magnitude > 6
        if (S.bulletRouteBudget or 0) >= 10
            and now - state.lastRouteAt >= Config.BulletRouteInterval and (changed or not state.route) then
            state.route = H.projectileRoute(position, record, state, directHit)
            state.routeTarget, state.lastRouteAt = record.position, now
        end
        state.status = state.route and "routing" or "blocked"
    end
    if state.status == "blocked" then H.bulletVelocity(part, state, Vector3.zero); return end
    local destination = record.position
    if state.route then
        while #state.route > 0 and (state.route[1] - position).Magnitude <= math.max(0.2, state.radius * 0.3) do
            table.remove(state.route, 1)
        end
        if #state.route == 0 then state.route = nil; state.status = "blocked"; H.bulletVelocity(part, state, Vector3.zero); return end
        destination = state.route[1]
    end
    local displacement = destination - position
    if displacement.Magnitude < 0.001 then H.bulletVelocity(part, state, Vector3.zero); return end
    local direction = displacement.Unit
    local step = direction * math.min(state.speed * dt, displacement.Magnitude)
    local nextHit, nextOk = H.projectileSweep(state, position, step)
    if not nextOk or (nextHit and not H.projectileTargetHit(nextHit, record)) then
        state.route, state.status = nil, "blocked"
        H.bulletVelocity(part, state, Vector3.zero)
        return
    end
    if part.Anchored and state.moveAnchored then
        local distance = nextHit and math.clamp(nextHit.Distance, 0, step.Magnitude) or step.Magnitude
        local nextPosition = position + direction * distance
        part.CFrame = CFrame.lookAt(nextPosition, nextPosition + direction)
        state.traveled += distance
        state.lastPosition = nextPosition
        if nextHit then H.guidedHit(part, state, nextHit) end
    elseif not part.Anchored then
        H.bulletVelocity(part, state, direction * (step.Magnitude / dt))
    end
end

function H.bulletGuidanceSummary()
    local counts = {tracking = 0, routing = 0, blocked = 0, acquiring = 0}
    local total = 0
    for _, state in pairs(S.guidedBullets) do
        total += 1
        local status = counts[state.status] ~= nil and state.status or "acquiring"
        counts[status] += 1
    end
    if total == 0 then return "Awaiting compatible local projectiles" end
    return string.format("%d tracking · %d routing · %d blocked · %d seeking",
        counts.tracking, counts.routing, counts.blocked, counts.acquiring)
end

function H.updateGuidedBullets(deltaTime)
    if not S.flags.bullet or not H.ready() then return end
    local dt = H.finite(deltaTime) and math.clamp(deltaTime, 0, 0.1) or 1 / 60
    if dt <= 0 then return end
    S.bulletSweepBudget, S.bulletRouteBudget = Config.BulletSweepBudget, Config.BulletRouteBudget
    S.bulletAcquireBudget = Config.BulletAcquireBudget
    local now = os.clock()
    local entries = {}
    for part, state in pairs(S.guidedBullets) do entries[#entries + 1] = {part, state} end
    local count = #entries
    if count > 0 then S.bulletCursor = ((S.bulletCursor or 0) % count) + 1 end
    for step = 1, count do
        local entry = entries[((S.bulletCursor + step - 2) % count) + 1]
        local part, state = entry[1], entry[2]
        local ok, message = pcall(H.stepGuidedBullet, part, state, dt, now)
        if not ok then
            pcall(H.releaseGuidedBullet, part, state)
            S.guidedBullets[part] = nil
            H.report("Guided projectile", message)
        end
    end
    S.bulletGuidanceStatus = H.bulletGuidanceSummary()
end

function H.stopBulletAim()
    for part, state in pairs(S.guidedBullets) do pcall(H.releaseGuidedBullet, part, state) end
    S.guidedBullets = {}
    S.bulletGuidanceStatus, S.bulletCursor = nil, nil
end

function H.primeEnemyIndex()
    local index = H.combatIndexState()
    if not index.seeded then
        index.seeded = true
        H.queueCombatBranch(Workspace)
    elseif S.flags.bullet and not index.bulletSeeded then
        H.queueCombatBranch(Workspace)
    end
    if S.flags.bullet then index.bulletSeeded = true end
end

-- Lock scans a bounded nearby region instead of indexing every descendant of
-- the entire map as soon as the toggle is clicked. Newly created hazards are
-- still caught by the existing Workspace.DescendantAdded and tag watchers.
function H.sampleNearbyHazards(force)
    if not S.flags.lock or not H.ready() then return end
    local now = os.clock()
    if not force and now - (S.lockLocalScanAt or -math.huge) < Config.LockLocalScanInterval then return end
    S.lockLocalScanAt = now
    local current = S.context.root.Position
    local origin = current
    if S.escape and S.escape.home and (S.escape.home.Position - current).Magnitude > Config.LockLocalScanRadius * 0.6 then
        S.defenseHomeTurn = not S.defenseHomeTurn
        if S.defenseHomeTurn then origin = S.escape.home.Position end
    end
    local parts = H.defenseQuery(origin, Config.LockLocalScanRadius, Config.LockLocalScanMaxParts, "wide")
    local count, sampled = #parts, 0
    local cursor = count > 0 and ((S.defenseWideCursor or 1) - 1) % count + 1 or 1
    while sampled < math.min(count, Config.DefenseWidePartBudget) do
        local part = parts[(cursor + sampled - 1) % count + 1]
        if part:IsA("BasePart") then H.defenseCandidateInfo(part) end
        sampled += 1
        if (S.defenseBudgetCount or 0) >= Config.DefensePartBudget
            or (S.defenseBudgetDeadline and os.clock() >= S.defenseBudgetDeadline) then break end
    end
    S.defenseWideCursor = count > 0 and (cursor + sampled - 1) % count + 1 or 1
    S.defenseDetection = {sampled = sampled, range = Config.LockLocalScanRadius, at = now}
end

function H.primeHazardIndex()
    S.urgentLastScan, S.urgentLastMove = -math.huge, -math.huge
    S.urgentOverlap = nil
    S.tsunamiProbeAt, S.tsunamiProbeInfo, S.tsunamiProbeOverlap = -math.huge, nil, nil
    S.shieldSenseAt, S.shieldSenseOverlap = -math.huge, nil
    S.threatSignatures = {}
    S.hazardCache, S.lastProtectionScanAt = nil, -math.huge
    S.lockOverlap, S.lockLocalScanAt = nil, -math.huge
    H.sampleNearbyHazards(true)
end

-- Suspicious-player observer: movement-only heuristics. Never interprets
-- speed as proof of cheating; disasters, abilities and latency can look similar.
function H.observerReason(root, humanoid, previous, position, now)
    local elapsed = now - previous.at
    if elapsed < 0.035 or elapsed > 1.25 then return nil end
    if humanoid.Health <= 0 or humanoid.Sit or humanoid.SeatPart then return nil end
    local displacement = position - previous.position
    local distance = displacement.Magnitude
    local sampleSpeed = distance / elapsed
    local horizontal = Vector3.new(displacement.X, 0, displacement.Z).Magnitude / elapsed
    local climb = displacement.Y / elapsed
    local normal = math.max(16, humanoid.WalkSpeed)
    -- A single network correction is evidence, not proof of exploiting.
    if distance >= Config.ObserverTeleportDistance
        and sampleSpeed >= Config.ObserverTeleportSpeed then
        return "rapid position jump", sampleSpeed, 3
    end
    local airborne = humanoid.FloorMaterial == Enum.Material.Air
    local airTime = airborne and previous.airSince and now - previous.airSince or 0
    if airborne and airTime >= Config.ObserverFastAirSeconds
        and horizontal >= Config.ObserverAirHorizontalSpeed then
        return "sustained fast flight", horizontal, 2
    end
    if airborne and airTime >= Config.ObserverFastAirSeconds
        and climb >= Config.ObserverAirClimbSpeed then
        return "abnormal upward flight", climb, 2
    end
    if sampleSpeed >= math.max(Config.ObserverFastSpeed, normal * Config.ObserverFastMultiplier) then
        return "abnormal movement speed", sampleSpeed, 2
    end
    return nil
end

function H.samplePlayers(deltaTime)
    if not S.flags.watch or not S.alive then return end
    S.observerClock += deltaTime
    if S.observerClock < Config.ObserverInterval then return end
    local dt = S.observerClock
    S.observerClock = 0
    local now = os.clock()
    local active = {}
    local best, bestScore
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            active[other] = true
            local character = other.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            local old = S.observers[other]
            if root and hum and hum.Health > 0 then
                local rec = old or {score = 0, streak = 0, lastEvent = -math.huge}
                local position = root.Position
                rec.score = math.max(0, rec.score - dt * Config.ObserverScoreDecayPerSecond)
                local reason, speed, points
                if old and old.root == root and old.position then
                    reason, speed, points = H.observerReason(root, hum, old, position, now)
                end
                if reason and now - rec.lastEvent > Config.ObserverEvidenceCooldown then
                    rec.score = math.min(25, rec.score + points)
                    rec.streak += 1
                    rec.lastEvent = now
                    rec.reason = reason
                    rec.lastSpeed = speed
                    if rec.streak >= 2 then
                        H.logEvent("Movement watch", ("%s: %s (%.0f studs/s); score %.1f")
                            :format(other.Name, reason, speed, rec.score))
                    end
                elseif not reason and old and now - (old.lastEvent or -math.huge) > 6 then
                    rec.streak = math.max(0, rec.streak - 1)
                end
                rec.airSince = (hum.FloorMaterial == Enum.Material.Air)
                    and (old and old.airSince or now) or nil
                rec.position, rec.at, rec.root = position, now, root
                S.observers[other] = rec
                if rec.streak >= 2 and rec.score >= Config.ObserverAlertScore
                    and (not bestScore or rec.score > bestScore) then
                    best, bestScore = other, rec.score
                end
            else
                -- Never treat despawn/streaming transitions as teleports.
                S.observers[other] = nil
            end
        end
    end
    for other in pairs(S.observers) do
        if not active[other] then S.observers[other] = nil end
    end
    S.observerSummary = best and (("Unusual movement: %s (score %.1f)"):format(best.Name, bestScore))
        or "No repeated movement anomalies"
end

function H.stopObserving()
    local camera = Workspace.CurrentCamera
    if camera and S.observingPlayer then
        camera.CameraType = S.observingOriginalType or Enum.CameraType.Custom
        local previous = S.observingOriginalSubject
        if previous and previous.Parent then camera.CameraSubject = previous
        elseif S.context and S.context.humanoid.Parent then camera.CameraSubject = S.context.humanoid end
    end
    S.observingPlayer, S.observingOriginalSubject, S.observingOriginalType = nil, nil, nil
end

function H.observeMostSuspicious()
    if not S.flags.watch then H.notice("Enable Suspicious Movement Watch first", 3); return end
    local best, score
    for other, rec in pairs(S.observers) do
        if rec.streak >= 2 and rec.score >= Config.ObserverAlertScore
            and (not score or rec.score > score) then
            best, score = other, rec.score
        end
    end
    if not best then H.notice("No repeatedly unusual player movement detected", 4); return end
    local camera = Workspace.CurrentCamera
    local humanoid = best.Character and best.Character:FindFirstChildOfClass("Humanoid")
    if not camera or not humanoid then H.notice("Player not visible or not spawned", 3); return end
    H.stopObserving()
    S.observingOriginalSubject, S.observingOriginalType = camera.CameraSubject, camera.CameraType
    S.observingPlayer = best
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid
    H.logEvent("Camera follow", "Observing " .. best.Name .. " (unverified movement)")
    H.notice("Camera following " .. best.Name .. "; character stays in place", 4)
end

function H.maintainObserverCamera()
    local observed = S.observingPlayer
    if not observed then return end
    local camera = Workspace.CurrentCamera
    local humanoid = observed.Character and observed.Character:FindFirstChildOfClass("Humanoid")
    if not camera or not observed.Parent then H.stopObserving(); return end
    if not humanoid or humanoid.Health <= 0 then H.stopObserving(); return end
    if camera.CameraType ~= Enum.CameraType.Custom then camera.CameraType = Enum.CameraType.Custom end
    if camera.CameraSubject ~= humanoid then camera.CameraSubject = humanoid end
end

function H.defenseReport()
    local out = {"GR33D v7.21 | Client-only defense diagnostics",
        "Reports indicate observed events, not verified exploit use or server acceptance.",
        "Current mode: " .. H.defenseState(),
        "", "-- Observed player movement --"}
    local entries = {}
    for other, rec in pairs(S.observers) do
        entries[#entries + 1] = {name = other.Name, score = rec.score,
            reason = rec.reason or "none", streak = rec.streak}
    end
    table.sort(entries, function(a,b) return a.score > b.score end)
    for index = 1, math.min(15, #entries) do
        local entry = entries[index]
        out[#out + 1] = ("%s: score %.1f, repeats %d, last %s")
            :format(entry.name, entry.score, entry.streak, entry.reason)
    end
    out[#out + 1] = ""
    out[#out + 1] = "-- Recent events --"
    for index = math.max(1, #S.defenseLog - 49), #S.defenseLog do
        local entry = S.defenseLog[index]
        out[#out + 1] = ("[%.1fs] %s: %s"):format(entry.at, entry.kind, entry.detail)
    end
    return table.concat(out, "\n")
end

function H.setToggle(key, enabled)
    if not S.alive or S.flags[key] == nil then return false end
    enabled = enabled == true
    if S.flags[key] == enabled then return true end
    if enabled and not H.ready() then H.notice("Wait for a living character", 4); return false end
    if enabled then
        -- AFK Streak is independent of flight and Lock On; it pauses its hold
        -- during either feature and resumes when normal idle movement returns.
        local conflicts = {lock = {"flight", "monster"}, flight = {"lock", "monster"},
            monster = {"lock", "flight"}}
        for _, other in ipairs(conflicts[key] or {}) do H.setToggle(other, false) end
    end
    S.flags[key] = enabled
    local ok, message = pcall(function()
        if key == "lock" then
            if enabled then
                H.releaseFlingHold(Config.IdleInputGrace)
                H.stopEscapeHold()
                S.lockSuspended = false
                S.lockMaintenanceAt, S.lockLocalScanAt = -math.huge, -math.huge
                H.resetLockWalking()
                S.lockTarget, S.escape, S.lastEscape = S.context.root.CFrame, nil, -math.huge
                S.lastChaseRelocate, S.lastChaseThreatAt = -math.huge, -math.huge
                S.escapeHistory = {}
                H.primeHazardIndex()
                H.applyLock()
                H.updateEscape()
            else H.stopLock(true) end
        elseif key == "flight" then
            if not enabled then H.stopMover() end
            if enabled then H.notice("Flight armed: double-tap jump to fly", 4) end
        elseif key == "monster" then
            if enabled then
                S.npcLastScanAt, S.lastNPCLift = -math.huge, -math.huge
                S.npcOverlap = nil
                H.updateNPCs()
            else
                H.endHover(true)
                S.npcOverlap, S.npcNearbyIgnore = nil, {}
            end
        elseif key == "trap" then
            if enabled then H.applyAntiTrap() else H.releaseAntiTrap() end
        elseif key == "noclip" then
            if enabled then H.noclip("noclip", true) else H.release("noclip") end
        elseif key == "fling" then
            if enabled then
                S.flingSnapshot = nil
                S.flingLastStableCF = S.context.root.CFrame
                S.flingLastStableAt = os.clock()
                S.flingPauseUntil = os.clock() + 0.1
                H.recoverRagdoll()
            else
                H.releaseFlingHold()
                H.release("fling")
                S.flingSnapshot = nil
            end
        elseif key == "afk" then
            H.afkStopPulse()
            H.releaseIdle(true)
            S.afkLastPulse, S.afkPulseUntil = os.clock(), nil
            S.afkPostPulseUntil = -math.huge
            if enabled then H.notice("AFK Streak on: hold when idle + periodic pulse", 4) end
        elseif key == "run" then
            H.resetRunObservation()
            if enabled then H.notice("Run speed ramps smoothly; repeated corrections pause the override", 4)
            else H.release("run"); S.runCommandSpeed, S.runAppliedSpeed = nil, nil end
        elseif key == "jump" then
            if enabled then H.applyCustomJump() else H.release("jump") end
        elseif key == "health" then
            S.healthLastTick, S.healthNextWrite = nil, nil
            if enabled then
                H.updateHealthRecovery()
                H.notice("Health regeneration enabled; server controls actual HP", 4)
            else S.healthStatus = nil end
        elseif key == "aim" then
            if enabled then H.primeEnemyIndex(); H.startAim() else H.stopAim() end
        elseif key == "bullet" then
            if enabled then
                H.primeEnemyIndex()
                H.notice("Bullet Aim ready for compatible guns; awaiting projectile or shot integration", 5)
            else H.stopBulletAim() end
        elseif key == "watch" then
            S.observerClock = 0
            if not enabled then
                H.stopObserving()
                S.observers, S.observerSummary = {}, nil
            else
                H.notice("Movement watch is observational; high speed is not proof", 4)
            end
        elseif key == "fall" and enabled then
            H.notice("Descent limited; game-defined fall damage may still apply", 4)
        end
    end)
    if not ok then
        S.flags[key] = false
        -- Undo partial activation, not just its visual state.
        if key == "lock" then H.stopLock(false)
        elseif key == "noclip" then H.release("noclip")
        elseif key == "trap" then H.releaseAntiTrap()
        elseif key == "flight" or key == "monster" then H.stopMover()
        elseif key == "fling" then H.releaseFlingHold(); H.release("fling")
        elseif key == "jump" then H.release("jump")
        elseif key == "aim" then H.stopAim()
        elseif key == "bullet" then H.stopBulletAim()
        elseif key == "afk" then
            H.releaseIdle(false)
            S.afkPulseUntil = nil
        end
        H.report("Toggle " .. key, message)
    end
    if key == "lock" or key == "monster" or key == "aim" or key == "bullet" then
        H.clearInactiveIndexes()
    end
    H.updateSwitches()
    return ok
end

function H.cleanupCharacter()
    H.afkBreak("RESPAWNING")
    H.afkStopPulse()
    S.idleGroundParams,S.afkSupport,S.afkRecovery,S.afkHolding=nil,nil,nil,false
    H.disconnectAll(S.characterConnections)
    -- A failure in one cleanup must not skip anchor/property restoration.
    for _, cleanup in ipairs({H.stopAim, H.stopBulletAim, H.resetMovementHealth,
        function() H.stopLock(false) end, H.stopMover, H.releaseAntiTrap, H.releaseFlingHold, H.releaseAll}) do
        local ok, message = pcall(cleanup)
        if not ok then H.report("Character cleanup", message) end
    end
    S.context, S.idleTarget, S.idleSince, S.idleSample = nil, nil, nil, nil
    S.idleBlockedUntil = -math.huge
    S.afkLastPulse, S.afkPulseUntil, S.afkPostPulseUntil = os.clock(), nil, -math.huge
    S.safeRoot, S.previousHealth = nil, nil
    S.safeTime, S.healing, S.lastDrop, S.lastJump = -math.huge, false, -math.huge, -math.huge
    S.lastNPCLift, S.npcLastScanAt = -math.huge, -math.huge
    S.npcOverlap, S.npcNearbyIgnore = nil, {}
    S.lastJumpRequest = -math.huge
    S.lastDamageAt, S.lastSevereThreatAt = -math.huge, -math.huge
    S.homeThreatAt, S.lastEmergency = -math.huge, -math.huge
    S.damageEvents, S.impactEntries, S.recentHazard = {}, {}, nil
    S.lastFlingRecovery = -math.huge
    S.flingHoldTarget, S.flingSnapshot, S.flingLastStableCF = nil, nil, nil
    S.flingLastStableAt, S.flingPauseUntil, S.flingInputUntil = -math.huge, -math.huge, -math.huge
    S.flingRecovering = false
    S.manualTeleportUntil, S.manualTeleportLastTarget = -math.huge, nil
    S.lockSuspended, S.escapeHold = false, nil
    S.lastChaseRelocate, S.lastChaseThreatAt = -math.huge, -math.huge
    S.escapeHistory, S.hazardCache = {}, nil
    S.lastProtectionScanAt = -math.huge
    S.urgentLastScan, S.urgentLastMove = -math.huge, -math.huge
    S.urgentOverlap = nil
end

function H.beginCharacter(character)
    S.setupToken = S.setupToken + 1
    local token = S.setupToken
    H.cleanupCharacter()
    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if not S.alive or token ~= S.setupToken or player.Character ~= character then return end
        if not root or not root:IsA("BasePart") or not humanoid or not humanoid:IsA("Humanoid") then
            H.notice("Character requires a Humanoid and HumanoidRootPart", 6)
            return
        end
        -- CharacterAdded may fire before Roblox parents the model to Workspace.
        local deadline = os.clock() + 10
        while not character:IsDescendantOf(Workspace) do
            if not S.alive or token ~= S.setupToken or player.Character ~= character or os.clock() >= deadline then return end
            task.wait(0.05)
        end
        local ctx = {character = character, root = root, humanoid = humanoid, parts = {}}
        S.context = ctx
        if not S.entrySpawn then
            S.entrySpawn = root.CFrame
            S.joinSpawn = H.findJoinSpawn()
        end
        for _, instance in ipairs(character:GetDescendants()) do
            if instance:IsA("BasePart") then ctx.parts[instance] = true end
        end
        S.previousHealth = humanoid.Health
        H.connect(character.DescendantAdded, function(instance)
            if S.context == ctx and instance:IsA("BasePart") then ctx.parts[instance] = true end
        end, S.characterConnections)
        H.connect(character.DescendantRemoving, function(instance)
            ctx.parts[instance] = nil
            if instance == root or instance == humanoid then
                if S.context == ctx then H.cleanupCharacter(); H.notice("Character components removed", 4) end
            end
        end, S.characterConnections)
        -- Reference v6.1 used property listeners as well as state-disable calls.
        -- Apply on each character (R6 or R15); cleaned on respawn.
        H.connect(humanoid:GetPropertyChangedSignal("PlatformStand"), function()
            if S.context == ctx and (S.flags.fling or S.flags.lock)
                and not S.hovering and not S.flying and humanoid.PlatformStand then
                H.recoverRagdoll()
            end
        end, S.characterConnections)
        H.connect(humanoid:GetPropertyChangedSignal("Sit"), function()
            if S.context == ctx and (S.flags.fling or S.flags.lock)
                and not S.hovering and not S.flying and humanoid.Sit then
                H.recoverRagdoll()
            end
        end, S.characterConnections)
        H.connect(humanoid.StateChanged, function(_, newState)
            if S.context ~= ctx or not (S.flags.fling or S.flags.lock) then return end
            if newState == Enum.HumanoidStateType.Ragdoll
                or newState == Enum.HumanoidStateType.FallingDown
                or newState == Enum.HumanoidStateType.Physics
                or newState == Enum.HumanoidStateType.PlatformStanding then
                H.recoverRagdoll()
            end
        end, S.characterConnections)
        H.recoverRagdoll()
        H.connect(humanoid.HealthChanged, function(health)
            if S.context ~= ctx then return end
            local previous = S.previousHealth or health
            S.previousHealth = health
            if health <= 0 then
                H.cleanupCharacter()
                H.notice("Waiting for respawn", 5)
                return
            end
            if health < previous and not S.healing then
                local now = os.clock()
                local loss = previous - health
                -- The event fires as soon as Roblox reports the HP change; no
                -- periodic scan or nearby-hazard match is required to respond.
                S.lastDamageAt = now
                H.logEvent("Health", ("HP dropped %.2f to %.2f"):format(loss, health))
                for i = #S.damageEvents, 1, -1 do
                    if now - S.damageEvents[i] > Config.DamageBurstWindow then
                        table.remove(S.damageEvents, i)
                    end
                end
                table.insert(S.damageEvents, now)
                if S.flags.lock and H.ready() then
                    local threshold = math.max(Config.EmergencyMinDamageThreshold,
                        math.min(Config.EmergencyDamageAbsolute,
                            humanoid.MaxHealth * Config.EmergencyDamageFraction))
                    if loss + 1e-6 >= threshold
                        or (loss >= 0.005 and #S.damageEvents >= Config.DamageBurstCount) then
                        H.emergencyEscape(string.format("HP drop %.2f", loss))
                    end
                end
            end
        end, S.characterConnections)
        H.connect(humanoid.Died, function()
            if S.context == ctx then H.cleanupCharacter(); H.notice("Waiting for respawn", 5) end
        end, S.characterConnections)
        if S.flags.lock and H.ready() then H.applyLock() end
        if S.flags.noclip and H.ready() then H.noclip("noclip", true) end
        if S.flags.jump and H.ready() then H.applyCustomJump() end
        if S.flags.aim and H.ready() then H.startAim() end
        H.notice("Character ready", 2)
    end)
end

function H.shutdown(destroyGui)
    if not S.alive or S.shuttingDown then return end
    H.clearCombatWork()
    S.shuttingDown = true
    S.setupToken = S.setupToken + 1
    -- A living airborne character gets the same safe landing attempt as Lock OFF.
    if S.flags.lock then
        local ok, message = pcall(H.stopLock, true)
        if not ok then H.report("Shutdown landing", message) end
    end
    if S.hovering then
        local ok, message = pcall(H.endHover, true)
        if not ok then H.report("Shutdown skywalk landing", message) end
    end
    H.stopObserving()
    S.alive = false
    H.disconnectAll(S.connections)
    if S.cameraConnection then S.cameraConnection:Disconnect(); S.cameraConnection = nil end
    H.cleanupCharacter()
    for instance in pairs(S.watchers) do H.removeObject(instance) end
    S.hazards, S.motion, S.npcs, S.pending, S.hazardErrors = {}, {}, {}, {}, {}
    S.hazardCache = nil
    S.combatIndex = nil
    if destroyGui and S.ui.gui then S.ui.gui:Destroy() end
end

-- A new v7 instance asks its predecessor to restore everything before removal.
local previousGui = playerGui:FindFirstChild("DevPanelGui")
if previousGui then
    local shutdown = previousGui:FindFirstChild("GR33D_Shutdown")
    if shutdown and shutdown:IsA("BindableEvent") then
        shutdown:Fire()
    else
        warn("[GR33D] An older panel was found. Restart Play to remove its old loops/hooks.")
    end
    previousGui:Destroy()
end

