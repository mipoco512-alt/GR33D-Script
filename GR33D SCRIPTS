function H.beginDrag(input)
    if not S.alive or S.dragging or not S.ui.panel or not S.ui.panel.Parent then return end
    if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
    S.ui.dockedRight=false
    S.dragging={input=input,start=input.Position,last=input.Position,position=S.ui.panel.Position,
        totalX=0,totalY=0,moved=false,ended=false}
end

function H.updatePanelDrag(input)
    local drag=S.dragging
    if not S.alive or not drag or drag.ended then return end
    local mouse=drag.input.UserInputType==Enum.UserInputType.MouseButton1
    if mouse then
        if input.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local delta=input.Delta
        if not delta or (delta.X==0 and delta.Y==0) then delta=input.Position-drag.last end
        drag.totalX+=delta.X
        drag.totalY+=delta.Y
        drag.last=input.Position
    else
        if input~=drag.input then return end
        local delta=input.Position-drag.start
        drag.totalX,drag.totalY=delta.X,delta.Y
    end
    if drag.totalX*drag.totalX+drag.totalY*drag.totalY>16 then drag.moved=true end
    H.positionPanel(drag.position.X.Offset+drag.totalX,drag.position.Y.Offset+drag.totalY)
end

function H.endPanelDrag(input,forced)
    local drag=S.dragging
    if not drag then return end
    if not forced and input~=drag.input and not (input
        and input.UserInputType==Enum.UserInputType.MouseButton1
        and drag.input.UserInputType==Enum.UserInputType.MouseButton1) then return end
    drag.ended=true
    if drag.moved then S.suppressMinimizeUntil=os.clock()+0.2 end
    if forced then S.dragging=nil;return end
    task.defer(function() if S.dragging==drag then S.dragging=nil end end)
end

