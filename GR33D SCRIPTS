function H.positionPanel(x,y)
    local bounds=S.ui.dragBounds
    if not bounds or not S.ui.panel or not S.ui.panel.Parent then return end
    S.ui.panel.Position=UDim2.fromOffset(
        math.clamp(x,bounds.minX,bounds.maxX),math.clamp(y,bounds.minY,bounds.maxY))
end

function H.revealUITab(key)
    local entry=S.ui.pages and S.ui.pages[key]
    local navigation=S.ui.tabs
    if not entry or not navigation or not navigation.Parent then return end
    local width=entry.button.Size.X.Offset
    local left=(entry.button.LayoutOrder-1)*(width+6)
    local right=left+width
    local viewportWidth=navigation.AbsoluteSize.X
    local offset=navigation.CanvasPosition.X
    if left<offset then offset=left
    elseif right>offset+viewportWidth then offset=right-viewportWidth end
    navigation.CanvasPosition=Vector2.new(math.clamp(offset,0,
        math.max(0,navigation.CanvasSize.X.Offset-viewportWidth)),0)
end

function H.layout()
    if not S.alive or not S.ui.panel or not S.ui.panel.Parent then return end
    local viewport=H.viewport()
    local topInset,bottomInset=Vector2.zero,Vector2.zero
    pcall(function() topInset,bottomInset=game:GetService("GuiService"):GetGuiInset() end)
    local top=math.max(12,topInset.Y+8)
    local bottom=math.max(12,bottomInset.Y+8)
    local width=math.min(480,math.max(180,viewport.X-16))
    local availableHeight=math.max(160,viewport.Y-top-bottom)
    local height=math.min(720,availableHeight,math.max(240,math.floor(availableHeight*0.82)))
    local size=S.minimized and Vector2.new(56,56) or Vector2.new(width,height)
    local panel=S.ui.panel
    panel.Size=UDim2.fromOffset(size.X,size.Y)
    local x,y=panel.Position.X.Offset,panel.Position.Y.Offset
    if S.ui.dockedRight and not S.dragging then
        x=viewport.X-size.X-12
        y=top
    end
    local visibleWidth=math.min(size.X,184)
    local visibleHeight=S.minimized and size.Y or math.min(size.Y,44)
    local minimumY=math.min(math.max(0,topInset.Y),math.max(0,viewport.Y-visibleHeight))
    S.ui.dragBounds={minX=visibleWidth-size.X,maxX=math.max(0,viewport.X-visibleWidth),
        minY=minimumY,maxY=math.max(minimumY,viewport.Y-visibleHeight)}
    H.positionPanel(x,y)
    local show=not S.minimized
    local compact=height<460
    local showTagline=not compact and width>=340
    local headerHeight=showTagline and 72 or 56
    local tabsHeight=44
    local footerHeight=64
    local pageTop=headerHeight+6+tabsHeight+6
    S.ui.header.Size=UDim2.new(1,0,0,headerHeight)
    for _,item in ipairs({S.ui.header,S.ui.tabs,S.ui.footer,S.ui.close}) do item.Visible=show end
    if S.ui.pages then
        local count=0
        for _ in pairs(S.ui.pages) do count+=1 end
        local tabWidth=math.max(82,math.floor((width-24-math.max(0,count-1)*6)/math.max(1,count)))
        local canvasWidth=count*tabWidth+math.max(0,count-1)*6
        for key,entry in pairs(S.ui.pages) do
            entry.scroll.Visible=show and S.ui.activeTab==key
            entry.scroll.Position=UDim2.fromOffset(12,pageTop)
            entry.scroll.Size=UDim2.new(1,-24,0,math.max(24,height-pageTop-footerHeight-10))
            entry.button.Size=UDim2.fromOffset(tabWidth,44)
        end
        S.ui.tabs.CanvasSize=UDim2.fromOffset(canvasWidth,0)
    end
    S.ui.tabs.Position=UDim2.fromOffset(12,headerHeight+6)
    S.ui.tabs.Size=UDim2.new(1,-24,0,tabsHeight)
    S.ui.footer.Position=UDim2.new(0,0,1,-footerHeight)
    S.ui.footer.Size=UDim2.new(1,0,0,footerHeight)
    S.ui.status.Position=UDim2.fromOffset(31,8)
    S.ui.status.Size=UDim2.new(1,-45,0,21)
    S.ui.status.TextSize=compact and 11 or 12
    S.ui.statusDetail.Position=UDim2.fromOffset(14,31)
    S.ui.statusDetail.Size=UDim2.new(1,-28,0,footerHeight-35)
    S.ui.statusDetail.TextSize=compact and 10 or 11
    S.ui.minimizeCorner.CornerRadius=UDim.new(0,show and 11 or 18)
    S.ui.title.Text=width<300 and "GR33D" or "GR33D CONTROL"
    S.ui.title.TextSize=compact and 17 or 19
    S.ui.title.Position=UDim2.fromOffset(24,showTagline and 12 or 15)
    S.ui.title.Size=UDim2.new(1,-137,0,26)
    S.ui.tagline.Visible=show and showTagline
    S.ui.tagline.Position=UDim2.fromOffset(25,41)
    S.ui.tagline.Size=UDim2.new(1,-137,0,18)
    local controlTop=math.floor((headerHeight-44)/2)
    S.ui.close.Size=UDim2.fromOffset(44,44)
    S.ui.close.Position=UDim2.new(1,-54,0,controlTop)
    S.ui.minimize.Size=show and UDim2.fromOffset(44,44) or UDim2.fromScale(1,1)
    S.ui.minimize.Position=show and UDim2.new(1,-104,0,controlTop) or UDim2.fromOffset(0,0)
    S.ui.minimize.Text=show and "−" or "G"
    S.ui.minimize.BackgroundColor3=show and Color3.fromRGB(38,52,60) or Color3.fromRGB(26,79,70)
    H.revealUITab(S.ui.activeTab)
    H.refreshStatus()
end

