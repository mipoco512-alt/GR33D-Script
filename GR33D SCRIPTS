function H.make(className,properties,parent)
    local instance=Instance.new(className)
    if instance:IsA("GuiObject") then instance.BorderSizePixel=0 end
    for property,value in pairs(properties or {}) do instance[property]=value end
    if instance:IsA("TextButton") then
        instance.Selectable=true
        instance.TextWrapped=true
        instance.TextTruncate=Enum.TextTruncate.AtEnd
    end
    instance.Parent=parent
    return instance
end

function H.corner(instance, radius)
    return H.make("UICorner", {CornerRadius = UDim.new(0, radius)}, instance)
end

function H.viewport()
    local camera = Workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(800, 600)
end

function H.openUITab(key)
    if not S.ui.pages or not S.ui.pages[key] then return end
    S.ui.activeTab = key
    for name, entry in pairs(S.ui.pages) do
        local active = name == key
        entry.scroll.Visible = active and not S.minimized
        entry.button.BackgroundColor3 = active and Color3.fromRGB(37, 67, 69)
            or Color3.fromRGB(28, 37, 51)
        entry.button.TextColor3 = active and Color3.fromRGB(218, 255, 245) or UI.muted
        entry.accent.Visible = active
    end
    if H.revealUITab then H.revealUITab(key) end
end

function H.useUITab(key)
    assert(S.ui.pages and S.ui.pages[key], "Missing panel category: " .. tostring(key))
